---
/**
 * Entity hub: publish history + measurement evolution for one entity.
 * Chart data = publish-time Φ_S / κ from each dated report frontmatter.
 * Live SoT overlay is labeled separately; no invented vault/M1 history.
 */
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import {
  loadSot,
  resolveReportMetrics,
  formatNum,
  publishEvolutionPolylines,
  EVOLUTION_MIN_STAMPS,
  type PublishMetricStamp,
} from '../lib/sot';

interface SeriesItem {
  slug: string;
  date_iso: string;
  date_label: string;
  phi_s: number;
  kappa: number;
  vault_records: number;
}

interface Props {
  entityCode: string;
  entityDisplay: string;
  hubSlug: string;
  series: SeriesItem[];
  latestSlug: string;
  latestDateIso: string;
}

const { entityCode, entityDisplay, hubSlug, series, latestSlug, latestDateIso } = Astro.props;

const sot = loadSot();
const latest = series[0];
const publish = latest
  ? { phi_s: latest.phi_s, kappa: latest.kappa }
  : { phi_s: 0, kappa: 0 };
const metrics = resolveReportMetrics(entityCode, publish);
const { phi_s, kappa, using_live, live } = metrics;
const m1LedgerObs = (sot.entity_m1_obs_counts || {})[entityCode] ?? 0;

const base = import.meta.env.BASE_URL;
const hubUrl = `${base}reports/${hubSlug}/`;
const latestUrl = `${base}reports/${latestSlug}/`;
const humanDossier = `${base}dossier/${entityCode}/`;
const glossary = `${base}METHODOLOGY.md#numbers-glossary`;
const methodology = `${base}METHODOLOGY.md`;

const stamps: PublishMetricStamp[] = series.map((r) => ({
  date_iso: r.date_iso,
  phi_s: r.phi_s,
  kappa: r.kappa,
  vault_records: r.vault_records,
  slug: r.slug,
}));

const chart = publishEvolutionPolylines(stamps);
const vaultSeriesHonest = stamps.some((s) => s.vault_records > 0);
const vaultTip = 'Cycle vault rows at publish (trimmed); not M1 lifetime observations';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const description = `${entityDisplay} entity hub: ${series.length} dated signal reports, publish-time Φ_S / κ evolution, and live SoT overlay. Eigenstate Research.`;

/** Parse YYYY-MM-DD as a local calendar date (avoid UTC off-by-one). */
function parseIsoDate(iso: string): Date | null {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return null;
  const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  return isNaN(d.getTime()) ? null : d;
}
function formatLong(iso: string): string {
  const d = parseIsoDate(iso);
  return d
    ? d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
    : iso;
}
function formatShort(iso: string): string {
  const d = parseIsoDate(iso);
  return d
    ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase()
    : iso;
}
---

<Layout title={`${entityDisplay} · Entity hub · Eigenstate Research`} description={description} fonts={fonts}>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      .hub {
        max-width: 920px;
        margin: 0 auto;
        padding: 56px 40px 72px;
      }

      .hub-back {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal-dim);
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
      }

      .hub-back:hover {
        color: var(--accent);
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.25em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .hub-title {
        font-family: var(--font-heading);
        font-size: clamp(32px, 5vw, 44px);
        font-weight: 800;
        letter-spacing: 0.03em;
        line-height: 1.1;
        margin-bottom: 8px;
      }

      .hub-sub {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 28px;
      }

      .metrics-row {
        display: flex;
        flex-wrap: wrap;
        gap: 28px;
        margin-bottom: 20px;
      }

      .metric-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 4px;
      }

      .metric-value {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
      }

      .metric-value.cyan {
        color: var(--signal);
      }

      .metric-value.muted {
        color: var(--text-secondary);
      }

      .live-badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--signal);
        background: rgb(47 90 99 / 12%);
        padding: 2px 7px;
        border-radius: var(--radius-sm);
        margin-left: 6px;
        vertical-align: middle;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin: 24px 0 36px;
      }

      .cta-primary {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.08em;
        padding: 14px 28px;
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        border-radius: var(--radius-sm);
        transition: background 0.2s, transform 0.2s;
      }

      .cta-primary:hover {
        background: var(--accent-dark);
        transform: translateY(-1px);
      }

      .cta-secondary {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal-dim);
        text-decoration: none;
      }

      .cta-secondary:hover {
        color: var(--accent);
      }

      .note {
        border-left: 3px solid var(--signal);
        padding: 12px 14px;
        background: rgb(47 90 99 / 6%);
        color: var(--text-secondary);
        font-size: var(--text-sm);
        line-height: 1.6;
        margin-bottom: 40px;
      }

      .note a {
        color: var(--signal);
        text-decoration: none;
      }

      .section {
        margin-bottom: 48px;
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
      }

      .section-sub {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: 20px;
        letter-spacing: 0.04em;
      }

      .history {
        list-style: none;
        border: 1px solid var(--border);
        border-left: 3px solid var(--border-strong);
      }

      .history-item {
        display: grid;
        grid-template-columns: 140px 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 14px 18px;
        text-decoration: none;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        transition: background 0.15s, border-color 0.15s;
      }

      .history-item:last-child {
        border-bottom: none;
      }

      .history-item:hover {
        background: var(--bg-card);
      }

      .history-item.is-latest {
        border-left: 3px solid var(--signal-dim);
        margin-left: -3px;
        padding-left: 18px;
      }

      .hist-date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-primary);
        letter-spacing: 0.04em;
      }

      .hist-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
      }

      .hist-metrics .phi {
        color: var(--accent);
      }

      .hist-metrics .kap {
        color: var(--signal);
      }

      .hist-metrics .vault {
        color: var(--status-success);
      }

      .hist-cta {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--signal-dim);
        letter-spacing: 0.04em;
        white-space: nowrap;
      }

      .chart-wrap {
        border: 1px solid var(--border);
        background: var(--bg-card);
        padding: 20px 20px 12px;
      }

      .chart-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 12px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.04em;
      }

      .legend-phi {
        color: var(--accent);
      }

      .legend-kap {
        color: var(--signal);
      }

      .chart-svg {
        width: 100%;
        height: auto;
        display: block;
      }

      .chart-axis {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
      }

      .chart-range {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 10px;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
      }

      .empty-evo {
        border: 1px solid var(--border);
        padding: 28px 20px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        line-height: 1.6;
        background: var(--bg2);
      }

      .vault-note {
        margin-top: 16px;
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.6;
      }

      @media (width <= 640px) {
        .hub {
          padding: 40px 20px 56px;
        }

        .history-item {
          grid-template-columns: 1fr;
          gap: 6px;
        }

        .hist-cta {
          justify-self: start;
        }
      }
    </style>
  </Fragment>

  <Nav active="reports" />

  <div class="hub" id="main">
    <a class="hub-back" href={`${base}reports/`}>← All signal reports</a>
    <div class="eyebrow">Entity hub · {entityCode}</div>
    <h1 class="hub-title">{entityDisplay}</h1>
    <p class="hub-sub">
      {series.length} dated {series.length === 1 ? 'report' : 'reports'} · latest {formatLong(latestDateIso)}
    </p>

    <div class="metrics-row">
      <div>
        <div class="metric-label">
          Settlement pressure{using_live ? ' · live' : ' · publish'}
          {using_live && <span class="live-badge">live</span>}
        </div>
        <div class="metric-value">Φ_S {phi_s.toFixed(4)}</div>
      </div>
      <div>
        <div class="metric-label">Field coherence{using_live ? ' · live' : ' · publish'}</div>
        <div class="metric-value cyan">κ {formatNum(kappa, 4)}</div>
      </div>
      {
        latest && (
          <div title={vaultTip}>
            <div class="metric-label">vault@publish (latest)</div>
            <div class="metric-value muted">{latest.vault_records}</div>
          </div>
        )
      }
      <div title="m1_strict coverage-ledger rows for this entity (SoT); not a time series">
        <div class="metric-label">M1 ledger (live)</div>
        <div class="metric-value muted">{m1LedgerObs}</div>
      </div>
    </div>

    <div class="cta-row">
      <a class="cta-primary" href={latestUrl}>Read latest →</a>
      <a class="cta-secondary" href={humanDossier}>Entity dossier</a>
      <a class="cta-secondary" href={glossary}>Numbers glossary</a>
      <a class="cta-secondary" href={methodology}>Methodology</a>
    </div>

    <p class="note">
      {
        using_live
          ? `Hero Φ_S / κ overlay the live dossier SoT${live.compiled_at ? ` (compiled ${String(live.compiled_at).slice(0, 19)}Z)` : ''}. Publish history and the evolution chart below use dated report frontmatter (publish-time stamps), not a reconstructed live ledger.`
          : `No live dossier mirror for ${entityCode} in this deploy. Hero numbers fall back to the latest publish frontmatter.`
      }
      {' '}
      <a href={glossary}>What do these numbers mean?</a>
    </p>

    <!-- Publish history -->
    <section class="section" aria-labelledby="history-heading">
      <h2 class="section-title" id="history-heading">Publish history</h2>
      <p class="section-sub">Newest → oldest · publish-time Φ_S / κ / vault@publish</p>
      <ol class="history">
        {
          series.map((r, i) => (
            <li>
              <a
                href={`${base}reports/${r.slug}/`}
                class:list={['history-item', { 'is-latest': i === 0 }]}
              >
                <div class="hist-date">
                  {formatShort(r.date_iso)}
                  {i === 0 ? ' · latest' : ''}
                </div>
                <div class="hist-metrics">
                  <span class="phi">Φ_S {r.phi_s.toFixed(3)}</span>
                  <span class="kap">κ {r.kappa.toFixed(3)}</span>
                  <span class="vault" title={vaultTip}>vault@pub {r.vault_records}</span>
                </div>
                <span class="hist-cta">Open report →</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Measurement evolution -->
    <section class="section" aria-labelledby="evo-heading">
      <h2 class="section-title" id="evo-heading">Measurement evolution</h2>
      <p class="section-sub">
        Publish-time stamps from dated reports (not live SoT). Each point is a report frontmatter snapshot.
      </p>

      {
        chart.ok ? (
          <div class="chart-wrap">
            <div class="chart-legend">
              <span class="legend-phi">Φ_S (publish)</span>
              {chart.kappaPoints && <span class="legend-kap">κ (publish)</span>}
            </div>
            <svg
              class="chart-svg"
              viewBox={`0 0 ${chart.width} ${chart.height}`}
              role="img"
              aria-label={`${entityDisplay} publish-time Φ_S and κ over ${stamps.length} reports`}
            >
              <line
                x1="0"
                y1={chart.height - 1}
                x2={chart.width}
                y2={chart.height - 1}
                stroke="rgb(0 0 0 / 10%)"
                stroke-width="1"
              />
              <polyline
                fill="none"
                stroke="var(--accent)"
                stroke-width="2"
                points={chart.phiPoints}
              />
              {chart.kappaPoints && (
                <polyline
                  fill="none"
                  stroke="var(--signal)"
                  stroke-width="2"
                  stroke-dasharray="4 3"
                  points={chart.kappaPoints}
                />
              )}
            </svg>
            <div class="chart-axis">
              <span>{chart.labels[0]}</span>
              <span>{chart.labels[chart.labels.length - 1]}</span>
            </div>
            <div class="chart-range">
              <span>
                Φ_S range {chart.phiMin.toFixed(3)} to {chart.phiMax.toFixed(3)}
              </span>
              {chart.kappaPoints && (
                <span>
                  κ range {chart.kappaMin.toFixed(4)} to {chart.kappaMax.toFixed(4)}
                </span>
              )}
              <span>{stamps.length} publish stamps</span>
            </div>
            {vaultSeriesHonest ? (
              <p class="vault-note" title={vaultTip}>
                vault@publish appears per row in the history above. It is not plotted as a continuous
                series (trimmed cycle-vault rows at each publish, not lifetime M1). Live M1 ledger for
                this entity: {m1LedgerObs} obs (SoT coverage {sot.coverage.headline}).
              </p>
            ) : (
              <p class="vault-note">
                No non-zero vault@publish rows in this series. Live M1 ledger: {m1LedgerObs} obs
                (SoT). M1 is a current ledger count, not a historical series in this deploy.
              </p>
            )}
          </div>
        ) : (
          <div class="empty-evo">
            Insufficient publish stamps for an evolution chart (need at least {EVOLUTION_MIN_STAMPS}
            dated reports with Φ_S). This entity has {stamps.length} stamp
            {stamps.length === 1 ? '' : 's'}. History above is still the full publish record.
            {
              m1LedgerObs > 0 && (
                <>
                  {' '}
                  Live M1 ledger obs: {m1LedgerObs} (current SoT count only; not charted).
                </>
              )
            }
          </div>
        )
      }
    </section>

    <p class="hub-sub" style="margin-top: 8px;">
      Canonical hub path: <code>{hubUrl}</code>
    </p>
  </div>

  <Footer variant="full" />
</Layout>
