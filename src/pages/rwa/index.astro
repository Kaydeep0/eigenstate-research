---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import survey from '../../data/rwa_disclosure.json';
import registryRows from '../../data/rwa-registry-rows.json';
import { ledgerDeltaLine } from '../../lib/ledgerContext';
import { datasetJsonLd, dateOnly } from '../../lib/siteSeo';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;
const caip10 = 'https://github.com/ChainAgnostic/CAIPs/blob/main/CAIPs/caip-10.md';

interface Survey {
  generated_at: string;
  digest: string;
  expectations_digest: string;
  expectations_generated_at: string;
  probe_version: string;
  subject: { what: string; engine_commit: string; dossier_source: string };
  issuers_in_population: number;
  no_surface_recorded_by_this_node: number;
  must_admit: number;
  must_refuse: number;
  full_admit: number;
  full_refuse: number;
  machine_readable_surface_exists: number;
  issuer_operated_machine_readable_surface_exists: number;
  attributable_to_issuer: { n: number; must_admit: number; must_refuse: number; why: string };
  refuse_limb_counts: Record<string, number>;
  top_refuse_reasons: Record<string, number>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  limb_order_frozen: string[];
  limb_spec_level: Record<string, string>;
  surfaces: {
    recorded: number;
    machine_readable: number;
    issuer_operated: number;
    issuer_operated_and_machine_readable: number;
    media_types_sniffed: Record<string, number>;
  };
  conventional_paths: {
    requests: number;
    origins: string[];
    paths_tried: string[];
    answered_structured: number;
    status_counts: Record<string, number>;
  };
  registry_ref_discipline: {
    surfaces_naming_any_reference: number;
    surfaces_with_chain_qualified_reference: number;
    how_it_is_checked: string;
  };
  predictions_scored: { prediction: string; observed: string; met: boolean }[];
  per_issuer: {
    entity: string;
    display_name: string;
    segment_role: string;
    must_admit: boolean;
    full_admit: boolean;
    refuse_limb: string | null;
    refuse_reason: string | null;
    attribution: string;
    machine_readable_surface_exists: boolean;
    receipt: string;
  }[];
  named_but_not_tracked: { issuer: string; reason: string }[];
  rejected_surface_sources: { source: string; field: string; reason: string }[];
  probe_defects_fixed_before_publication: { defect: string; effect: string; fix: string }[];
  not_claimed: string[];
}

const s = survey as unknown as Survey;
const n = s.issuers_in_population;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const refuseRate = `${((100 * s.must_refuse) / n).toFixed(1)}%`;
const delta = ledgerDeltaLine('rwa', 'must_refuse_rate');
const refuseRows = Object.entries(s.refuse_limb_counts).sort((a, b) => b[1] - a[1]);
const mediaRows = Object.entries(s.surfaces.media_types_sniffed).sort((a, b) => b[1] - a[1]);
const statusRows = Object.entries(s.conventional_paths.status_counts).sort((a, b) => b[1] - a[1]);
const subjects = [...s.per_issuer].sort((a, b) => {
  if (a.must_admit !== b.must_admit) return a.must_admit ? 1 : -1;
  return a.entity.localeCompare(b.entity);
});
const registry = registryRows as {
  schema?: string;
  projection?: boolean;
  rows?: {
    entity?: string;
    identity?: string;
    claims_supported?: number;
    claims_n?: number;
    current_state?: string;
    relationships?: string[];
    material_gaps?: { broken_pipe?: number; unknown?: number; withheld?: number };
    last_observation?: string;
    verify?: string;
    dossier?: string;
    reliance_receipts?: unknown[];
  }[];
};
---

<Layout
  title="RWA disclosure survey · Eigenstate Research"
  description="Real world asset issuers and tokenized instruments, checked for whether a program can read their disclosed figure without a human, a document parser, or a third party."
  fonts={fonts}
>
  <Fragment slot="head">
    <JsonLd
      data={datasetJsonLd({
        name: 'RWA disclosure survey',
        description:
          'Whether a program can read the disclosed reserve figure without a human, a document parser, or a third party. This node tracks the issuers listed on this page — not a sector-wide study.',
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        datePublished: dateOnly(s.generated_at),
        creator: 'geniusflow',
        about: 'RWA issuer disclosure surfaces',
      })}
    />
  </Fragment>
  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="rank-hero" id="main">
    <div class="eyebrow">RWA disclosure · read-only · expectations first</div>
    <h1>The reserve number a machine cannot read</h1>
    <p class="lede">
      Interface question only: does the issuer serve a structured figure a program can fetch? Not a
      market survey and not a quality ranking of PDF attestations.
    </p>
    <div class="rank-primary">
      <div class="rate">{refuseRate}</div>
      <div class="rate-label">
        MUST refuse rate · {s.must_refuse} of {n} issuers · issuer-operated machine-readable surfaces:{' '}
        {s.issuer_operated_machine_readable_surface_exists}
      </div>
    </div>
    {delta && <p class="rank-delta">{delta}</p>}
  </div>

  <section class="rank-wrap" id="registry-view">
    <h2 class="rank-runline">Maintained entity registry (view)</h2>
    <p class="lede" style="max-width:720px;margin:0 auto 20px;font-size:15px;">
      This table is a projection of the same maintained entity card Federation publishes.
      It is not a second registry database. Reliance receipts stay empty until independent
      parties actually use the object. Settlement readiness is not a field.
    </p>
    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th>Entity</th>
            <th>Identity</th>
            <th>Claims</th>
            <th>Current state</th>
            <th>Relationships</th>
            <th>Material gaps</th>
            <th>Last observation</th>
            <th>Verify</th>
            <th>Reliance</th>
          </tr>
        </thead>
        <tbody>
          {(registry.rows || []).length === 0 ? (
            <tr>
              <td colSpan="9">No maintained-entity rows in this local bake yet.</td>
            </tr>
          ) : (
            (registry.rows || []).map((row) => (
              <tr>
                <td>
                  <a href={`${fed}${row.dossier || '/api/dossier?entity=' + row.entity}`}>{row.entity}</a>
                </td>
                <td>{row.identity}</td>
                <td>
                  {row.claims_supported ?? 'UNKNOWN'} supported / {row.claims_n ?? 'UNKNOWN'}
                </td>
                <td>{row.current_state}</td>
                <td>{(row.relationships || []).join(', ') || 'UNKNOWN'}</td>
                <td>
                  broken_pipe={row.material_gaps?.broken_pipe ?? 'UNKNOWN'} · unknown=
                  {row.material_gaps?.unknown ?? 'UNKNOWN'}
                </td>
                <td>{row.last_observation || 'UNKNOWN'}</td>
                <td>
                  <a href={`${fed}${row.verify || '/api/verify'}`}>verify</a>
                </td>
                <td>{(row.reliance_receipts || []).length === 0 ? 'empty' : String((row.reliance_receipts || []).length)}</td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </section>

  <section class="rank-wrap">
    <div class="rank-runline">
      Population {n} · engine <code>{s.subject.engine_commit?.slice(0, 12)}</code> · expectations{' '}
      <code>{s.expectations_digest.slice(0, 16)}</code> · run {formatDate(s.generated_at)} · probe v
      {s.probe_version}
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th>Entity</th>
            <th>Role</th>
            <th>Verdict</th>
            <th>Refuse limb</th>
            <th>Attribution</th>
            <th>Receipt</th>
          </tr>
        </thead>
        <tbody>
          {
            subjects.map((r) => (
              <tr>
                <td class="subject">{r.display_name || r.entity}</td>
                <td>{r.segment_role}</td>
                <td class:list={['verdict', r.must_admit ? 'is-admit' : 'is-refuse']}>
                  {r.must_admit ? 'admit' : 'refuse'}
                </td>
                <td>{r.refuse_limb ?? 'no refuse'}</td>
                <td>{r.attribution}</td>
                <td>
                  <a href={r.receipt} rel="noopener">
                    json
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="rank-footer">
      <p class="honesty">
        Not a measure of disclosure quality · not a market survey · no score, no badge · every URL
        came from this engine's own recorded data
      </p>

      <h2>How to cite / re-check</h2>
      <div class="links-row">
        <a href={`${fed}/rwa/expectations.json`} rel="noopener">expectations.json</a>
        <a href={`${fed}/rwa/ledger.json`} rel="noopener">ledger.json</a>
        <a href={`${fed}/rwa/summary.json`} rel="noopener">summary.json</a>
        <a href={`${fed}/rwa/index.json`} rel="noopener">index.json</a>
        <a href={`${fed}/rwa/README.md`} rel="noopener">README.md</a>
      </div>
      <p>
        For issuer-attributable figures cite <code>attributable_to_issuer</code> ({
          s.attributable_to_issuer.must_refuse
        } of {s.attributable_to_issuer.n} still refuse), not the raw {s.must_refuse} of {n} alone.
      </p>

      <h2>Where they fail</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>First failing limb</th><th class="n">Issuers</th></tr>
          </thead>
          <tbody>
            {
              refuseRows.map(([limb, count]) => (
                <tr>
                  <td>{limb}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Surfaces served</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Media type sniffed</th><th class="n">Surfaces</th></tr>
          </thead>
          <tbody>
            {
              mediaRows.map(([type, count]) => (
                <tr>
                  <td>{type}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Conventional paths</h2>
      <p>
        {s.conventional_paths.requests} requests across {s.conventional_paths.origins.length} issuer
        origins · {s.conventional_paths.answered_structured} answered structured. See{' '}
        <a href={caip10} rel="noopener">CAIP-10</a> for chain-qualified refs (
        {s.registry_ref_discipline.surfaces_with_chain_qualified_reference} of{' '}
        {s.surfaces.recorded}).
      </p>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>HTTP status</th><th class="n">Responses</th></tr>
          </thead>
          <tbody>
            {
              statusRows.map(([code, count]) => (
                <tr>
                  <td>{code}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Limbs</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Limb</th><th>Level</th><th class="n">ok</th><th class="n">fail</th><th class="n"
                >n/a</th
              ><th class="n">not reached</th>
            </tr>
          </thead>
          <tbody>
            {
              s.limb_order_frozen.map((limb) => (
                <tr>
                  <td>{limb}</td>
                  <td>{s.limb_spec_level[limb]}</td>
                  <td class="n">{s.limb_outcomes[limb].ok}</td>
                  <td class="n">{s.limb_outcomes[limb].fail}</td>
                  <td class="n">{s.limb_outcomes[limb].not_applicable}</td>
                  <td class="n">{s.limb_outcomes[limb].not_reached}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Predictions</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Prediction</th><th>Observed</th><th>Result</th></tr>
          </thead>
          <tbody>
            {
              s.predictions_scored.map((row) => (
                <tr>
                  <td>{row.prediction}</td>
                  <td>{row.observed}</td>
                  <td class="verdict">{row.met ? 'met' : 'missed'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Probe defects recorded</h2>
      <ul>
        {
          s.probe_defects_fixed_before_publication.map((d) => (
            <li>
              <strong>{d.defect}.</strong> {d.effect} {d.fix}
            </li>
          ))
        }
      </ul>

      <h2>Not tracked</h2>
      <ul>
        {
          s.named_but_not_tracked.map((row) => (
            <li>
              <strong>{row.issuer}</strong>: {row.reason}
            </li>
          ))
        }
      </ul>

      <h2>Re-run</h2>
      <pre class="cmd">PYTHONPATH=engine python3 engine/tools/rwa_disclosure_run.py expect
PYTHONPATH=engine python3 engine/tools/rwa_disclosure_run.py run
PYTHONPATH=engine python3 engine/tools/rwa_pages_export.py</pre>

      <h2>What this is not</h2>
      <ul>
        {s.not_claimed.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
