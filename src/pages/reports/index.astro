---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { slugFor } from '../../lib/reports';
import { loadSot, entityCodeFromReportId, resolveReportMetrics } from '../../lib/sot';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const sot = loadSot();
const m1Obs = sot.entity_m1_obs_counts || {};
const reports = (await getCollection('reports')).map((r) => {
  const code = entityCodeFromReportId(r.data.id);
  const m = resolveReportMetrics(code, { phi_s: r.data.phi_s, kappa: r.data.kappa });
  return {
    ...r,
    slug: slugFor(r.id),
    entityCode: code,
    m1LedgerObs: m1Obs[code] ?? 0,
    live_phi_s: m.phi_s,
    live_kappa: m.kappa,
    using_live: m.using_live,
  };
});
type ReportRow = (typeof reports)[number];

/** One card per entity; dated reports collapse into a newest→oldest series. */
const byEntity = new Map<string, ReportRow[]>();
for (const r of reports) {
  const list = byEntity.get(r.entityCode) ?? [];
  list.push(r);
  byEntity.set(r.entityCode, list);
}

const entityGroups = [...byEntity.entries()]
  .map(([code, items]) => {
    const series = [...items].sort((a, b) => b.data.date_iso.localeCompare(a.data.date_iso));
    const latest = series[0];
    return {
      entityCode: code,
      entityDisplay: latest.data.entity_display,
      latest,
      series,
      count: series.length,
      live_phi_s: latest.live_phi_s,
      live_kappa: latest.live_kappa,
      using_live: latest.using_live,
      m1LedgerObs: latest.m1LedgerObs,
      latestDate: latest.data.date_iso,
    };
  })
  .sort((a, b) => b.latestDate.localeCompare(a.latestDate));

const featured = entityGroups.reduce(
  (best, g) => (best == null || g.live_phi_s > best.live_phi_s ? g : best),
  null as (typeof entityGroups)[number] | null
);
const base = import.meta.env.BASE_URL;
const vaultTip = 'Cycle vault rows at publish (trimmed); not M1 lifetime observations';

function formatLong(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
function formatShort(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
}
---

<Layout
  title="Signal Reports — Eigenstate Research"
  description="Dated topology signal reports for the tokenized settlement layer. Re-check cited evidence and public APIs before relying on a report as current state."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      /* ── Page hero ── */
      .page-hero {
        padding: 80px 40px 64px;
        text-align: center;
        border-bottom: 1px solid var(--border);
        background: var(--bg2);
      }

      .page-hero .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.3em;
        color: var(--accent);
        margin-bottom: 16px;
        text-transform: uppercase;
      }

      .page-hero h1 {
        font-family: var(--font-heading);
        font-size: var(--text-5xl);
        font-weight: 900;
        letter-spacing: 0.08em;
        line-height: 1;
        margin-bottom: 24px;
        background: linear-gradient(135deg, var(--text-primary) 0%, var(--signal) 60%, var(--text-primary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .page-hero .explainer {
        font-size: var(--text-base);
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 36px;
        line-height: 1.7;
      }

      /* ── Sections ── */
      section {
        padding: 64px 40px;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.25em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        font-weight: 800;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
      }

      .section-sub {
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 40px;
        font-family: var(--font-mono);
      }

      .divider {
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, var(--signal-dim), transparent);
        margin-bottom: 40px;
      }

      .grad {
        background: linear-gradient(135deg, var(--accent), var(--status-error));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* ── Featured hero card ── */
      .featured-section {
        background: var(--bg2);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
      }

      .featured-loading {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        letter-spacing: 0.15em;
      }

      .featured-card {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-left: 4px solid var(--accent);
        padding: 48px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 48px;
        align-items: center;
        text-decoration: none;
        transition: border-color 0.2s;
      }

      .featured-card:hover {
        border-left-color: var(--status-error);
      }

      .fc-badge {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--accent);
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .fc-entity {
        font-family: var(--font-heading);
        font-size: var(--text-3xl);
        font-weight: 800;
        letter-spacing: 0.04em;
        color: var(--text-primary);
        margin-bottom: 20px;
        line-height: 1.1;
      }

      .fc-meta {
        display: flex;
        gap: 32px;
        align-items: center;
        flex-wrap: wrap;
      }

      .fc-phi {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
      }

      .fc-kappa {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--signal);
      }

      .fc-vault {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        color: var(--status-success);
      }

      .fc-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        letter-spacing: 0.1em;
        margin-bottom: 4px;
      }

      .fc-right {
        text-align: right;
      }

      .fc-date {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 20px;
      }

      .fc-read {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.1em;
        padding: 14px 28px;
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        display: inline-block;
        border-radius: var(--radius-sm);
        transition: all 0.2s;
      }

      .fc-read:hover {
        background: var(--accent-dark);
        transform: translateY(-1px);
      }

      /* ── Reports filter bar ── */
      .reports-filter-bar {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
      }

      .reports-search {
        flex: 1;
        min-width: 200px;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        padding: 12px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
      }

      .reports-search::placeholder {
        color: var(--text-muted);
      }

      .reports-search:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgb(62 111 239 / 15%);
      }

      .reports-sort {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        padding: 12px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        cursor: pointer;
      }

      .reports-empty {
        padding: 48px;
        text-align: center;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-top: none;
      }

      /* ── Entity groups (time series) ── */
      .reports-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
      }

      .entity-card {
        background: var(--bg);
        padding: 24px 24px 16px;
        display: flex;
        flex-direction: column;
        border-left: 3px solid transparent;
        transition: background 0.2s, border-color 0.2s;
      }

      .entity-card:hover {
        background: var(--bg-card);
        border-left-color: var(--accent);
      }

      .ec-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 14px;
      }

      .ec-entity {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--text-primary);
        line-height: 1.3;
      }

      .ec-count {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
        background: rgb(148 163 184 / 12%);
        padding: 3px 7px;
        border-radius: var(--radius-sm);
        white-space: nowrap;
      }

      .ec-metrics {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 12px;
      }

      .ec-phi {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--accent);
        background: rgb(62 111 239 / 10%);
        padding: 3px 8px;
        border-radius: var(--radius-sm);
      }

      .ec-kappa {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--signal);
        background: rgb(47 90 99 / 10%);
        padding: 3px 8px;
        border-radius: var(--radius-sm);
      }

      .ec-live {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--signal);
        background: rgb(47 90 99 / 12%);
        padding: 3px 7px;
        border-radius: var(--radius-sm);
      }

      .ec-vault {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--status-success);
        background: rgb(21 128 61 / 8%);
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        cursor: help;
      }

      .ec-m1 {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-secondary);
        background: rgb(148 163 184 / 12%);
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        cursor: help;
      }

      .sot-note {
        font-size: var(--text-sm);
        color: var(--text-muted);
        max-width: 640px;
        margin: 0 auto 28px;
        line-height: 1.6;
      }

      .sot-note a {
        color: var(--signal);
        text-decoration: none;
      }

      .ec-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 4px;
      }

      .ec-date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      .ec-cta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--signal-dim);
        text-decoration: none;
        letter-spacing: 0.04em;
      }

      .ec-cta:hover {
        color: var(--accent);
      }

      .ec-series {
        margin-top: 10px;
        border-top: 1px solid var(--border);
        padding-top: 8px;
      }

      .ec-series summary {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
        cursor: pointer;
        list-style: none;
        user-select: none;
        padding: 4px 0;
      }

      .ec-series summary::-webkit-details-marker {
        display: none;
      }

      .ec-series summary::before {
        content: '+ ';
        color: var(--signal-dim);
      }

      .ec-series[open] summary::before {
        content: '− ';
      }

      .ec-series summary:hover {
        color: var(--text-secondary);
      }

      .ec-timeline {
        list-style: none;
        margin: 8px 0 4px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        max-height: 220px;
        overflow-y: auto;
        border-left: 2px solid var(--border);
      }

      .ec-tl-item {
        display: block;
        text-decoration: none;
        padding: 8px 0 8px 12px;
        margin-left: -2px;
        border-left: 2px solid transparent;
        transition: background 0.15s, border-color 0.15s;
      }

      .ec-tl-item:hover {
        background: rgb(62 111 239 / 6%);
        border-left-color: var(--accent);
      }

      .ec-tl-item.is-latest {
        border-left-color: var(--signal-dim);
      }

      .ec-tl-date {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-primary);
        margin-bottom: 4px;
      }

      .ec-tl-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
      }

      .ec-tl-metrics .pub {
        color: var(--text-secondary);
      }

      .ec-tl-metrics .vault {
        color: var(--status-success);
      }

      /* ── Tiers ── */
      .tiers-section {
        background: var(--bg2);
        border-top: 1px solid var(--border);
      }

      .tiers-list {
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
      }

      .tier {
        background: var(--bg);
        padding: 32px 36px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
        align-items: start;
        border-left: 3px solid transparent;
        transition: all 0.2s;
      }

      .tier:hover {
        background: var(--bg-card);
        border-left-color: var(--signal-dim);
      }

      .tier-name {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--text-primary);
        margin-bottom: 10px;
      }

      .tier-desc {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 640px;
      }

      .tier-inc {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: 10px;
        letter-spacing: 0.03em;
      }

      .tier-price {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
        white-space: nowrap;
        text-align: right;
      }

      .tier-unit {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-align: right;
        margin-top: 4px;
      }

      /* ── Request form ── */
      .request-section {
        border-top: 1px solid var(--border);
      }

      .request-heading {
        text-align: center;
        margin-bottom: 40px;
      }

      .request-eyebrow {
        justify-content: center;
        display: flex;
      }

      .request-title {
        font-size: var(--text-2xl);
      }

      .request-sub {
        font-size: var(--text-base);
        color: var(--text-secondary);
        margin-top: 12px;
        line-height: 1.8;
      }

      .form-wrap {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 48px;
        max-width: 760px;
        margin: 0 auto;
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
      }

      .form-group label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.15em;
        color: var(--text-muted);
        margin-bottom: 8px;
        text-transform: uppercase;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        font-family: var(--font-body);
        font-size: var(--text-base);
        padding: 14px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        transition: border-color 0.2s;
      }

      .form-group input:focus,
      .form-group select:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgb(62 111 239 / 15%);
      }

      .form-group input::placeholder,
      .form-group textarea::placeholder {
        color: var(--text-muted);
      }

      .form-group select {
        cursor: pointer;
      }

      .form-group select option {
        background: var(--bg-card);
      }

      .form-wrap .btn {
        margin-top: 8px;
      }

      .form-msg {
        text-align: center;
        margin-top: 16px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        min-height: 20px;
      }

      .form-msg.ok {
        color: var(--status-success);
      }

      .form-msg.err {
        color: var(--accent);
      }

      .form-note {
        text-align: center;
        margin-top: 20px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .form-note a {
        color: var(--signal-dim);
        text-decoration: none;
      }

      /* ── Responsive ── */
      @media (width <= 900px) {
        .reports-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (width <= 640px) {
        .page-hero {
          padding: 56px 20px 48px;
        }

        .page-hero h1 {
          font-size: var(--text-2xl);
        }

        section {
          padding: 48px 20px;
        }

        .featured-card {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .fc-right {
          text-align: left;
        }

        .fc-entity {
          font-size: var(--text-xl);
        }

        .reports-grid {
          grid-template-columns: 1fr;
        }

        .tier {
          grid-template-columns: 1fr;
        }

        .tier-price {
          text-align: left;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .form-wrap {
          padding: 28px 20px;
        }
      }
    </style>
  </Fragment>

  <Nav active="reports" cta={{ label: 'Request Report', href: '#request' }} />

  <!-- ── Page hero ── -->
  <div class="page-hero" id="main">
    <div class="eyebrow">EIGENSTATE RESEARCH · TOPOLOGY SIGNAL REPORTS</div>
    <h1>SIGNAL REPORTS</h1>
    <p class="explainer">
      Dated topology research snapshots for the tokenized settlement layer. Each report records
      settlement pressure, field coherence, and information flow at its publication time; re-check
      cited evidence and public APIs before relying on it as current state.
    </p>
    <p class="sot-note">
      Live M1 coverage (SoT): <strong>{sot.coverage.headline}</strong> — engine ledger, not report badges.
      Green badges are <strong>vault@publish</strong> (trimmed cycle-vault rows at publish), not lifetime observations.
      <a href={`${base}METHODOLOGY.md#numbers-glossary`}>What do these numbers mean? → Methodology</a> ·
      <a href={`${base}METHODOLOGY.md`}>Full methodology</a> ·
      <a href={`${base}track-record/`}>Track Record</a>
    </p>
    <a href="#request" class="btn btn-lg btn-gradient">Request a Report →</a>
  </div>

  <!-- ── Featured: highest Φ_S ── -->
  <section class="featured-section">
    <div class="container">
      <div class="eyebrow">HIGHEST SETTLEMENT PRESSURE · FEATURED REPORT</div>
      {
        featured ? (
          <a href={`${base}reports/${featured.latest.slug}/`} class="featured-card">
            <div>
              <div class="fc-badge">Settlement Pressure · Top Entity</div>
              <div class="fc-entity">{featured.entityDisplay}</div>
              <div class="fc-meta">
                <div>
                  <div class="fc-label">Settlement Pressure{featured.using_live ? ' · live' : ''}</div>
                  <div class="fc-phi">Φ_S = {featured.live_phi_s.toFixed(4)}</div>
                </div>
                <div>
                  <div class="fc-label">Field Coherence{featured.using_live ? ' · live' : ''}</div>
                  <div class="fc-kappa">κ = {featured.live_kappa.toFixed(4)}</div>
                </div>
                <div>
                  <div class="fc-label" title={vaultTip}>vault@publish</div>
                  <div class="fc-vault" title={vaultTip}>{featured.latest.data.vault_records} rows</div>
                </div>
                {featured.m1LedgerObs > 0 && (
                  <div>
                    <div class="fc-label" title="m1_strict ledger rows for this entity (SoT)">M1 ledger</div>
                    <div class="fc-vault" style="color: var(--text-secondary);" title="Coverage-ledger m1_strict count for this entity">
                      {featured.m1LedgerObs} obs
                    </div>
                  </div>
                )}
              </div>
            </div>
            <div class="fc-right">
              <div class="fc-date">{formatLong(featured.latestDate)}</div>
              <span class="fc-read">Read latest →</span>
            </div>
          </a>
        ) : (
          <div class="featured-loading">No reports published yet.</div>
        )
      }
    </div>
  </section>

  <!-- ── Entity groups with dated time series ── -->
  <section>
    <div class="container">
      <div class="eyebrow">ENTITY TIME SERIES</div>
      <h2 class="section-title">Tracked <span class="grad">entities</span></h2>
      <div class="section-sub">
        One card per entity. Expand for prior dated reports. {entityGroups.length} entities · {reports.length} published.
      </div>

      <div class="reports-filter-bar">
        <input
          type="text"
          id="reportsSearch"
          class="reports-search"
          placeholder="Search by entity name…"
          aria-label="Search entities by name"
        />
        <select id="reportsSort" class="reports-sort" aria-label="Sort entities">
          <option value="newest">Newest activity</option>
          <option value="phi-desc">Highest Φ_S</option>
          <option value="az">A–Z</option>
        </select>
      </div>

      <div class="reports-grid" id="reportsGrid">
        {
          entityGroups.map((g) => (
            <article
              class="entity-card"
              data-entity={g.entityDisplay}
              data-phi-s={g.live_phi_s}
              data-date-iso={g.latestDate}
              data-name={g.entityDisplay}
            >
              <div class="ec-title-row">
                <div class="ec-entity">{g.entityDisplay}</div>
                <span class="ec-count">
                  {g.count} {g.count === 1 ? 'report' : 'reports'}
                </span>
              </div>
              <div class="ec-metrics">
                <span class="ec-phi">Φ_S {g.live_phi_s.toFixed(3)}</span>
                <span class="ec-kappa">κ {g.live_kappa.toFixed(3)}</span>
                {g.using_live && (
                  <span class="ec-live" title="Φ_S / κ from live dossier SoT overlay">live</span>
                )}
                <span class="ec-vault" title={vaultTip}>
                  vault@pub {g.latest.data.vault_records}
                </span>
                {g.m1LedgerObs > 0 && (
                  <span class="ec-m1" title="m1_strict coverage-ledger rows for this entity (SoT); not vault@publish">
                    M1 {g.m1LedgerObs}
                  </span>
                )}
              </div>
              <div class="ec-footer">
                <span class="ec-date">Latest {formatShort(g.latestDate)}</span>
                <a class="ec-cta" href={`${base}reports/${g.latest.slug}/`}>Read latest →</a>
              </div>
              {g.count > 1 && (
                <details class="ec-series">
                  <summary>
                    Timeline · {g.count} dated reports
                  </summary>
                  <ol class="ec-timeline">
                    {g.series.map((r, i) => (
                      <li>
                        <a
                          href={`${base}reports/${r.slug}/`}
                          class:list={['ec-tl-item', { 'is-latest': i === 0 }]}
                        >
                          <div class="ec-tl-date">
                            {formatShort(r.data.date_iso)}
                            {i === 0 ? ' · latest' : ''}
                          </div>
                          <div class="ec-tl-metrics">
                            <span class="pub">Φ_S {r.data.phi_s.toFixed(3)}</span>
                            <span class="pub">κ {r.data.kappa.toFixed(3)}</span>
                            <span class="vault" title={vaultTip}>vault@pub {r.data.vault_records}</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
            </article>
          ))
        }
      </div>
      <div class="reports-empty" id="reportsEmpty" style="display: none;">No entities match your search.</div>
    </div>
  </section>

  <!-- ── Pricing tiers ── -->
  <section class="tiers-section">
    <div class="container">
      <div class="eyebrow">REPORTS</div>
      <h2 class="section-title">The information field, <span class="grad">made visible.</span></h2>
      <div class="divider"></div>
      <div class="tiers-list">
        <div class="tier">
          <div>
            <div class="tier-name">SINGLE ENTITY REPORT</div>
            <div class="tier-desc">
              Full topology analysis of one entity: extraction pressure (Γ), loop membership, curl
              wave state, N+1 trajectory, settlement pain (Φ_S). PDF + raw JSON within 24 hours.
            </div>
            <div class="tier-inc">
              Includes: Γ score · loop velocity · curl state · N+1 prediction · settlement path ·
              EAS attestation
            </div>
          </div>
          <div><div class="tier-price">$59</div><div class="tier-unit">per entity</div></div>
        </div>
        <div class="tier">
          <div>
            <div class="tier-name">SECTOR REPORT — INFORMATION FLOW</div>
            <div class="tier-desc">
              Full analysis of the information flow sector: 164 entities, 158 currently breaking,
              Φ_S scores, loop velocity rankings, recommended positions. Updated weekly on atomic
              cycle.
            </div>
            <div class="tier-inc">
              Includes: full sector map · weekly Δ · top breaking entities · forming loops · field
              equations
            </div>
          </div>
          <div><div class="tier-price">$490</div><div class="tier-unit">per month</div></div>
        </div>
        <div class="tier">
          <div>
            <div class="tier-name">CUSTOM TOPOLOGY BRIEFING</div>
            <div class="tier-desc">
              Bespoke analysis for your investment thesis, regulatory question, or infrastructure
              positioning. Includes methodology session and engine output for the engagement
              period.
            </div>
            <div class="tier-inc">
              Includes: custom entity set · methodology session · engine output · follow-up Q&A
            </div>
          </div>
          <div><div class="tier-price">$2,400</div><div class="tier-unit">per engagement</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Request a Report ── -->
  <section class="request-section" id="request">
    <div class="container">
      <div class="request-heading">
        <div class="eyebrow request-eyebrow">REQUEST A REPORT</div>
        <h2 class="section-title request-title">
          Get the topology read on<br /><span class="grad">your entity or sector.</span>
        </h2>
        <p class="request-sub">Tell us what you're tracking. Response within 24 hours.</p>
      </div>
      <div class="form-wrap">
        <div class="form-row">
          <div class="form-group"><label for="fn">Name</label><input type="text" id="fn" placeholder="Your name" /></div>
          <div class="form-group">
            <label for="fe">Email</label><input type="email" id="fe" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="form-group">
          <label for="fo">Organization</label><input type="text" id="fo" placeholder="Fund / firm / independent" />
        </div>
        <div class="form-group">
          <label for="ft">Report type</label>
          <select id="ft">
            <option value="" disabled selected>Select report type</option>
            <option>Single entity report — $59</option>
            <option>Sector report — $490/month</option>
            <option>Custom briefing — $2,400</option>
            <option>Not sure — send me a sample</option>
          </select>
        </div>
        <div class="form-group">
          <label for="fent">Entity or sector of interest</label>
          <textarea
            id="fent"
            rows="3"
            placeholder="e.g. Circle, Coinbase, OCC regulatory loop, GENIUS Act implementation, stablecoin issuance layer…"
          ></textarea>
        </div>
        <button class="btn btn-md btn-block" id="submitBtn" type="button">
          REQUEST REPORT
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
            ><path
              d="M3 8h10M8 3l5 5-5 5"
              stroke="white"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path></svg
          >
        </button>
        <div class="form-msg" id="msg"></div>
        <p class="form-note">Or email: <a href="mailto:ksekhon9851@Gmail.com">ksekhon9851@Gmail.com</a></p>
      </div>
    </div>
  </section>

  <Footer variant="full" />

  <script>
    import { initReveal } from '../../scripts/reveal';
    import { initFilterList } from '../../scripts/filter-list';

    initReveal({ selector: '.featured-card, .entity-card' });

    initFilterList({
      containerSelector: '#reportsGrid',
      itemSelector: '.entity-card',
      searchInputSelector: '#reportsSearch',
      searchFields: ['entity'],
      sortSelectSelector: '#reportsSort',
      sortOptions: {
        newest: { field: 'dateIso', direction: 'desc', type: 'string' },
        'phi-desc': { field: 'phiS', direction: 'desc', type: 'number' },
        az: { field: 'name', direction: 'asc', type: 'string' },
      },
      emptyStateSelector: '#reportsEmpty',
    });

    async function submitForm() {
      const eInput = document.getElementById('fe') as HTMLInputElement;
      const e = eInput.value.trim();
      const msg = document.getElementById('msg')!;
      if (!e || !e.includes('@')) {
        msg.textContent = 'Please enter a valid email.';
        msg.className = 'form-msg err';
        return;
      }
      msg.textContent = 'Sending…';
      msg.className = 'form-msg';
      try {
        const r = await fetch('https://formspree.io/f/xgoprgww', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: (document.getElementById('fn') as HTMLInputElement).value,
            email: e,
            organization: (document.getElementById('fo') as HTMLInputElement).value,
            report_type: (document.getElementById('ft') as HTMLSelectElement).value,
            entity_interest: (document.getElementById('fent') as HTMLTextAreaElement).value,
            _subject: 'Eigenstate — signal report request',
          }),
        });
        if (r.ok) {
          msg.textContent = 'Received. Response within 24 hours. — Eigenstate Research';
          msg.className = 'form-msg ok';
        } else {
          msg.textContent = 'Something went wrong. Email ksekhon9851@Gmail.com directly.';
          msg.className = 'form-msg err';
        }
      } catch (_) {
        msg.textContent = 'Network error. Email ksekhon9851@Gmail.com directly.';
        msg.className = 'form-msg err';
      }
    }

    document.getElementById('submitBtn')?.addEventListener('click', submitForm);
  </script>
</Layout>
