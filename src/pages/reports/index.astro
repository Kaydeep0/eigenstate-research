---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { slugFor, hubSlugForEntityCode } from '../../lib/reports';
import {
  loadSot,
  entityCodeFromReportId,
  resolveReportMetrics,
  m1LedgerObsFor,
} from '../../lib/sot';
import { annotateEntityCode, REPORT_FACETS } from '../../lib/displayKind';
import { groupActorsByFamily } from '../../lib/actorFamilies';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const sot = loadSot();
const reports = (await getCollection('reports')).map((r) => {
  const code = entityCodeFromReportId(r.data.id);
  const m = resolveReportMetrics(code, { phi_s: r.data.phi_s, kappa: r.data.kappa });
  return {
    ...r,
    slug: slugFor(r.id),
    entityCode: code,
    m1LedgerObs: m1LedgerObsFor(code),
    live_phi_s: m.phi_s,
    live_kappa: m.kappa,
    using_live: m.using_live,
  };
});
type ReportRow = (typeof reports)[number];

const byEntity = new Map<string, ReportRow[]>();
for (const r of reports) {
  const list = byEntity.get(r.entityCode) ?? [];
  list.push(r);
  byEntity.set(r.entityCode, list);
}

const entityGroups = [...byEntity.entries()]
  .map(([code, items]) => {
    const series = [...items].sort((a, b) => b.data.date_iso.localeCompare(a.data.date_iso));
    const latest = series[0];
    const kind = annotateEntityCode(code);
    return {
      entityCode: code,
      hubSlug: hubSlugForEntityCode(code),
      entityDisplay: latest.data.entity_display,
      latest,
      series,
      count: series.length,
      live_phi_s: latest.live_phi_s,
      live_kappa: latest.live_kappa,
      using_live: latest.using_live,
      m1LedgerObs: latest.m1LedgerObs,
      latestDate: latest.data.date_iso,
      display_kind: kind.display_kind,
      facet_label: kind.facet_label,
      public_default: kind.public_default !== false,
      demoted: Boolean(kind.demoted),
    };
  })
  .sort((a, b) => b.latestDate.localeCompare(a.latestDate));

type EntityGroup = (typeof entityGroups)[number];
const families = groupActorsByFamily(entityGroups);
const publicActorCount = entityGroups.filter((g) => g.public_default).length;
const demotedCount = entityGroups.filter((g) => g.demoted).length;
const rootCount = families.length;

const base = import.meta.env.BASE_URL;

function parseIsoDate(iso: string): Date | null {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return null;
  const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  return isNaN(d.getTime()) ? null : d;
}
function formatShort(iso: string): string {
  const d = parseIsoDate(iso);
  return d
    ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase()
    : iso;
}
---

<Layout
  title="Measured actors · Eigenstate Research"
  description="Public actors we observe with dated signal reports. Kind, latest report, last activity; Φ_S secondary. Dimensions demoted."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .page-hero {
        padding: 64px 40px 36px;
        border-bottom: 1px solid var(--border);
        background: var(--bg2);
      }

      .page-hero .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--text-muted);
        margin-bottom: 12px;
        text-transform: uppercase;
      }

      .page-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 12px;
        color: var(--text-primary);
      }

      .page-hero .explainer {
        font-size: var(--text-base);
        color: var(--text-secondary);
        max-width: 640px;
        line-height: 1.65;
        margin-bottom: 10px;
      }

      .sot-note {
        font-size: var(--text-sm);
        color: var(--text-muted);
        max-width: 640px;
        line-height: 1.6;
      }

      .sot-note a {
        color: var(--signal);
        text-decoration: none;
      }

      section {
        padding: 40px 40px 64px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
      }

      .section-sub {
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 20px;
        font-family: var(--font-mono);
      }

      .reports-filter-bar {
        display: flex;
        gap: 16px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }

      .reports-facets {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
        align-items: center;
      }

      .reports-facets .facet-hint {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.04em;
        margin-right: 4px;
      }

      .reports-facets .filt {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 6px 10px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--bg-card);
        color: var(--text-secondary);
        cursor: pointer;
        user-select: none;
      }

      .reports-facets .filt:hover {
        border-color: var(--signal-dim);
        color: var(--text-primary);
      }

      .reports-facets .filt.is-on {
        border-color: var(--accent);
        color: var(--accent);
        background: rgb(62 111 239 / 10%);
      }

      .reports-search {
        flex: 1;
        min-width: 200px;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        padding: 12px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
      }

      .reports-search:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgb(62 111 239 / 15%);
      }

      .reports-sort {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        padding: 12px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        cursor: pointer;
      }

      .reports-empty {
        padding: 32px;
        text-align: center;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-top: none;
      }

      .actors-table-wrap {
        border: 1px solid var(--border);
        overflow-x: auto;
      }

      .actors-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }

      .actors-table th,
      .actors-table td {
        text-align: left;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        color: var(--text-secondary);
        vertical-align: middle;
      }

      .actors-table th {
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        background: var(--bg2);
        font-weight: 500;
      }

      .actors-table td.n,
      .actors-table th.n {
        text-align: right;
        white-space: nowrap;
      }

      .actors-table .actor-name {
        color: var(--text-primary);
        font-weight: 600;
        text-decoration: none;
      }

      .actors-table .actor-name:hover {
        color: var(--accent);
      }

      .actors-table .phi-sec {
        color: var(--text-muted);
        font-size: 12px;
      }

      .actors-table .kind-chip {
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
        background: rgb(148 163 184 / 12%);
        padding: 2px 7px;
        border-radius: var(--radius-sm);
      }

      .actors-table .kind-chip.is-demoted {
        color: var(--signal);
        background: rgb(47 90 99 / 12%);
      }

      .actors-table tr.child-row td:first-child {
        padding-left: 32px;
      }

      .actors-table tr.child-row {
        background: rgb(0 0 0 / 1.5%);
      }

      .actors-table a.subtle {
        color: var(--signal-dim);
        text-decoration: none;
      }

      .actors-table a.subtle:hover {
        text-decoration: underline;
      }

      .mobile-cards {
        display: none;
      }

      .tiers-section {
        background: var(--bg2);
        border-top: 1px solid var(--border);
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        font-weight: 800;
        letter-spacing: 0.03em;
        margin-bottom: 8px;
      }

      .grad {
        background: linear-gradient(135deg, var(--accent), var(--status-error));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .divider {
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, var(--signal-dim), transparent);
        margin-bottom: 32px;
      }

      .tiers-list {
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
      }

      .tier {
        background: var(--bg);
        padding: 28px 32px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
      }

      .tier-name {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
      }

      .tier-desc {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 640px;
      }

      .tier-inc {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: 10px;
      }

      .tier-price {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
        text-align: right;
      }

      .tier-unit {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-align: right;
        margin-top: 4px;
      }

      .request-section {
        border-top: 1px solid var(--border);
      }

      .request-heading {
        text-align: center;
        margin-bottom: 32px;
      }

      .form-wrap {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 40px;
        max-width: 760px;
        margin: 0 auto;
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
      }

      .form-group label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.15em;
        color: var(--text-muted);
        margin-bottom: 8px;
        text-transform: uppercase;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        font-family: var(--font-body);
        font-size: var(--text-base);
        padding: 14px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
      }

      .form-msg {
        text-align: center;
        margin-top: 16px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        min-height: 20px;
      }

      .form-msg.ok {
        color: var(--status-success);
      }

      .form-msg.err {
        color: var(--accent);
      }

      .form-note {
        text-align: center;
        margin-top: 20px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .form-note a {
        color: var(--signal-dim);
        text-decoration: none;
      }

      @media (width <= 720px) {
        .page-hero,
        section {
          padding-left: 20px;
          padding-right: 20px;
        }

        .desktop-table {
          display: none;
        }

        .mobile-cards {
          display: block;
        }

        .mobile-card {
          border: 1px solid var(--border);
          border-bottom: none;
          padding: 14px 16px;
          background: var(--bg);
        }

        .mobile-card:last-child {
          border-bottom: 1px solid var(--border);
        }

        .mobile-card .name {
          font-family: var(--font-heading);
          font-weight: 700;
          margin-bottom: 6px;
        }

        .mobile-card .meta {
          font-family: var(--font-mono);
          font-size: 12px;
          color: var(--text-muted);
          line-height: 1.6;
        }

        .tier {
          grid-template-columns: 1fr;
        }

        .tier-price,
        .tier-unit {
          text-align: left;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .form-wrap {
          padding: 24px 18px;
        }
      }
    </style>
  </Fragment>

  <Nav active="reports" cta={{ label: 'Request Report', href: '#request' }} />

  <div class="page-hero" id="main">
    <div class="eyebrow">Eigenstate Research · measured actors</div>
    <h1>Measured actors</h1>
    <p class="explainer">
      Actors we observe with dated signal reports. Dimensions stay measurable but sit under the
      Dimensions facet, not as peers of public actors.
    </p>
    <p class="sot-note">
      Live M1 coverage (SoT): <strong>{sot.coverage.headline}</strong>. Φ_S is a secondary column,
      not the default sort.{' '}
      <a href={`${base}METHODOLOGY.md#numbers-glossary`}>Numbers glossary</a> ·{' '}
      <a href={`${base}track-record/`}>Track Record</a>
    </p>
  </div>

  <section>
    <div class="container">
      <div class="section-sub">
        Default: public actors · {publicActorCount} public · {demotedCount} demoted · {rootCount}{' '}
        parent rows · {entityGroups.length} entities · {reports.length} dated reports
      </div>

      <div class="reports-filter-bar">
        <input
          type="text"
          id="reportsSearch"
          class="reports-search"
          placeholder="Search by actor name…"
          aria-label="Search actors by name"
        />
        <select id="reportsFacet" class="reports-sort" aria-label="Facet filter" hidden>
          {REPORT_FACETS.map((f) => (
            <option value={f.id} selected={f.id === 'public'}>
              {f.label}
            </option>
          ))}
          <option value="all">All (incl. dimensions)</option>
        </select>
        <select id="reportsSort" class="reports-sort" aria-label="Sort actors">
          <option value="newest" selected>Newest activity</option>
          <option value="az">A-Z</option>
          <option value="phi-desc">Φ_S (secondary)</option>
        </select>
      </div>

      <div class="reports-facets" id="reportsFacets" role="toolbar" aria-label="Browse by facet">
        <span class="facet-hint">Browse</span>
        {
          REPORT_FACETS.map((f) => (
            <span class:list={['filt', { 'is-on': f.id === 'public' }]} data-f={f.id}>
              {f.label}
            </span>
          ))
        }
        <span class="filt" data-f="all">All</span>
      </div>

      <div class="actors-table-wrap desktop-table">
        <table class="actors-table" id="actorsTable">
          <thead>
            <tr>
              <th>Actor</th>
              <th>Kind</th>
              <th>Latest report</th>
              <th>Last activity</th>
              <th class="n">Φ_S</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="reportsGrid">
            {
              families.map(({ parent: g, children }) => (
                <>
                  <tr
                    class="actor-row"
                    data-entity={g.entityDisplay}
                    data-phi-s={g.live_phi_s}
                    data-date-iso={g.latestDate}
                    data-name={g.entityDisplay}
                    data-display-kind={g.display_kind}
                    data-public-default={g.public_default ? 'true' : 'false'}
                    data-demoted={g.demoted ? 'true' : 'false'}
                    data-family-id={g.entityCode}
                    style={g.demoted && g.public_default === false ? 'display: none;' : undefined}
                  >
                    <td>
                      {children.length > 0 && (
                        <button
                          type="button"
                          class="rank-expand"
                          aria-expanded="false"
                          aria-controls={`kids-${g.entityCode}`}
                          data-expand={g.entityCode}
                          data-count={children.length}
                        >
                          +{children.length}
                        </button>
                      )}
                      <a class="actor-name" href={`${base}reports/${g.hubSlug}/`}>
                        {g.entityDisplay}
                      </a>
                    </td>
                    <td>
                      <span class:list={['kind-chip', { 'is-demoted': g.demoted }]}>
                        {g.facet_label}
                      </span>
                    </td>
                    <td>
                      <a class="subtle" href={`${base}reports/${g.latest.slug}/`}>
                        {g.count} {g.count === 1 ? 'report' : 'reports'}
                      </a>
                    </td>
                    <td>{formatShort(g.latestDate)}</td>
                    <td class="n phi-sec">{g.live_phi_s.toFixed(3)}</td>
                    <td>
                      <a class="subtle" href={`${base}reports/${g.hubSlug}/`}>
                        hub
                      </a>
                    </td>
                  </tr>
                  {children.map((child: EntityGroup) => (
                    <tr
                      class="child-row"
                      id={`kid-${child.entityCode}`}
                      data-parent={g.entityCode}
                      data-entity={child.entityDisplay}
                      data-phi-s={child.live_phi_s}
                      data-date-iso={child.latestDate}
                      data-name={child.entityDisplay}
                      data-display-kind={child.display_kind}
                      data-public-default={child.public_default ? 'true' : 'false'}
                      data-demoted={child.demoted ? 'true' : 'false'}
                      hidden
                    >
                      <td>
                        <a class="actor-name" href={`${base}reports/${child.hubSlug}/`}>
                          {child.entityDisplay}
                        </a>
                      </td>
                      <td>
                        <span class:list={['kind-chip', { 'is-demoted': child.demoted }]}>
                          {child.facet_label}
                        </span>
                      </td>
                      <td>
                        <a class="subtle" href={`${base}reports/${child.latest.slug}/`}>
                          {child.count} {child.count === 1 ? 'report' : 'reports'}
                        </a>
                      </td>
                      <td>{formatShort(child.latestDate)}</td>
                      <td class="n phi-sec">{child.live_phi_s.toFixed(3)}</td>
                      <td>
                        <a class="subtle" href={`${base}reports/${child.hubSlug}/`}>
                          hub
                        </a>
                      </td>
                    </tr>
                  ))}
                </>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="reports-empty" id="reportsEmpty" style="display: none;">No actors match.</div>

      <div class="mobile-cards" id="mobileCards">
        {
          families.map(({ parent: g, children }) => (
            <div
              class="mobile-card actor-row"
              data-entity={g.entityDisplay}
              data-phi-s={g.live_phi_s}
              data-date-iso={g.latestDate}
              data-name={g.entityDisplay}
              data-display-kind={g.display_kind}
              data-public-default={g.public_default ? 'true' : 'false'}
              data-demoted={g.demoted ? 'true' : 'false'}
              style={g.demoted && g.public_default === false ? 'display: none;' : undefined}
            >
              <div class="name">
                <a class="actor-name" href={`${base}reports/${g.hubSlug}/`}>
                  {g.entityDisplay}
                </a>
              </div>
              <div class="meta">
                {g.facet_label} · {formatShort(g.latestDate)} · Φ_S {g.live_phi_s.toFixed(3)}
                {children.length > 0 && ` · ${children.length} instruments`}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tiers-section">
    <div class="container">
      <h2 class="section-title">Report <span class="grad">tiers</span></h2>
      <div class="divider"></div>
      <div class="tiers-list">
        <div class="tier">
          <div>
            <div class="tier-name">SINGLE ENTITY REPORT</div>
            <div class="tier-desc">
              Full topology analysis of one entity: extraction pressure (Γ), loop membership, curl
              wave state, N+1 trajectory, settlement pain (Φ_S). PDF + raw JSON within 24 hours.
            </div>
            <div class="tier-inc">
              Includes: Γ score · loop velocity · curl state · N+1 prediction · settlement path ·
              EAS attestation
            </div>
          </div>
          <div><div class="tier-price">$59</div><div class="tier-unit">per entity</div></div>
        </div>
        <div class="tier">
          <div>
            <div class="tier-name">SECTOR REPORT</div>
            <div class="tier-desc">
              Full analysis of the information flow sector with Φ_S scores, loop velocity rankings,
              and recommended positions. Updated weekly on atomic cycle.
            </div>
            <div class="tier-inc">
              Includes: full sector map · weekly Δ · top breaking entities · forming loops
            </div>
          </div>
          <div><div class="tier-price">$490</div><div class="tier-unit">per month</div></div>
        </div>
        <div class="tier">
          <div>
            <div class="tier-name">CUSTOM TOPOLOGY BRIEFING</div>
            <div class="tier-desc">
              Bespoke analysis for your investment thesis, regulatory question, or infrastructure
              positioning.
            </div>
            <div class="tier-inc">
              Includes: custom entity set · methodology session · engine output · follow-up Q&A
            </div>
          </div>
          <div><div class="tier-price">$2,400</div><div class="tier-unit">per engagement</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="request-section" id="request">
    <div class="container">
      <div class="request-heading">
        <h2 class="section-title">Request a report</h2>
        <p class="section-sub" style="text-align:center;">Response within 24 hours.</p>
      </div>
      <div class="form-wrap">
        <div class="form-row">
          <div class="form-group"><label for="fn">Name</label><input type="text" id="fn" placeholder="Your name" /></div>
          <div class="form-group">
            <label for="fe">Email</label><input type="email" id="fe" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="form-group">
          <label for="fo">Organization</label><input type="text" id="fo" placeholder="Fund / firm / independent" />
        </div>
        <div class="form-group">
          <label for="ft">Report type</label>
          <select id="ft">
            <option value="" disabled selected>Select report type</option>
            <option>Single entity report · $59</option>
            <option>Sector report · $490/month</option>
            <option>Custom briefing · $2,400</option>
            <option>Not sure · send me a sample</option>
          </select>
        </div>
        <div class="form-group">
          <label for="fent">Entity or sector of interest</label>
          <textarea id="fent" rows="3" placeholder="e.g. Circle, Coinbase, OCC regulatory loop…"></textarea>
        </div>
        <button class="btn btn-md btn-block" id="submitBtn" type="button">REQUEST REPORT</button>
        <div class="form-msg" id="msg"></div>
        <p class="form-note">Or email: <a href="mailto:ksekhon9851@Gmail.com">ksekhon9851@Gmail.com</a></p>
      </div>
    </div>
  </section>

  <Footer variant="full" />

  <script>
    import { initFilterList } from '../../scripts/filter-list';

    initFilterList({
      containerSelector: '#reportsGrid',
      itemSelector: '.actor-row',
      searchInputSelector: '#reportsSearch',
      searchFields: ['entity'],
      filterSelectSelector: '#reportsFacet',
      customFilter: (el, filterValue) => {
        const v = filterValue || 'public';
        if (v === 'all') return true;
        if (v === 'public') return el.dataset.publicDefault === 'true';
        if (v === 'dimension') {
          return el.dataset.displayKind === 'dimension' || el.dataset.demoted === 'true';
        }
        return el.dataset.displayKind === v;
      },
      sortSelectSelector: '#reportsSort',
      sortOptions: {
        newest: { field: 'dateIso', direction: 'desc', type: 'string' },
        'phi-desc': { field: 'phiS', direction: 'desc', type: 'number' },
        az: { field: 'name', direction: 'asc', type: 'string' },
      },
      emptyStateSelector: '#reportsEmpty',
    });

    // Keep child rows under parents after sort/filter; hide kids when parent is filtered out.
    const tbody = document.getElementById('reportsGrid');
    function reattachChildren() {
      if (!tbody) return;
      tbody.querySelectorAll<HTMLElement>('.actor-row').forEach((row) => {
        const id = row.dataset.familyId;
        if (!id) return;
        const kids = Array.from(
          tbody.querySelectorAll<HTMLElement>(`.child-row[data-parent="${id}"]`)
        );
        let anchor: Element = row;
        kids.forEach((kid) => {
          anchor.after(kid);
          anchor = kid;
        });
        const parentHidden = row.style.display === 'none';
        const btn = row.querySelector<HTMLButtonElement>('.rank-expand');
        const expanded = btn?.getAttribute('aria-expanded') === 'true';
        kids.forEach((kid) => {
          kid.hidden = parentHidden || !expanded;
        });
      });
    }
    const sortSelect = document.getElementById('reportsSort');
    const facetSelect = document.getElementById('reportsFacet') as HTMLSelectElement | null;
    const search = document.getElementById('reportsSearch');
    sortSelect?.addEventListener('change', () => queueMicrotask(reattachChildren));
    facetSelect?.addEventListener('change', () => queueMicrotask(reattachChildren));
    search?.addEventListener('input', () => queueMicrotask(reattachChildren));

    const facetBar = document.getElementById('reportsFacets');
    facetBar?.querySelectorAll<HTMLElement>('.filt').forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.f || 'public';
        if (facetSelect) {
          facetSelect.value = id;
          facetSelect.dispatchEvent(new Event('change'));
        }
        facetBar.querySelectorAll('.filt').forEach((c) => c.classList.remove('is-on'));
        chip.classList.add('is-on');
        queueMicrotask(reattachChildren);
      });
    });
    facetSelect?.dispatchEvent(new Event('change'));

    document.querySelectorAll<HTMLButtonElement>('.rank-expand[data-expand]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.expand || '';
        const count = btn.dataset.count || '';
        const open = btn.getAttribute('aria-expanded') === 'true';
        const next = !open;
        btn.setAttribute('aria-expanded', String(next));
        btn.textContent = next ? `-${count}` : `+${count}`;
        document.querySelectorAll<HTMLElement>(`.child-row[data-parent="${id}"]`).forEach((row) => {
          row.hidden = !next;
        });
      });
    });

    // Mobile cards share the same filter dataset via a second pass.
    initFilterList({
      containerSelector: '#mobileCards',
      itemSelector: '.actor-row',
      searchInputSelector: '#reportsSearch',
      searchFields: ['entity'],
      filterSelectSelector: '#reportsFacet',
      customFilter: (el, filterValue) => {
        const v = filterValue || 'public';
        if (v === 'all') return true;
        if (v === 'public') return el.dataset.publicDefault === 'true';
        if (v === 'dimension') {
          return el.dataset.displayKind === 'dimension' || el.dataset.demoted === 'true';
        }
        return el.dataset.displayKind === v;
      },
      sortSelectSelector: '#reportsSort',
      sortOptions: {
        newest: { field: 'dateIso', direction: 'desc', type: 'string' },
        'phi-desc': { field: 'phiS', direction: 'desc', type: 'number' },
        az: { field: 'name', direction: 'asc', type: 'string' },
      },
    });

    async function submitForm() {
      const eInput = document.getElementById('fe') as HTMLInputElement;
      const e = eInput.value.trim();
      const msg = document.getElementById('msg')!;
      if (!e || !e.includes('@')) {
        msg.textContent = 'Please enter a valid email.';
        msg.className = 'form-msg err';
        return;
      }
      msg.textContent = 'Sending…';
      msg.className = 'form-msg';
      try {
        const r = await fetch('https://formspree.io/f/xgoprgww', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: (document.getElementById('fn') as HTMLInputElement).value,
            email: e,
            organization: (document.getElementById('fo') as HTMLInputElement).value,
            report_type: (document.getElementById('ft') as HTMLSelectElement).value,
            entity_interest: (document.getElementById('fent') as HTMLTextAreaElement).value,
            _subject: 'Eigenstate signal report request',
          }),
        });
        if (r.ok) {
          msg.textContent = 'Received. Response within 24 hours.';
          msg.className = 'form-msg ok';
        } else {
          msg.textContent = 'Something went wrong. Email ksekhon9851@Gmail.com directly.';
          msg.className = 'form-msg err';
        }
      } catch (_) {
        msg.textContent = 'Network error. Email ksekhon9851@Gmail.com directly.';
        msg.className = 'form-msg err';
      }
    }

    document.getElementById('submitBtn')?.addEventListener('click', submitForm);
  </script>
</Layout>
