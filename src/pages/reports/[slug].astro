---
import { getCollection, type CollectionEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import EntityHub from '../../components/EntityHub.astro';
import { slugFor, hubSlugForEntityCode } from '../../lib/reports';
import { prepareReportBody, loadClaimSourceLinks } from '../../lib/reportBody';
import { buildReportLinkCatalog } from '../../lib/federationLinks';
import {
  loadSot,
  entityCodeFromReportId,
  resolveReportMetrics,
  formatNum,
  m1LedgerObsFor,
} from '../../lib/sot';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  const reportPaths = reports.map((entry) => ({
    params: { slug: slugFor(entry.id) },
    props: { kind: 'report' as const, entry, allReports: reports },
  }));

  const byEntity = new Map<string, typeof reports>();
  for (const r of reports) {
    const code = entityCodeFromReportId(r.data.id);
    const list = byEntity.get(code) ?? [];
    list.push(r);
    byEntity.set(code, list);
  }

  const hubPaths = [...byEntity.entries()].map(([code, items]) => {
    const seriesSorted = [...items].sort((a, b) => b.data.date_iso.localeCompare(a.data.date_iso));
    const hubSlug = hubSlugForEntityCode(code);
    return {
      params: { slug: hubSlug },
      props: {
        kind: 'hub' as const,
        entityCode: code,
        entityDisplay: seriesSorted[0].data.entity_display,
        hubSlug,
        series: seriesSorted.map((r) => ({
          slug: slugFor(r.id),
          date_iso: r.data.date_iso,
          date_label: r.data.date,
          phi_s: r.data.phi_s,
          kappa: r.data.kappa,
          vault_records: r.data.vault_records,
        })),
        latestSlug: slugFor(seriesSorted[0].id),
        latestDateIso: seriesSorted[0].data.date_iso,
      },
    };
  });

  return [...reportPaths, ...hubPaths];
}

const isHub = Astro.props.kind === 'hub';

let entity_display = '';
let date = '';
let date_iso = '';
let vault_records = 0;
let id = '';
let phi_s = 0;
let kappa = 0;
let using_live = false;
let live: ReturnType<typeof resolveReportMetrics>['live'] = {
  phi_s: null,
  kappa: null,
  source: 'none',
};
let publish_phi_s = 0;
let publish_kappa = 0;
let m1LedgerObs = 0;
let base = import.meta.env.BASE_URL;
let reportSlug = '';
let entityCode = '';
let hubSlug = '';
let humanDossier = '';
let methodology = '';
let glossary = '';
let verifyWalkthrough = '';
let articleHtml = '';
let issuerSources: ReturnType<typeof loadClaimSourceLinks> = [];
let regulatorSources: ReturnType<typeof loadClaimSourceLinks> = [];
let otherClaimSources: ReturnType<typeof loadClaimSourceLinks> = [];
let humanPages: ReturnType<typeof buildReportLinkCatalog>['human'] = [];
let machineLinks: ReturnType<typeof buildReportLinkCatalog>['machine'] = [];
let vercelApps: ReturnType<typeof buildReportLinkCatalog>['vercelApps'] = [];
let fingerprints: ReturnType<typeof buildReportLinkCatalog>['fingerprints'] = {
  node_id: '',
  chain_hash: '',
  granth_head: '',
  granth_length: 0,
};
let siblings: Array<{ slug: string; entity_display: string; live_phi: number; date_iso: string }> = [];
let sot = loadSot();
let fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';
let description = '';

if (!isHub) {
  const { entry, allReports } = Astro.props as {
    kind: 'report';
    entry: CollectionEntry<'reports'>;
    allReports: CollectionEntry<'reports'>[];
  };
  entity_display = entry.data.entity_display;
  date = entry.data.date;
  date_iso = entry.data.date_iso;
  vault_records = entry.data.vault_records;
  id = entry.data.id;
  const publishPhi = entry.data.phi_s;
  const publishKap = entry.data.kappa;
  sot = loadSot();
  entityCode = entityCodeFromReportId(id);
  hubSlug = hubSlugForEntityCode(entityCode);
  const metrics = resolveReportMetrics(entityCode, { phi_s: publishPhi, kappa: publishKap });
  ({ phi_s, kappa, using_live, live, publish_phi_s, publish_kappa } = metrics);
  m1LedgerObs = m1LedgerObsFor(entityCode);

  base = import.meta.env.BASE_URL;
  reportSlug = slugFor(entry.id);
  humanDossier = `${base}dossier/${entityCode}/`;
  methodology = `${base}METHODOLOGY.md`;
  glossary = `${base}METHODOLOGY.md#numbers-glossary`;
  verifyWalkthrough = `${base}verify-walkthrough/`;

  const { article } = prepareReportBody(entry.body, entityCode);
  const g = globalThis as typeof globalThis & {
    __eigenReportMd?: Awaited<ReturnType<typeof createMarkdownProcessor>>;
  };
  if (!g.__eigenReportMd) {
    g.__eigenReportMd = await createMarkdownProcessor({ gfm: true, smartypants: false });
  }
  const processor = g.__eigenReportMd;
  ({ code: articleHtml } = await processor.render(article));

  const claimSources = loadClaimSourceLinks(entityCode);
  issuerSources = claimSources.filter((s) => s.group === 'issuer');
  regulatorSources = claimSources.filter((s) => s.group === 'regulator');
  otherClaimSources = claimSources.filter((s) => s.group === 'other');

  const links = buildReportLinkCatalog({
    entityCode,
    entityDisplay: entity_display,
    reportId: id,
    reportSlug,
    siteBase: base,
  });
  ({ human: humanPages, machine: machineLinks, vercelApps, fingerprints } = links);

  const byCode = new Map<
    string,
    { slug: string; entity_display: string; live_phi: number; date_iso: string }
  >();
  for (const r of allReports) {
    const code = entityCodeFromReportId(r.data.id);
    if (code === entityCode) continue;
    const m = resolveReportMetrics(code, { phi_s: r.data.phi_s, kappa: r.data.kappa });
    const candidate = {
      slug: slugFor(r.id),
      entity_display: r.data.entity_display,
      live_phi: m.phi_s,
      date_iso: r.data.date_iso,
    };
    const prev = byCode.get(code);
    if (
      !prev ||
      candidate.live_phi > prev.live_phi ||
      (candidate.live_phi === prev.live_phi && candidate.date_iso > prev.date_iso)
    ) {
      byCode.set(code, candidate);
    }
  }
  siblings = [...byCode.values()].sort((a, b) => b.live_phi - a.live_phi).slice(0, 6);

  description = `${entity_display} field position report. Live Φ_S = ${phi_s.toFixed(4)}, κ = ${kappa.toFixed(4)}. Eigenstate Research.`;
}

const hubProps = isHub
  ? (Astro.props as {
      kind: 'hub';
      entityCode: string;
      entityDisplay: string;
      hubSlug: string;
      series: Array<{
        slug: string;
        date_iso: string;
        date_label: string;
        phi_s: number;
        kappa: number;
        vault_records: number;
      }>;
      latestSlug: string;
      latestDateIso: string;
    })
  : null;
---

{
  isHub && hubProps ? (
    <EntityHub
      entityCode={hubProps.entityCode}
      entityDisplay={hubProps.entityDisplay}
      hubSlug={hubProps.hubSlug}
      series={hubProps.series}
      latestSlug={hubProps.latestSlug}
      latestDateIso={hubProps.latestDateIso}
    />
  ) : (
<Layout title={`${entity_display} · Signal Report · Eigenstate Research`} description={description} fonts={fonts}>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      .report-hero {
        padding: 56px 40px 32px;
        border-bottom: 1px solid var(--border);
        max-width: 900px;
        margin: 0 auto;
      }

      .report-back {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal-dim);
        text-decoration: none;
        display: inline-block;
        margin-bottom: 24px;
      }

      .report-entity {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 800;
        letter-spacing: 0.03em;
        margin-bottom: 8px;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--signal);
        margin-bottom: 10px;
      }

      .report-date {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 20px;
      }

      .panel {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 18px 20px;
        margin-bottom: 16px;
        background: var(--bg-card, transparent);
      }

      .panel.live {
        border-color: rgb(47 90 99 / 35%);
        background: rgb(47 90 99 / 6%);
      }

      .panel.snapshot {
        border-color: rgb(245 158 11 / 35%);
        background: rgb(245 158 11 / 7%);
      }

      .panel-title {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 12px;
      }

      .panel-note {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.55;
        margin-top: 12px;
      }

      .metrics-row {
        display: flex;
        gap: 28px;
        flex-wrap: wrap;
      }

      .metric {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .metric-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .metric-value {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
      }

      .metric-value.cyan {
        color: var(--signal);
      }

      .metric-value.muted {
        color: var(--text-muted);
      }

      .hero-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
        margin-top: 8px;
      }

      .hero-links a {
        color: var(--signal);
        font-size: var(--text-sm);
        text-decoration: none;
      }

      .hero-links a:hover {
        text-decoration: underline;
      }

      .report-body {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 40px 24px;
        font-size: var(--text-base);
        color: var(--text-secondary);
        overflow-wrap: break-word;
      }

      .report-body :global(h1) {
        display: none;
      }

      .report-body :global(h2) {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
        margin: 40px 0 16px;
        letter-spacing: 0.02em;
      }

      .report-body :global(h3) {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 700;
        color: var(--text-primary);
        margin: 28px 0 12px;
      }

      .report-body :global(p) {
        margin-bottom: 16px;
        line-height: 1.8;
      }

      .report-body :global(strong) {
        color: var(--text-primary);
      }

      .report-body :global(a) {
        color: var(--signal);
        overflow-wrap: break-word;
      }

      .report-body :global(ul),
      .report-body :global(ol) {
        margin: 0 0 16px 20px;
      }

      .report-body :global(li) {
        margin-bottom: 6px;
      }

      .report-body :global(code) {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal);
        background: rgb(47 90 99 / 8%);
        padding: 2px 6px;
        border-radius: var(--radius-sm);
      }

      .report-body :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0 28px;
        font-size: var(--text-sm);
      }

      .report-body :global(th) {
        text-align: left;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 10px 14px;
        border-bottom: 1px solid var(--border-strong);
      }

      .report-body :global(td) {
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
      }

      .report-body :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 32px 0;
      }

      .report-body :global(em) {
        color: var(--text-muted);
      }

      .sources-panel,
      .topology-section,
      .for-agents {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 40px 40px;
      }

      .section-label {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 16px;
        border-top: 1px solid var(--border);
        padding-top: 32px;
      }

      .sources-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: var(--text-sm);
        color: var(--text-secondary);
      }

      .sources-list a {
        color: var(--signal);
      }

      .sources-group {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-top: 14px;
        margin-bottom: 2px;
      }

      .sources-group:first-child {
        margin-top: 0;
      }

      a.machine-link {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
      }

      .machine-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 12px;
      }

      .machine-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        align-items: baseline;
        font-size: var(--text-sm);
        color: var(--text-secondary);
      }

      .machine-row a {
        color: var(--signal);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        word-break: break-all;
      }

      .machine-note {
        color: var(--text-muted);
        font-size: var(--text-xs);
      }

      .fp-block {
        margin-top: 16px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.6;
      }

      .fp-block code {
        color: var(--signal);
        background: rgb(47 90 99 / 8%);
        padding: 1px 5px;
        border-radius: var(--radius-sm);
      }

      .topology-list {
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
      }

      .topology-row {
        background: var(--bg);
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-decoration: none;
        transition: background 0.2s;
      }

      .topology-row:hover {
        background: var(--bg-card);
      }

      .topology-entity {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        color: var(--text-primary);
      }

      .topology-phi {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--accent);
      }

      .for-agents details {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 12px 16px;
        color: var(--text-muted);
        font-size: var(--text-sm);
      }

      .for-agents summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .for-agents .agent-body {
        margin-top: 14px;
        color: var(--text-secondary);
      }

      .for-agents .agent-intro {
        margin-bottom: 10px;
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.55;
      }

      @media (width <= 640px) {
        .report-hero,
        .report-body,
        .sources-panel,
        .topology-section,
        .for-agents {
          padding-left: 20px;
          padding-right: 20px;
        }
      }
    </style>
  </Fragment>

  <Nav active="reports" />

  <div class="report-hero" id="main">
    <a href={`${base}reports/`} class="report-back">← All signal reports</a>
    <a href={`${base}reports/${hubSlug}/`} class="report-back" style="margin-left: 16px;">
      {entity_display} hub →
    </a>
    <div class="eyebrow">Signal report</div>
    <h1 class="report-entity">{entity_display}</h1>
    <p class="report-date">Publication date {date}</p>

    <div class="panel live">
      <div class="panel-title">Live SoT</div>
      <div class="metrics-row">
        <div class="metric">
          <div class="metric-label">Settlement pressure</div>
          <div class="metric-value">Φ_S {phi_s.toFixed(4)}</div>
        </div>
        <div class="metric">
          <div class="metric-label">Field coherence</div>
          <div class="metric-value cyan">κ {formatNum(kappa, 4)}</div>
        </div>
        {
          m1LedgerObs > 0 ? (
            <div class="metric" title="m1_strict coverage-ledger rows for this entity (engine SoT)">
              <div class="metric-label">M1 ledger obs</div>
              <div class="metric-value cyan">{m1LedgerObs}</div>
            </div>
          ) : (
            <div class="metric">
              <div class="metric-label">M1 ledger obs</div>
              <div class="metric-value muted">0</div>
            </div>
          )
        }
        <div class="metric">
          <div class="metric-label">M1 coverage (field)</div>
          <div class="metric-value cyan">{sot.coverage.headline}</div>
        </div>
      </div>
      <p class="panel-note">
        {
          using_live
            ? `Hero numbers overlay the live dossier SoT${live.compiled_at ? ` (compiled ${String(live.compiled_at).slice(0, 19)}Z)` : ''}. This is current engine state, not the prose below.`
            : `No live dossier mirror for ${entityCode}. Showing publish-time frontmatter for Φ_S / κ.`
        }
      </p>
      <div class="hero-links">
        <a href={humanDossier}>Entity dossier</a>
        <a href={glossary}>Numbers glossary</a>
        <a href={methodology}>Methodology</a>
        <a href={verifyWalkthrough}>Verify walkthrough</a>
      </div>
    </div>

    <div class="panel snapshot">
      <div class="panel-title">Publication snapshot · {date_iso}</div>
      <div class="metrics-row">
        <div class="metric">
          <div class="metric-label">Φ_S at publish</div>
          <div class="metric-value muted">{publish_phi_s.toFixed(4)}</div>
        </div>
        <div class="metric">
          <div class="metric-label">κ at publish</div>
          <div class="metric-value muted">{formatNum(publish_kappa, 4)}</div>
        </div>
        <div class="metric" title="Trimmed cycle-vault rows at report publish. Not lifetime M1 observations.">
          <div class="metric-label">vault@publish</div>
          <div class="metric-value muted">{vault_records}</div>
        </div>
      </div>
      <p class="panel-note">
        Dated research snapshot. Prose below describes publication-time observation.
        vault@publish counts trimmed cycle-vault rows at publish time. It is not the live M1 ledger
        ({m1LedgerObs} obs for {entityCode}; field coverage {sot.coverage.headline}).
        Do not read vault@publish = 0 as "no measurements exist" when M1 ledger obs is non-zero.
      </p>
    </div>
  </div>

  <div class="report-body" set:html={articleHtml} />

  <div class="sources-panel">
    <div class="section-label">Sources &amp; human pages</div>
    <div class="sources-list">
      {
        issuerSources.length > 0 && (
          <>
            <div class="sources-group">Issuer / primary pages</div>
            {issuerSources.map((s) => (
              <div>
                <a href={s.href}>{s.label}</a>
              </div>
            ))}
          </>
        )
      }
      {
        regulatorSources.length > 0 && (
          <>
            <div class="sources-group">SEC / EDGAR / regulator</div>
            {regulatorSources.map((s) => (
              <div>
                <a href={s.href}>{s.label}</a>
              </div>
            ))}
          </>
        )
      }
      {
        otherClaimSources.length > 0 && (
          <>
            <div class="sources-group">Other cited pages</div>
            {otherClaimSources.map((s) => (
              <div>
                <a href={s.href}>{s.label}</a>
              </div>
            ))}
          </>
        )
      }
      <div class="sources-group">Eigenstate Pages &amp; federation surfaces</div>
      {
        humanPages.map((s) => (
          <div>
            <a href={s.href}>{s.label}</a>
            {s.note ? <> · {s.note}</> : null}
          </div>
        ))
      }
    </div>
  </div>

  <div class="topology-section">
    <div class="section-label">Related entities · by settlement pressure</div>
    <div class="topology-list bracket">
      {
        siblings.map((s) => (
          <a href={`${base}reports/${s.slug}/`} class="topology-row">
            <span class="topology-entity">{s.entity_display}</span>
            <span class="topology-phi">Φ_S {s.live_phi.toFixed(3)}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="for-agents">
    <div class="section-label">For agents</div>
    <details>
      <summary>APIs · Vercel apps · federation traverse · Node {fingerprints.node_id} (collapsed)</summary>
      <div class="agent-body">
        <p class="agent-intro">
          Cold-agent entry for Node <code>{fingerprints.node_id}</code> / <code>{entityCode}</code>.
          Prefer human pages above first. Traverse: agent entry → manifest → entity feed → dossier →
          chain verify → canonical report. Walkthrough:{' '}
          <a href={verifyWalkthrough}>verify-walkthrough</a>.
        </p>

        <div class="sources-group">Machine JSON &amp; federation APIs</div>
        <div class="machine-list">
          {
            machineLinks.map((s) => (
              <div class="machine-row">
                <a href={s.href}>{s.label}</a>
                {s.note ? <span class="machine-note">· {s.note}</span> : null}
              </div>
            ))
          }
        </div>

        <div class="sources-group" style="margin-top: 16px;">Vercel apps</div>
        <div class="machine-list">
          {
            vercelApps.map((s) => (
              <div class="machine-row">
                <a href={s.href}>{s.label}</a>
                {s.feed_url && s.feed_url !== s.href ? (
                  <a class="machine-link" href={s.feed_url}>
                    feed
                  </a>
                ) : null}
                {s.federation_card && s.federation_card !== s.href ? (
                  <a class="machine-link" href={s.federation_card}>
                    federation card
                  </a>
                ) : null}
                {s.note ? <span class="machine-note">· {s.note}</span> : null}
              </div>
            ))
          }
        </div>

        <div class="fp-block">
          <div>
            <strong>entity:</strong> <code>{entityCode}</code>
            {' · '}
            <strong>report_id:</strong> <code>{id}</code>
          </div>
          {
            fingerprints.chain_hash ? (
              <div>
                <strong>Build fingerprint:</strong>{' '}
                <code>{fingerprints.chain_hash.slice(0, 16)}…</code> (match{' '}
                <code>builds[].chain_hash</code> for <code>{entityCode}</code> in api/manifest, then
                verify via api/chain)
              </div>
            ) : null
          }
          {
            fingerprints.granth_head ? (
              <div>
                <strong>Granth head:</strong> <code>{fingerprints.granth_head.slice(0, 16)}…</code> ·
                length {fingerprints.granth_length}
              </div>
            ) : null
          }
          <div style="margin-top: 8px;">
            <strong>Verify:</strong> GET api/manifest → find <code>builds[].target==entity</code> →
            match chain_hash → GET api/chain.
          </div>
        </div>
      </div>
    </details>
  </div>

  <Footer variant="full" />
</Layout>
  )
}
