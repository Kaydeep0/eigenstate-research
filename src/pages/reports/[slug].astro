---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { slugFor } from '../../lib/reports';
import { loadSot, entityCodeFromReportId, resolveReportMetrics, formatNum } from '../../lib/sot';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: slugFor(entry.id) },
    props: { entry, allReports: reports },
  }));
}

const { entry, allReports } = Astro.props;
const { Content } = await render(entry);
const { entity_display, date, date_iso, phi_s: publishPhi, kappa: publishKap, vault_records, id } = entry.data;
const sot = loadSot();
const entityCode = entityCodeFromReportId(id);
const metrics = resolveReportMetrics(entityCode, { phi_s: publishPhi, kappa: publishKap });
const { phi_s, kappa, using_live, live, publish_phi_s, publish_kappa } = metrics;
const m1LedgerObs = (sot.entity_m1_obs_counts || {})[entityCode] ?? 0;
const vaultTip = 'Cycle vault rows at publish (trimmed); not M1 lifetime observations';
const fedDossierUrl = `https://geniusflow-federation.vercel.app/api/dossier?entity=${encodeURIComponent(entityCode)}`;

const siblings = allReports
  .filter((r) => r.id !== entry.id)
  .map((r) => {
    const code = entityCodeFromReportId(r.data.id);
    const m = resolveReportMetrics(code, { phi_s: r.data.phi_s, kappa: r.data.kappa });
    return { ...r, slug: slugFor(r.id), live_phi: m.phi_s };
  })
  .sort((a, b) => b.live_phi - a.live_phi)
  .slice(0, 6);

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const description = `${entity_display} — settlement pressure Φ_S = ${phi_s.toFixed(4)}, coherence κ = ${kappa.toFixed(4)}. Topology signal report from Eigenstate Research.`;
---

<Layout title={`${entity_display} — Signal Report — Eigenstate Research`} description={description} fonts={fonts}>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      .report-hero {
        padding: 56px 40px 40px;
        border-bottom: 1px solid var(--border);
        max-width: 900px;
        margin: 0 auto;
      }

      .report-back {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal-dim);
        text-decoration: none;
        display: inline-block;
        margin-bottom: 24px;
      }

      .report-entity {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 800;
        letter-spacing: 0.03em;
        margin-bottom: 8px;
      }

      .report-date {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 28px;
      }

      .snapshot-notice {
        max-width: 820px;
        margin: 0 auto 32px;
        padding: 14px 16px;
        border: 1px solid rgb(245 158 11 / 45%);
        border-left: 3px solid var(--status-warning);
        background: rgb(245 158 11 / 8%);
        color: var(--text-secondary);
        font-size: var(--text-sm);
        line-height: 1.6;
      }

      .snapshot-notice strong {
        color: var(--text-primary);
      }

      .metrics-row {
        display: flex;
        gap: 32px;
        flex-wrap: wrap;
      }

      .metric {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .metric-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .metric-value {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
      }

      .metric-value.cyan {
        color: var(--signal);
      }

      .metric-value.green {
        color: var(--status-success);
      }

      .report-body {
        max-width: 900px;
        margin: 0 auto;
        padding: 48px 40px;
        font-size: var(--text-base);
        color: var(--text-secondary);
        overflow-wrap: break-word;
      }

      .report-body :global(h1) {
        display: none;
      }

      .report-body :global(h2) {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
        margin: 40px 0 16px;
        letter-spacing: 0.02em;
      }

      .report-body :global(h3) {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 700;
        color: var(--text-primary);
        margin: 28px 0 12px;
      }

      .report-body :global(p) {
        margin-bottom: 16px;
        line-height: 1.8;
      }

      .report-body :global(strong) {
        color: var(--text-primary);
      }

      .report-body :global(a) {
        color: var(--signal);
        overflow-wrap: break-word;
      }

      .report-body :global(ul),
      .report-body :global(ol) {
        margin: 0 0 16px 20px;
      }

      .report-body :global(li) {
        margin-bottom: 6px;
      }

      .report-body :global(code) {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal);
        background: rgb(47 90 99 / 8%);
        padding: 2px 6px;
        border-radius: var(--radius-sm);
      }

      .report-body :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0 28px;
        font-size: var(--text-sm);
      }

      .report-body :global(th) {
        text-align: left;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 10px 14px;
        border-bottom: 1px solid var(--border-strong);
      }

      .report-body :global(td) {
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
      }

      .report-body :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 32px 0;
      }

      .report-body :global(em) {
        color: var(--text-muted);
      }

      .topology-section {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 40px 64px;
      }

      .topology-title {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 20px;
        border-top: 1px solid var(--border);
        padding-top: 32px;
      }

      .topology-list {
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
      }

      .topology-row {
        background: var(--bg);
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-decoration: none;
        transition: background 0.2s;
      }

      .topology-row:hover {
        background: var(--bg-card);
      }

      .topology-entity {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        color: var(--text-primary);
      }

      .topology-phi {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--accent);
      }

      @media (width <= 640px) {
        .report-hero,
        .report-body,
        .topology-section {
          padding-left: 20px;
          padding-right: 20px;
        }
      }
    </style>
  </Fragment>

  <Nav active="reports" />

  <div class="report-hero" id="main">
    <a href={`${import.meta.env.BASE_URL}reports/`} class="report-back">← All signal reports</a>
    <h1 class="report-entity">{entity_display}</h1>
    <p class="report-date">{date}</p>
    <div class="metrics-row">
      <div class="metric">
        <div class="metric-label">Settlement Pressure {using_live ? '(live)' : '(publish)'}</div>
        <div class="metric-value">Φ_S {phi_s.toFixed(4)}</div>
      </div>
      <div class="metric">
        <div class="metric-label">Field Coherence {using_live ? '(live)' : '(publish)'}</div>
        <div class="metric-value cyan">κ {formatNum(kappa, 4)}</div>
      </div>
      <div class="metric" title={vaultTip}>
        <div class="metric-label">vault@publish</div>
        <div class="metric-value green">{vault_records}</div>
      </div>
      {
        m1LedgerObs > 0 && (
          <div class="metric" title="m1_strict coverage-ledger rows for this entity (engine SoT)">
            <div class="metric-label">M1 ledger obs</div>
            <div class="metric-value cyan">{m1LedgerObs}</div>
          </div>
        )
      }
    </div>
    <p class="report-date" style="margin-top: 16px; max-width: 640px; line-height: 1.5;">
      {
        using_live
          ? `Hero Φ_S / κ overlay live dossier SoT${live.compiled_at ? ` (compiled ${(live.compiled_at || '').slice(0, 19)}Z)` : ''}. Publish snapshot ${date_iso}: Φ_S ${publish_phi_s.toFixed(4)}, κ ${formatNum(publish_kappa, 4)}.`
          : `No live dossier mirror for ${entityCode} — showing publish-time frontmatter.`
      }
      {' '}
      vault@publish = trimmed cycle-vault rows at report publish — not lifetime M1 observations
      (SoT coverage {sot.coverage.headline}).
      <a href={fedDossierUrl} style="color: var(--signal);"> Federation dossier</a>
      {' · '}
      <a href={`${import.meta.env.BASE_URL}METHODOLOGY.md`} style="color: var(--signal);">Methodology</a>.
    </p>
  </div>

  <div class="report-body">
    <aside class="snapshot-notice" aria-label="Report snapshot notice">
      <strong>Dated research snapshot — {date_iso}.</strong>
      Prose and links below describe publication-time observation.
      Hero Φ_S / κ prefer the live engine dossier mirror when synced; re-check cited evidence before treating claims as present state.
    </aside>
    <Content />
  </div>

  <div class="topology-section">
    <div class="topology-title">Other tracked entities · by settlement pressure</div>
    <div class="topology-list bracket">
      {
        siblings.map((s) => (
          <a href={`${import.meta.env.BASE_URL}reports/${s.slug}/`} class="topology-row">
            <span class="topology-entity">{s.data.entity_display}</span>
            <span class="topology-phi">Φ_S {s.live_phi.toFixed(3)}</span>
          </a>
        ))
      }
    </div>
  </div>

  <Footer variant="full" />
</Layout>
