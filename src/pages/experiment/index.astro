---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import ResearchSurfaces from '../../components/ResearchSurfaces.astro';
import circle from '../../data/circle-state.json';
import { webpageJsonLd } from '../../lib/siteSeo';

const fonts =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap';
const base = import.meta.env.BASE_URL;
const board = circle.experiment || {};
const st = board.current_status || {};
---
<Layout title="The experiment · Eigenstate Research" description="No result until a prospective, identity-comparable change exists." fonts={fonts}>
  <Fragment slot="head">
    <JsonLd
      data={webpageJsonLd({
        name: 'The CIRCLE experiment',
        description: 'No result until a prospective, identity-comparable change exists.',
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        creator: 'geniusflow',
        about: 'CIRCLE',
      })}
    />
  </Fragment>
  <Nav active="state" />
  <main class="wrap">
    <p class="kicker">The experiment</p>
    <h1>Does maintaining information through time help a machine decide where to look next?</h1>
    <ResearchSurfaces current="experiment" />
    <p class="navline">
      <a href={`${base}state/`}>State</a>
      <a href={`${base}changes/`}>Change frontier</a>
      <a href={`${base}experiment/`}>Experiment</a>
      <a href={`${base}methodology/`}>Methodology</a>
    </p>
    <pre>{`Evidence             ${st.evidence}
Relationships        ${st.relationships}
Maintained state     ${st.maintained_state}
Prospective clock    ${st.prospective_clock}

Comparable change    ${st.comparable_change}
Attention test       ${st.attention_test}
Result               ${st.result}`}</pre>
    <h2>When a comparable later state exists</h2>
    <pre>{(board.when_t1_exists_compare_against || []).join('\n')}</pre>
    <p class="note">{(board.notes && board.notes.result) || ''}</p>
  </main>
  <Footer />
</Layout>
<style>
  .wrap { max-width: 820px; margin: 0 auto; padding: 48px 24px 80px; }
  .kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); }
  h1 { font-family: var(--font-heading); font-size: clamp(28px, 4vw, 40px); margin: 8px 0 18px; line-height: 1.15; max-width: 22ch; }
  h2 { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); margin: 28px 0 8px; }
  .note { color: var(--text-secondary); max-width: 62ch; line-height: 1.55; }
  .navline a { margin-right: 14px; color: var(--signal-dim); }
  pre { background: var(--bg2); border: 1px solid var(--border); padding: 16px; overflow: auto; font-family: var(--font-mono); font-size: 13px; }
</style>
