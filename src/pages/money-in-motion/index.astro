---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MimSubscribe from '../../components/MimSubscribe.astro';
import JsonLd from '../../components/JsonLd.astro';
import { MIM_AUTHOR } from '../../lib/mim';
import { mimLandingJsonLd } from '../../lib/mimSeo';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const pieces = (await getCollection('money-in-motion')).sort((a, b) =>
  b.data.date_iso.localeCompare(a.data.date_iso)
);
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout
  title="Money in Motion · Eigenstate Research"
  description={`Research and writing by ${MIM_AUTHOR.name}`}
  fonts={fonts}
>
  <Fragment slot="head">
    <JsonLd data={mimLandingJsonLd(canonicalURL)} />
    <style>
      .page-hero {
        padding: 64px 40px 36px;
        border-bottom: 1px solid var(--border);
        background: var(--bg2);
      }
      .container {
        max-width: 820px;
        margin: 0 auto;
        padding: 40px 40px 80px;
      }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }
      .page-title {
        font-family: var(--font-heading);
        font-size: clamp(24px, 3vw, 36px);
        font-weight: 800;
        letter-spacing: 0.04em;
        margin-bottom: 12px;
      }
      .page-sub {
        color: var(--text-secondary);
        max-width: 58ch;
        margin-bottom: 16px;
      }
      .author-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.06em;
      }
      .author-row a {
        color: var(--signal);
        text-decoration: none;
      }
      .author-row a:hover {
        text-decoration: underline;
      }
      .list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .item {
        padding: 28px 0;
        border-bottom: 1px solid var(--border);
      }
      .item a {
        text-decoration: none;
        color: inherit;
      }
      .item-meta {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-secondary);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .item-title {
        font-family: var(--font-heading);
        font-size: 22px;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 8px;
      }
      .item-title:hover {
        color: var(--signal);
      }
      .item-ext {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--signal);
        letter-spacing: 0.04em;
      }
      .empty {
        color: var(--text-secondary);
        padding: 40px 0;
      }
    </style>
  </Fragment>

  <Nav active="money-in-motion" />

  <header class="page-hero">
    <div class="container" style="padding-top: 0; padding-bottom: 0;">
      <p class="eyebrow">Money in Motion</p>
      <h1 class="page-title">Money in Motion</h1>
      <p class="page-sub">Research and writing by {MIM_AUTHOR.name}</p>
      <div class="author-row">
        <MimSubscribe />
      </div>
    </div>
  </header>

  <main class="container" id="main">
    {
      pieces.length === 0 ? (
        <p class="empty">No Money in Motion pieces published yet.</p>
      ) : (
        <ul class="list">
          {pieces.map((p) => (
            <li class="item">
              {p.data.eigenstate_body ? (
                <a href={`${base}money-in-motion/${p.slug}/`}>
                  <p class="item-meta">
                    <time datetime={p.data.date_iso}>{p.data.date}</time>
                    {p.data.series
                      ? ` · ${p.data.series.name} · Part ${p.data.series.part}`
                      : ''}
                  </p>
                  <h2 class="item-title">{p.data.title}</h2>
                </a>
              ) : (
                <a href={p.data.linkedin_url} target="_blank" rel="noopener noreferrer">
                  <p class="item-meta">
                    <time datetime={p.data.date_iso}>{p.data.date}</time>
                  </p>
                  <h2 class="item-title">{p.data.title}</h2>
                  <p class="item-ext">Read on LinkedIn ↗</p>
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </main>

  <Footer />
</Layout>
