---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const pieces = (await getCollection('money-in-motion')).sort((a, b) =>
  b.data.date_iso.localeCompare(a.data.date_iso)
);
---

<Layout
  title="Money in Motion · Eigenstate Research"
  description="Narrative spines: current events, fee paths, and cash-flow maps. Separate from signal reports."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .page-hero {
        padding: 64px 40px 36px;
        border-bottom: 1px solid var(--border);
        background: var(--bg2);
      }
      .container {
        max-width: 820px;
        margin: 0 auto;
        padding: 40px 40px 80px;
      }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }
      .page-title {
        font-family: var(--font-heading);
        font-size: clamp(24px, 3vw, 36px);
        font-weight: 800;
        letter-spacing: 0.04em;
        margin-bottom: 12px;
      }
      .page-sub {
        color: var(--text-secondary);
        max-width: 58ch;
        margin-bottom: 8px;
      }
      .list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .item {
        padding: 28px 0;
        border-bottom: 1px solid var(--border);
      }
      .item a {
        text-decoration: none;
        color: inherit;
      }
      .item-meta {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-secondary);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .item-title {
        font-family: var(--font-heading);
        font-size: 22px;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 8px;
      }
      .item-title:hover {
        color: var(--signal);
      }
      .empty {
        color: var(--text-secondary);
        padding: 40px 0;
      }
    </style>
  </Fragment>

  <Nav active="money-in-motion" />

  <header class="page-hero">
    <div class="container" style="padding-top: 0; padding-bottom: 0;">
      <p class="eyebrow">Audience narratives</p>
      <h1 class="page-title">Money in Motion</h1>
      <p class="page-sub">
        Fee-path and cash-flow narratives for a public audience. Separate from measurement
        signal reports. Same locked story craft as the LinkedIn cut.
      </p>
    </div>
  </header>

  <main class="container">
    {
      pieces.length === 0 ? (
        <p class="empty">No Money in Motion pieces published yet.</p>
      ) : (
        <ul class="list">
          {pieces.map((p) => (
            <li class="item">
              <a href={`${base}money-in-motion/${p.slug}/`}>
                <p class="item-meta">
                  {p.data.entity_display} · {p.data.date}
                </p>
                <h2 class="item-title">{p.data.title}</h2>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>

  <Footer />
</Layout>
