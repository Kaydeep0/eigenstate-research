---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import probe from '../../data/erc8004_probe.json';
import { ledgerDeltaLine } from '../../lib/ledgerContext';
import { datasetJsonLd, dateOnly } from '../../lib/siteSeo';
import fs from 'node:fs';
import path from 'node:path';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;
const eip = 'https://eips.ethereum.org/EIPS/eip-8004';

interface Probe {
  generated_at: string;
  digest: string;
  chain: {
    caip2: string;
    identity_registry: string;
    pinned_block: number;
    pinned_block_hash: string;
  };
  population_at_pinned_block: number;
  sampled: number;
  no_agent_uri_rate: number;
  no_agent_uri_rate_ci95: [number, number];
  must_miss_rate: number;
  must_miss_rate_ci95: [number, number];
  full_miss_rate: number;
  refuse_limb_counts: Record<string, number>;
  top_refuse_reasons: Record<string, number>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  methodology: {
    limb_order_frozen: string[];
    limb_spec_level: Record<string, string>;
    known_limits: string[];
  };
}

type Receipt = {
  agent_id: number;
  agent_uri?: string;
  must_admit: boolean;
  full_admit: boolean;
  refuse_limb: string | null;
  attribution?: string | null;
};

const p = probe as unknown as Probe;
const pct = (x: number) => `${(100 * x).toFixed(1)}%`;
const ci = (r: [number, number]) => `${(100 * r[0]).toFixed(1)} to ${(100 * r[1]).toFixed(1)}%`;
const num = (n: number) => n.toLocaleString('en-US');

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

let receipts: Receipt[] = [];
try {
  const raw = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'public', 'erc8004', 'ledger.json'), 'utf8')
  ) as { receipts?: Receipt[] };
  receipts = [...(raw.receipts || [])].sort((a, b) => {
    if (a.must_admit !== b.must_admit) return a.must_admit ? 1 : -1;
    return Number(a.agent_id) - Number(b.agent_id);
  });
} catch {
  receipts = [];
}

const delta = ledgerDeltaLine('erc8004', 'must_miss_rate');
const refuseRows = Object.entries(p.refuse_limb_counts).sort((a, b) => b[1] - a[1]);
const reasonRows = Object.entries(p.top_refuse_reasons).slice(0, 8);
const limbs = p.methodology.limb_order_frozen;
const mustAdmitRate = pct(1 - p.must_miss_rate);
const priorArt = {
  xiong: 'https://arxiv.org/abs/2606.26028',
  mafrur: 'https://arxiv.org/abs/2606.12128',
};
---

<Layout
  title="ERC-8004 refusal ledger · Eigenstate Research"
  description="Read-only conformance probe over the ERC-8004 Identity Registry on Base. What share of registered agents resolve to nothing, named limb by limb. Not a reputation score."
  fonts={fonts}
>
  <Fragment slot="head">
    <JsonLd
      data={datasetJsonLd({
        name: 'ERC-8004 refusal ledger',
        description:
          'Read-only conformance probe over the ERC-8004 Identity Registry on Base. Named limb refusals for the sampled population at the pinned block. Not a reputation score.',
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        datePublished: dateOnly(p.generated_at),
        creator: 'geniusflow',
        about: 'ERC-8004 Identity Registry on Base',
      })}
    />
  </Fragment>
  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="rank-hero" id="main">
    <div class="eyebrow">ERC-8004 · Base · read-only · ranked sample</div>
    <h1>ERC-8004 refusal ledger</h1>
    <p class="lede">
      Uniform sample of the Base Identity Registry: named refusal limb per agent, redrawable from
      the pinned block hash. Measurement of registration quality, not a reputation score.
    </p>
    <div class="rank-primary">
      <div class="rate">{pct(p.must_miss_rate)}</div>
      <div class="rate-label">
        MUST miss rate · {p.sampled} of {num(p.population_at_pinned_block)} sampled · 95% CI{' '}
        {ci(p.must_miss_rate_ci95)}
      </div>
    </div>
    {delta && <p class="rank-delta">{delta}</p>}
  </div>

  <section class="rank-wrap">
    <div class="rank-runline">
      Registry <code>{p.chain.identity_registry}</code> on <code>{p.chain.caip2}</code> · pinned
      block <code>{num(p.chain.pinned_block)}</code> · run {formatDate(p.generated_at)} · digest{' '}
      <code>{p.digest.slice(0, 16)}</code>
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th class="n">Agent</th>
            <th>Verdict</th>
            <th>Refuse limb</th>
            <th>Attribution</th>
            <th>Receipt</th>
          </tr>
        </thead>
        <tbody>
          {
            receipts.map((r) => (
              <tr>
                <td class="n subject">{r.agent_id}</td>
                <td class:list={['verdict', r.must_admit ? 'is-admit' : 'is-refuse']}>
                  {r.must_admit ? 'admit' : 'refuse'}
                </td>
                <td>{r.refuse_limb ?? 'no refuse'}</td>
                <td>{r.attribution ?? 'n/a'}</td>
                <td>
                  <a href={`${fed}/erc8004/receipts/${r.agent_id}.json`} rel="noopener">
                    json
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); margin: 8px 0 10px;">
      Where they fail first
    </h2>
    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr><th>First failing limb</th><th class="n">Agents</th></tr>
        </thead>
        <tbody>
          {
            refuseRows.map(([limb, n]) => (
              <tr>
                <td>{limb}</td>
                <td class="n">{n}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="rank-footer">
      <p class="honesty">
        Not a reputation score · no agent contacted beyond a plain GET of a URL it published itself
        · sample redrawable from public block hash only
      </p>

      <h2>How to cite / redraw</h2>
      <p>
        Cite the human page or <a href={`${base}erc8004/summary.json`}>summary.json</a>. Overturn
        one agent: <code>{fed}/erc8004/receipts/&lt;agentId&gt;.json</code>
      </p>
      <pre class="cmd">{`random.Random(int(pinned_block_hash[-16:], 16)).sample(range(1, N + 1), ${p.sampled})`}</pre>

      <h2>Secondary rates</h2>
      <p>
        No agentURI {pct(p.no_agent_uri_rate)} (CI {ci(p.no_agent_uri_rate_ci95)}) · full miss{' '}
        {pct(p.full_miss_rate)} · MUST admit {mustAdmitRate}
      </p>

      <h2>Named reasons</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Limb and reason</th><th class="n">Agents</th></tr>
          </thead>
          <tbody>
            {
              reasonRows.map(([reason, n]) => (
                <tr>
                  <td>{reason}</td>
                  <td class="n">{n}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Every limb</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Limb</th>
              <th>Spec</th>
              <th class="n">ok</th>
              <th class="n">fail</th>
              <th class="n">n/a</th>
              <th class="n">absent</th>
              <th class="n">not reached</th>
            </tr>
          </thead>
          <tbody>
            {
              limbs.map((limb) => (
                <tr>
                  <td>{limb}</td>
                  <td>{p.methodology.limb_spec_level[limb]}</td>
                  <td class="n">{p.limb_outcomes[limb].ok}</td>
                  <td class="n">{p.limb_outcomes[limb].fail}</td>
                  <td class="n">{p.limb_outcomes[limb].not_applicable}</td>
                  <td class="n">{p.limb_outcomes[limb].absent}</td>
                  <td class="n">{p.limb_outcomes[limb].not_reached}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Prior art</h2>
      <p>
        Xiong et al., <a href={priorArt.xiong} target="_blank" rel="noopener">Can Trustless Agents Be
        Trusted?</a> and Mafrur and Khusumanegara,{' '}
        <a href={priorArt.mafrur} target="_blank" rel="noopener">From Agent Identity to Agent Economy</a
        >, report the same shape on earlier crawls. This sample adds redrawable ids and named limbs.
      </p>

      <h2>Machine readable</h2>
      <div class="links-row">
        <a href={`${base}erc8004/summary.json`}>summary.json</a>
        <a href={`${base}erc8004/ledger.json`}>ledger.json</a>
        <a href={`${base}erc8004/README.md`}>method</a>
        <a href={`${fed}/erc8004/index.json`} target="_blank" rel="noopener">per-agent index</a>
        <a href={eip} target="_blank" rel="noopener">EIP-8004</a>
      </div>
      <pre class="cmd">{`curl -sS ${fed}/erc8004/receipts/86.json | jq '{agent_id, refuse_limb, limbs}'`}</pre>

      <h2>What this cannot tell you</h2>
      <ul>
        {p.methodology.known_limits.map((l) => <li>{l}</li>)}
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
