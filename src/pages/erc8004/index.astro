---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import probe from '../../data/erc8004_probe.json';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;
const eip = 'https://eips.ethereum.org/EIPS/eip-8004';

interface Probe {
  generated_at: string;
  digest: string;
  chain: {
    caip2: string;
    identity_registry: string;
    agent_registry_caip10: string;
    pinned_block: number;
    pinned_block_hash: string;
  };
  population_at_pinned_block: number;
  sampled: number;
  no_agent_uri_rate: number;
  no_agent_uri_rate_ci95: [number, number];
  unresolvable_rate: number;
  unresolvable_rate_ci95: [number, number];
  must_miss_rate: number;
  must_miss_rate_ci95: [number, number];
  full_miss_rate: number;
  full_miss_rate_ci95: [number, number];
  refuse_limb_counts: Record<string, number>;
  top_refuse_reasons: Record<string, number>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  methodology: {
    limb_order_frozen: string[];
    limb_spec_level: Record<string, string>;
    known_limits: string[];
  };
}

const p = probe as unknown as Probe;

const pct = (x: number) => `${(100 * x).toFixed(1)}%`;
const ci = (r: [number, number]) => `${(100 * r[0]).toFixed(1)} to ${(100 * r[1]).toFixed(1)}%`;
const num = (n: number) => n.toLocaleString('en-US');

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const headlines = [
  {
    value: pct(p.no_agent_uri_rate),
    ci: ci(p.no_agent_uri_rate_ci95),
    label: 'hold an identity with no agentURI at all',
    note: 'The registry returns an empty string. There is no file to fetch and nothing to dispute.',
  },
  {
    value: pct(p.unresolvable_rate),
    ci: ci(p.unresolvable_rate_ci95),
    label: 'did not dereference to any body',
    note: 'The empty ones above, plus dead hosts, 404s, and agentURIs that are not URIs.',
  },
  {
    value: pct(p.must_miss_rate),
    ci: ci(p.must_miss_rate_ci95),
    label: 'fail a limb the ERC states as MUST',
    note: 'The URI did not resolve, the body was not JSON, or it never declared the registration type.',
  },
  {
    value: pct(p.full_miss_rate),
    ci: ci(p.full_miss_rate_ci95),
    label: 'also miss self-reference or endpoint liveness',
    note: 'The file does not point back at its own agentId, or no declared endpoint answered today.',
  },
];

const refuseRows = Object.entries(p.refuse_limb_counts).sort((a, b) => b[1] - a[1]);
const reasonRows = Object.entries(p.top_refuse_reasons).slice(0, 8);
const limbs = p.methodology.limb_order_frozen;

/* Prior art comparison. Both figures are derived from the same probe file rather
   than typed in, so they cannot drift from the tables below on a re-run. */
const mustAdmitRate = pct(1 - p.must_miss_rate);
const priorArt = {
  xiong: 'https://arxiv.org/abs/2606.26028',
  mafrur: 'https://arxiv.org/abs/2606.12128',
};
---

<Layout
  title="ERC-8004 refusal ledger — Eigenstate Research"
  description="Read-only conformance probe over the ERC-8004 Identity Registry on Base. What share of registered agents resolve to nothing, named limb by limb. Not a reputation score."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .page-hero {
        max-width: 820px;
        margin: 0 auto;
        padding: 72px 24px 20px;
        text-align: center;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.15em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .page-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        line-height: 1.15;
        margin: 0 0 16px;
      }

      .page-hero .grad {
        background: linear-gradient(135deg, var(--signal) 0%, var(--accent) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .explainer {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 auto 12px;
        max-width: 640px;
      }

      .honesty {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0 auto;
        max-width: 640px;
      }

      .wrap {
        max-width: 880px;
        margin: 0 auto;
        padding: 8px 24px 80px;
      }

      .runline {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.8;
        padding: 14px 16px;
        background: var(--bg2);
        border-left: 3px solid var(--border-live);
        margin: 20px 0 32px;
        overflow-wrap: anywhere;
      }

      .cite-box {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.75;
        padding: 14px 16px;
        background: var(--bg2);
        border-left: 3px solid var(--signal-dim);
        margin: 0 0 28px;
        overflow-wrap: anywhere;
      }

      .cite-box .cite-title {
        color: var(--text-secondary);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      .cite-box a {
        color: var(--signal-dim);
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 36px;
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 20px 18px;
      }

      .card .big {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 4px;
      }

      .card .ci {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: 10px;
      }

      .card .lab {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: 8px;
      }

      .card .note {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.6;
      }

      h2 {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
        margin: 36px 0 10px;
        letter-spacing: -0.01em;
      }

      p.body {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 14px;
      }

      p.body a,
      .links-row a {
        color: var(--signal-dim);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        margin: 8px 0 18px;
      }

      th,
      td {
        text-align: left;
        padding: 9px 10px;
        border-bottom: 1px solid var(--border);
        color: var(--text-secondary);
      }

      th {
        color: var(--text-muted);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 500;
      }

      td.n {
        text-align: right;
        color: var(--text-primary);
      }

      .links-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        margin: 12px 0 8px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }

      .links-row a {
        text-decoration: none;
      }

      .links-row a:hover {
        text-decoration: underline;
      }

      pre.cmd {
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.55;
        background: #1a1a1a;
        color: #e8e6e1;
        padding: 16px 18px;
        border-radius: var(--radius-sm);
        overflow-x: auto;
        margin: 0 0 12px;
        white-space: pre;
      }

      ul.plain {
        margin: 0 0 16px 18px;
        padding: 0;
      }

      ul.plain li {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 6px;
      }

      @media (width <= 640px) {
        .page-hero {
          padding-top: 48px;
        }

        pre.cmd {
          font-size: 11px;
          padding: 14px;
        }
      }
    </style>
  </Fragment>

  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="page-hero" id="main">
    <div class="eyebrow">ERC-8004 · Base · read-only</div>
    <h1>The <span class="grad">refusal</span> ledger</h1>
    <p class="explainer">
      Published studies have already measured how few ERC-8004 registrations resolve to a working
      agent. What they report is a rate. What none of them ship is the artifact underneath it: a
      sample a stranger can redraw, a named refusal limb for every agent, and one receipt you can
      fetch by agentId. This is that, for a random sample of the Base Identity Registry.
    </p>
    <p class="honesty">
      Not a reputation score · no ranking · no agent contacted beyond a plain GET of a URL it
      published itself
    </p>
  </div>

  <section class="wrap">
    <div class="runline">
      Registry <code>{p.chain.identity_registry}</code> on <code>{p.chain.caip2}</code><br />
      Pinned block <code>{num(p.chain.pinned_block)}</code> · hash <code>{p.chain.pinned_block_hash}</code
      ><br />
      {num(p.population_at_pinned_block)} agents registered at that block · {p.sampled} sampled ·
      run {formatDate(p.generated_at)}<br />
      Ledger digest <code>{p.digest}</code>
    </div>

    <div class="cite-box">
      <div class="cite-title">How to cite / redraw</div>
      Cite the human page or{' '}
      <a href={`${base}erc8004/summary.json`}>summary.json</a>. Overturn one agent without
      arguing the aggregate:{' '}
      <code>{fed}/erc8004/receipts/&lt;agentId&gt;.json</code>
      <br />
      Redraw the same {p.sampled} ids from the pinned block hash only (nothing from this node):
      <br />
      <code
        >{`random.Random(int(pinned_block_hash[-16:], 16)).sample(range(1, N + 1), ${p.sampled})`}</code
      >
      <br />
      Seed block <code>{num(p.chain.pinned_block)}</code> · hash{' '}
      <code>{p.chain.pinned_block_hash}</code>
    </div>

    <div class="cards">
      {
        headlines.map((h) => (
          <div class="card">
            <div class="big">{h.value}</div>
            <div class="ci">95% CI {h.ci}</div>
            <div class="lab">{h.label}</div>
            <div class="note">{h.note}</div>
          </div>
        ))
      }
    </div>

    <h2>Prior art, and what this adds</h2>
    <p class="body">
      This is not the first measurement of ERC-8004 registration quality and does not claim to be.
      Xiong et al., <a href={priorArt.xiong} target="_blank" rel="noopener">Can Trustless Agents Be
      Trusted?</a> (arXiv 2606.26028), crawled the full Identity Registry population on Ethereum,
      BSC and Base through 13 May 2026 and report 37% of Base agents with no agentURI, 26.9%
      carrying a valid ERC-8004 registration file, and 15% exposing a valid file with at least one
      declared service. Mafrur and Khusumanegara, <a href={priorArt.mafrur} target="_blank" rel="noopener"
      >From Agent Identity to Agent Economy</a> (arXiv 2606.12128), reach the same shape on Ethereum
      from a different dataset: registration heavy, operationally shallow.
    </p>
    <p class="body">
      This ledger corroborates that by a different method and a later sample. Theirs is a full
      population crawl ending 13 May 2026; this is a {p.sampled} agent uniform draw from Base,
      taken in the run of {formatDate(p.generated_at).slice(0, 10)} at block {num(p.chain.pinned_block)}
      and seeded by that block's hash. Against
      their 37% of Base agents with no agentURI, this sample reads {pct(p.no_agent_uri_rate)} (95% CI
      {ci(p.no_agent_uri_rate_ci95)}). Against their 26.9% with a valid registration file, {mustAdmitRate}
      of this sample clears every limb the ERC states as MUST. Two methods, two samples, months
      apart, landing in the same place is the useful part. The agreement is the result, not the
      novelty.
    </p>
    <p class="body">
      What a published rate does not give you is the thing underneath it. The addition here is
      operational. The sample is redrawable by a third party from public data, because the seed is
      the pinned block hash and nothing else. The limb order is frozen, so a refusal names the limb
      that failed first instead of a general verdict. Every rate carries a Wilson interval. Every
      sampled agentId has a receipt carrying the exact HTTP status or transport error, so a
      disagreement is a fetch rather than an argument. A rate you can read is a claim. A receipt you
      can fetch is a claim someone else can overturn.
    </p>

    <h2>Where they fail first</h2>
    <p class="body">
      Limbs run in a frozen order and a refusal names the first one that failed, so these counts
      partition the sample rather than double-counting it.
    </p>
    <table>
      <thead>
        <tr><th>First failing limb</th><th class="n">Agents</th></tr>
      </thead>
      <tbody>
        {
          refuseRows.map(([limb, n]) => (
            <tr>
              <td>{limb}</td>
              <td class="n">{n}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>Named reasons</h2>
    <table>
      <thead>
        <tr><th>Limb and reason</th><th class="n">Agents</th></tr>
      </thead>
      <tbody>
        {
          reasonRows.map(([reason, n]) => (
            <tr>
              <td>{reason}</td>
              <td class="n">{n}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>Every limb, reported separately</h2>
    <p class="body">
      <code>absent</code> and <code>not applicable</code> never count against an agent: the ERC
      marks the endpoint-domain proof optional, and an agent that declares no HTTP endpoint cannot
      fail a liveness check. <code>not reached</code> means an earlier limb failed first, so this
      one was never observed.
    </p>
    <table>
      <thead>
        <tr>
          <th>Limb</th>
          <th>Spec</th>
          <th class="n">ok</th>
          <th class="n">fail</th>
          <th class="n">n/a</th>
          <th class="n">absent</th>
          <th class="n">not reached</th>
        </tr>
      </thead>
      <tbody>
        {
          limbs.map((limb) => (
            <tr>
              <td>{limb}</td>
              <td>{p.methodology.limb_spec_level[limb]}</td>
              <td class="n">{p.limb_outcomes[limb].ok}</td>
              <td class="n">{p.limb_outcomes[limb].fail}</td>
              <td class="n">{p.limb_outcomes[limb].not_applicable}</td>
              <td class="n">{p.limb_outcomes[limb].absent}</td>
              <td class="n">{p.limb_outcomes[limb].not_reached}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>Read it yourself</h2>
    <div class="links-row">
      <a href={`${base}erc8004/summary.json`}>summary.json</a>
      <a href={`${base}erc8004/ledger.json`}>ledger.json (every receipt)</a>
      <a href={`${base}erc8004/README.md`}>method, in prose</a>
      <a href={`${fed}/erc8004/index.json`} target="_blank" rel="noopener">per-agent index</a>
      <a href={eip} target="_blank" rel="noopener">EIP-8004</a>
    </div>
    <p class="body">
      One agent's receipt, by agentId, from the federation origin:
    </p>
    <pre class="cmd">{`curl -sS ${fed}/erc8004/receipts/1.json | jq '{agent_id, refuse_limb, limbs}'`}</pre>

    <h2>How the sample was drawn</h2>
    <p class="body">
      The registry is an ERC-721 with no Enumerable extension and no burn path, so agentIds run
      contiguously from 1 and the population size is found by binary search on <code>ownerOf</code>
      at a pinned block. The sample is uniform without replacement, seeded by that block's hash, so
      a third party redraws the identical id set from public data with no input from this node.
    </p>
    <pre class="cmd">{`random.Random(int(pinned_block_hash[-16:], 16)).sample(range(1, N + 1), ${p.sampled})`}</pre>

    <h2>What this cannot tell you</h2>
    <ul class="plain">
      {p.methodology.known_limits.map((l) => <li>{l}</li>)}
      <li>
        This node holds no ERC-8004 agentId of its own and says so in its own registration file, so
        it is not in its own sample.
      </li>
    </ul>
  </section>

  <Footer />
</Layout>
