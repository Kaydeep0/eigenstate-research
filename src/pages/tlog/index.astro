---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import batch from '../../data/tlog_monitor.json';
import { ledgerDeltaLine } from '../../lib/ledgerContext';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;

interface Batch {
  generated_at: string;
  digest: string;
  expectations_digest: string;
  expectations_generated_at: string;
  probe_version: string;
  role: {
    this_node_is: string;
    this_node_is_not: string;
    what_a_batch_monitor_cannot_do: string[];
  };
  subject: { what: string; engine_commit: string };
  second_read_gap_seconds: number;
  verifiers_implemented_here: { why: string; discipline: string; what_a_failure_means: string };
  verifier_selftests: Record<string, Record<string, unknown>>;
  verifier_selftests_all_passed: boolean;
  checkpoints_appended_this_batch: number;
  logs_in_population: number;
  must_admit: number;
  must_refuse: number;
  full_admit: number;
  signatures_verified: number;
  trees_advanced_between_reads: number;
  entries_added_between_reads: number;
  consistency_proofs_served: number;
  consistency_proofs_recomputed: number;
  checkpoints_with_witness_cosignatures: number;
  logs_with_a_prior_batch_on_record: number;
  disagreement_count: number;
  refuse_limb_counts: Record<string, number>;
  refusal_attribution: Record<string, number>;
  operators: Record<string, number>;
  checkpoint_formats: Record<string, number>;
  limb_order_frozen: string[];
  limb_chains: Record<string, string[]>;
  limb_chain_rule: string;
  limb_spec_level: Record<string, string>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  predictions_scored: {
    id: number;
    prediction: string;
    blind: boolean;
    observed: string;
    met: boolean;
    notes_written_after_a_result?: {
      written_after_batch_generated_at: string;
      observed_then: string;
      note: string;
    }[];
  }[];
  per_log: {
    log_key: string;
    description: string;
    operator: string;
    checkpoint_format: string;
    must_admit: boolean;
    refuse_reason: string | null;
    attribution: string | null;
    first_size: number | null;
    second_size: number | null;
    entries_added: number | null;
    proof_nodes: number | null;
    receipt: string;
  }[];
  prior_art: { work: string; url: string; relation: string }[];
  not_claimed: string[];
  not_claimed_after_the_freeze?: { added: string; why: string; note: string }[];
}

const b = batch as unknown as Batch;
const n = b.logs_in_population;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function chainOf(limb: string): string {
  const hit = Object.entries(b.limb_chains).find(([, members]) => members.includes(limb));
  return hit ? hit[0] : '';
}

const refuseRate = `${((100 * b.must_refuse) / n).toFixed(1)}%`;
const delta = ledgerDeltaLine('tlog');
const refuseRows = Object.entries(b.refuse_limb_counts).sort((a, x) => x[1] - a[1]);
const attributionRows = Object.entries(b.refusal_attribution).sort((a, x) => x[1] - a[1]);
const formatRows = Object.entries(b.checkpoint_formats).sort((a, x) => x[1] - a[1]);
const operatorRows = Object.entries(b.operators).sort((a, x) => x[1] - a[1]);
const missed = b.predictions_scored.filter((p) => !p.met);
const subjects = [...b.per_log].sort((a, x) => {
  if (a.must_admit !== x.must_admit) return a.must_admit ? 1 : -1;
  return a.log_key.localeCompare(x.log_key);
});
---

<Layout
  title="Transparency log batch monitor · Eigenstate Research"
  description="Public transparency logs, read twice, signatures checked against independently held keys and consistency proofs recomputed. A monitor, not a witness."
  fonts={fonts}
>
  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="rank-hero" id="main">
    <div class="eyebrow">Transparency logs · monitor, not witness</div>
    <h1>Re-deriving what {n} public logs say they did</h1>
    <p class="lede">
      Read a checkpoint, verify the signature against an independently held key, read again, ask for
      a consistency proof, recompute the root. This node does that in batches and cosigns nothing.
    </p>
    <div class="rank-primary">
      <div class="rate">{refuseRate}</div>
      <div class="rate-label">
        MUST refuse rate · {b.must_refuse} of {n} logs · {b.consistency_proofs_recomputed} of{' '}
        {b.consistency_proofs_served} proofs recomputed
      </div>
    </div>
    {delta && <p class="rank-delta">{delta}</p>}
  </div>

  <section class="rank-wrap">
    <div class="rank-runline">
      Population {n} · two reads {b.second_read_gap_seconds}s apart · engine{' '}
      <code>{b.subject.engine_commit?.slice(0, 12)}</code> · run {formatDate(b.generated_at)} ·
      digest <code>{b.digest.slice(0, 16)}</code>
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th>Log</th>
            <th>Operator</th>
            <th class="n">First size</th>
            <th class="n">Added</th>
            <th>Verdict</th>
            <th>Refuse</th>
            <th>Receipt</th>
          </tr>
        </thead>
        <tbody>
          {
            subjects.map((r) => (
              <tr>
                <td class="subject">{r.log_key}</td>
                <td>{r.operator}</td>
                <td class="n">{r.first_size?.toLocaleString() ?? 'n/a'}</td>
                <td class="n">{r.entries_added ?? 0}</td>
                <td class:list={['verdict', r.must_admit ? 'is-admit' : 'is-refuse']}>
                  {r.must_admit ? 'admit' : 'refuse'}
                </td>
                <td>{r.refuse_reason ?? 'no refuse'}</td>
                <td>
                  <a href={r.receipt} rel="noopener">
                    json
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="rank-footer">
      <p class="honesty">
        No key, no cosignature, on no witness list · a batch monitor cannot see a split view between
        batches · verifier failures are charged to this monitor first
      </p>

      <h2>What a batch monitor cannot do</h2>
      <ul>
        {b.role.what_a_batch_monitor_cannot_do.map((item) => <li>{item}</li>)}
      </ul>

      <h2>How to cite / re-check</h2>
      <div class="links-row">
        <a href={`${fed}/tlog/expectations.json`} rel="noopener">expectations.json</a>
        <a href={`${fed}/tlog/ledger.json`} rel="noopener">ledger.json</a>
        <a href={`${fed}/tlog/summary.json`} rel="noopener">summary.json</a>
        <a href={`${fed}/tlog/index.json`} rel="noopener">index.json</a>
        <a href={`${fed}/tlog/README.md`} rel="noopener">README.md</a>
      </div>

      <h2>Verifier self-tests</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Verifier</th><th>Self-test</th><th>Passed</th></tr>
          </thead>
          <tbody>
            {
              Object.entries(b.verifier_selftests).map(([name, result]) => (
                <tr>
                  <td>{name}</td>
                  <td>
                    {Object.entries(result)
                      .filter(([k]) => !['passed', 'verifier', 'failures'].includes(k))
                      .map(([k, v]) => `${k}=${v}`)
                      .join(' · ')}
                  </td>
                  <td class="verdict">{result.passed ? 'yes' : 'no'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Formats and operators</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Checkpoint format</th><th class="n">Logs</th></tr>
          </thead>
          <tbody>
            {
              formatRows.map(([fmt, count]) => (
                <tr>
                  <td>{fmt}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Operator</th><th class="n">Logs</th></tr>
          </thead>
          <tbody>
            {
              operatorRows.map(([op, count]) => (
                <tr>
                  <td>{op}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Where they refuse</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Strongest failing limb</th><th class="n">Logs</th></tr>
          </thead>
          <tbody>
            {
              refuseRows.map(([limb, count]) => (
                <tr>
                  <td>{limb}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Attribution</th><th class="n">Logs</th></tr>
          </thead>
          <tbody>
            {
              attributionRows.map(([who, count]) => (
                <tr>
                  <td>{who}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Limbs</h2>
      <p>{b.limb_chain_rule}</p>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Limb</th><th>Chain</th><th>Level</th><th class="n">ok</th><th class="n">fail</th
              ><th class="n">n/a</th><th class="n">not reached</th>
            </tr>
          </thead>
          <tbody>
            {
              b.limb_order_frozen.map((limb) => (
                <tr>
                  <td>{limb}</td>
                  <td>{chainOf(limb)}</td>
                  <td>{b.limb_spec_level[limb]}</td>
                  <td class="n">{b.limb_outcomes[limb].ok}</td>
                  <td class="n">{b.limb_outcomes[limb].fail}</td>
                  <td class="n">{b.limb_outcomes[limb].not_applicable}</td>
                  <td class="n">{b.limb_outcomes[limb].not_reached}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Predictions</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Prediction</th><th>Observed</th><th>Result</th><th>Blind</th></tr>
          </thead>
          <tbody>
            {
              b.predictions_scored.map((row) => (
                <tr>
                  <td>{row.prediction}</td>
                  <td>{row.observed}</td>
                  <td class="verdict">{row.met ? 'met' : 'missed'}</td>
                  <td class="verdict">{row.blind ? 'yes' : 'no'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {
        missed.length > 0 && (
          <ul>
            {missed.map((p) => (
              <li>
                Missed: {p.prediction} Observed: {p.observed}.
              </li>
            ))}
          </ul>
        )
      }

      <h2>Prior art</h2>
      <ul>
        {
          b.prior_art.map((item) => (
            <li>
              <a href={item.url} rel="noopener">
                {item.work}
              </a>
              : {item.relation}
            </li>
          ))
        }
      </ul>

      <h2>Re-run</h2>
      <pre class="cmd">PYTHONPATH=engine python3 engine/tools/tlog_monitor_run.py selftest
PYTHONPATH=engine python3 engine/tools/tlog_monitor_run.py expect
PYTHONPATH=engine python3 engine/tools/tlog_monitor_run.py run
PYTHONPATH=engine python3 engine/tools/tlog_monitor_export.py</pre>

      <h2>What this is not</h2>
      <ul>
        {b.not_claimed.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
