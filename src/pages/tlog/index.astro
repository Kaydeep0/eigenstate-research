---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import batch from '../../data/tlog_monitor.json';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;

interface Batch {
  generated_at: string;
  batch_started_at?: string;
  digest: string;
  expectations_digest: string;
  expectations_generated_at: string;
  probe_version: string;
  role: {
    this_node_is: string;
    this_node_is_not: string;
    monitor: string;
    witness: string;
    what_a_batch_monitor_cannot_do: string[];
  };
  subject: { what: string; engine_commit: string };
  question: { asked: string; not_asked: string; why_it_is_separate: string };
  population_rule: string;
  second_read_gap_seconds: number;
  second_read_rule: string;
  verifiers_implemented_here: { why: string; discipline: string; what_a_failure_means: string };
  verifier_selftests: Record<string, Record<string, unknown>>;
  verifier_selftests_all_passed: boolean;
  checkpoints_appended_this_batch: number;
  logs_in_population: number;
  must_admit: number;
  must_refuse: number;
  full_admit: number;
  checkpoints_read: number;
  signatures_verified: number;
  signature_schemes_unsupported: number;
  keys_obtained_independently: number;
  trees_advanced_between_reads: number;
  entries_added_between_reads: number;
  consistency_proofs_served: number;
  consistency_proofs_recomputed: number;
  trees_that_shrank: number;
  checkpoints_with_witness_cosignatures: number;
  logs_with_a_prior_batch_on_record: number;
  disagreements: { log: string; limb: string; reason: string; attribution: string }[];
  disagreement_count: number;
  refuse_limb_counts: Record<string, number>;
  top_refuse_reasons: Record<string, number>;
  refusal_attribution: Record<string, number>;
  operators: Record<string, number>;
  checkpoint_formats: Record<string, number>;
  limb_order_frozen: string[];
  limb_chains: Record<string, string[]>;
  limb_chain_rule: string;
  limb_spec_level: Record<string, string>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  predictions_scored: {
    id: number;
    prediction: string;
    blind: boolean;
    observed: string;
    met: boolean;
    notes_written_after_a_result?: {
      written_after_batch_generated_at: string;
      observed_then: string;
      note: string;
    }[];
  }[];
  per_log: {
    log_key: string;
    description: string;
    operator: string;
    checkpoint_format: string;
    signature_scheme: string;
    must_admit: boolean;
    refuse_reason: string | null;
    attribution: string | null;
    first_size: number | null;
    second_size: number | null;
    entries_added: number | null;
    proof_nodes: number | null;
    receipt: string;
  }[];
  prior_art: { work: string; url: string; relation: string }[];
  not_claimed: string[];
  not_claimed_after_the_freeze?: { added: string; why: string; note: string }[];
}

const b = batch as unknown as Batch;
const n = b.logs_in_population;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function chainOf(limb: string): string {
  const hit = Object.entries(b.limb_chains).find(([, members]) => members.includes(limb));
  return hit ? hit[0] : '';
}

const headlines = [
  {
    value: `${b.consistency_proofs_recomputed}`,
    sub: `of ${b.consistency_proofs_served} proofs`,
    label: 'recomputed to the root the log published',
    note: `The whole job of a monitor. Two reads ${b.second_read_gap_seconds} seconds apart, one proof between them, arithmetic done here.`,
  },
  {
    value: `${b.signatures_verified}`,
    sub: `of ${n} checkpoints`,
    label: 'verified against an independently held key',
    note: 'Verified with a pure Python ECDSA and Ed25519 implementation that is self-tested before it is allowed to charge anyone.',
  },
  {
    value: `${b.disagreement_count}`,
    sub: 'this batch',
    label: 'disagreements recorded',
    note: `No tree shrank and no log served two roots at one size. ${b.entries_added_between_reads.toLocaleString()} entries were added across ${b.trees_advanced_between_reads} logs while this monitor watched.`,
  },
  {
    value: `${b.checkpoints_with_witness_cosignatures}`,
    sub: `of ${n} checkpoints`,
    label: 'carried a witness cosignature',
    note: 'Including this node, which cosigns nothing. A signed tree head has nowhere to put one, and the notes here carried only the log.',
  },
];

const refuseRows = Object.entries(b.refuse_limb_counts).sort((a, x) => x[1] - a[1]);
const attributionRows = Object.entries(b.refusal_attribution).sort((a, x) => x[1] - a[1]);
const formatRows = Object.entries(b.checkpoint_formats).sort((a, x) => x[1] - a[1]);
const operatorRows = Object.entries(b.operators).sort((a, x) => x[1] - a[1]);
const missed = b.predictions_scored.filter((p) => !p.met);
---

<Layout
  title="Transparency log batch monitor · Eigenstate Research"
  description="Twenty three public transparency logs, read twice, signatures checked against independently held keys and consistency proofs recomputed. A monitor, not a witness. Expectations published before the batch."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .page-hero {
        max-width: 820px;
        margin: 0 auto;
        padding: 72px 24px 20px;
        text-align: center;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.15em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .page-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        line-height: 1.15;
        margin: 0 0 16px;
      }

      .page-hero .grad {
        background: linear-gradient(135deg, var(--signal) 0%, var(--accent) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .explainer {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 auto 12px;
        max-width: 640px;
      }

      .honesty {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0 auto;
        max-width: 640px;
      }

      .wrap {
        max-width: 880px;
        margin: 0 auto;
        padding: 8px 24px 80px;
      }

      .runline {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.8;
        padding: 14px 16px;
        background: var(--bg2);
        border-left: 3px solid var(--border-live);
        margin: 20px 0 32px;
        overflow-wrap: anywhere;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 36px;
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 20px 18px;
      }

      .card .big {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 4px;
      }

      .card .ci {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: 10px;
      }

      .card .lab {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: 8px;
      }

      .card .note {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.6;
      }

      h2 {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
        margin: 36px 0 10px;
        letter-spacing: -0.01em;
      }

      p.body {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 14px;
      }

      p.body a,
      .links-row a,
      td a,
      ul.plain a {
        color: var(--signal-dim);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        margin: 8px 0 18px;
      }

      th,
      td {
        text-align: left;
        padding: 9px 10px;
        border-bottom: 1px solid var(--border);
        color: var(--text-secondary);
        vertical-align: top;
      }

      th {
        color: var(--text-muted);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 500;
      }

      td.n {
        text-align: right;
        color: var(--text-primary);
      }

      td.verdict {
        color: var(--text-primary);
        white-space: nowrap;
      }

      .links-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        margin: 12px 0 8px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }

      .links-row a {
        text-decoration: none;
      }

      .links-row a:hover {
        text-decoration: underline;
      }

      pre.cmd {
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.55;
        background: #1a1a1a;
        color: #e8e6e1;
        padding: 16px 18px;
        border-radius: var(--radius-sm);
        overflow-x: auto;
        margin: 0 0 12px;
        white-space: pre;
      }

      ul.plain {
        margin: 0 0 16px 18px;
        padding: 0;
      }

      ul.plain li {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 6px;
      }

      .callout {
        background: var(--bg2);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 18px 20px;
        margin: 8px 0 20px;
      }

      .callout p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 10px;
      }

      .callout p:last-child {
        margin-bottom: 0;
      }

      code.path {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-secondary);
        overflow-wrap: anywhere;
      }

      @media (width <= 640px) {
        .page-hero {
          padding-top: 48px;
        }

        pre.cmd {
          font-size: 11px;
          padding: 14px;
        }
      }
    </style>
  </Fragment>

  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="page-hero" id="main">
    <div class="eyebrow">Transparency logs · monitor, not witness · expectations first</div>
    <h1>Re-deriving what {n} public logs <span class="grad">say</span> they did</h1>
    <p class="explainer">
      A witness holds a key, stays online, and cosigns a checkpoint to attest it saw that tree head
      and no other. A monitor holds no key, runs in batches, and re-derives: read a checkpoint,
      check the signature against a key the log did not hand you, read it again later, ask for a
      consistency proof between the two sizes, and recompute the second root from the first. This
      node does the second thing and claims nothing about the first.
    </p>
    <p class="honesty">
      No key, no cosignature, on no witness list · a batch monitor cannot see a split view between
      batches · the verifiers are hand rolled and self-tested, and a failure here is charged to
      this monitor first
    </p>
  </div>

  <section class="wrap">
    <div class="runline">
      Population {n} logs, {b.checkpoint_formats['ct_v1_sth'] ?? 0} Certificate Transparency plus
      the Go checksum database and Sigstore Rekor<br />
      Two reads per log, {b.second_read_gap_seconds} seconds apart · engine commit <code
        >{b.subject.engine_commit?.slice(0, 12)}</code
      ><br />
      Expectations digest <code>{b.expectations_digest}</code> published {
        formatDate(b.expectations_generated_at)
      }<br />
      Batch digest <code>{b.digest}</code> run {formatDate(b.generated_at)} · probe v{
        b.probe_version
      }
    </div>

    <div class="cards">
      {
        headlines.map((h) => (
          <div class="card">
            <div class="big">{h.value}</div>
            <div class="ci">{h.sub}</div>
            <div class="lab">{h.label}</div>
            <div class="note">{h.note}</div>
          </div>
        ))
      }
    </div>

    <h2>What a batch monitor cannot do</h2>
    <div class="callout">
      <p>
        Stating this first, because the value of the numbers above depends entirely on the reader
        knowing what they are not.
      </p>
      <ul class="plain">
        {b.role.what_a_batch_monitor_cannot_do.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <h2>Cold start, stated plainly</h2>
    <p class="body">
      This monitor holds a prior batch for {b.logs_with_a_prior_batch_on_record} of {n} logs,
      because this is the first batch. Everything on this page is a within-batch result: two reads {
        b.second_read_gap_seconds
      } seconds apart and the proof between them. Cross-run comparison starts from the next batch,
      and this run appended {b.checkpoints_appended_this_batch} checkpoints to the append only record
      it will compare against. There is no way to make a first batch look like a long running monitor
      and no attempt was made to.
    </p>

    <h2>The arithmetic is hand rolled, and it is self-tested first</h2>
    <div class="callout">
      <p>{b.verifiers_implemented_here.why}</p>
      <p>{b.verifiers_implemented_here.discipline}</p>
      <p><strong>{b.verifiers_implemented_here.what_a_failure_means}</strong></p>
    </div>
    <table>
      <thead>
        <tr><th>Verifier</th><th>Self-test</th><th class="verdict">Passed</th></tr>
      </thead>
      <tbody>
        {
          Object.entries(b.verifier_selftests).map(([name, result]) => (
            <tr>
              <td>{name}</td>
              <td>
                {Object.entries(result)
                  .filter(([k]) => !['passed', 'verifier', 'failures'].includes(k))
                  .map(([k, v]) => `${k}=${v}`)
                  .join(' · ')}
              </td>
              <td class="verdict">{result.passed ? 'yes' : 'no'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>What this batch read</h2>
    <table>
      <thead>
        <tr><th>Checkpoint format</th><th class="n">Logs</th></tr>
      </thead>
      <tbody>
        {
          formatRows.map(([fmt, count]) => (
            <tr>
              <td>{fmt}</td>
              <td class="n">{count}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <table>
      <thead>
        <tr><th>Operator</th><th class="n">Logs</th></tr>
      </thead>
      <tbody>
        {
          operatorRows.map(([op, count]) => (
            <tr>
              <td>{op}</td>
              <td class="n">{count}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="body">
      {b.trees_advanced_between_reads} of {n} trees advanced during the window, adding {
        b.entries_added_between_reads.toLocaleString()
      } entries between the two reads. Where a tree did not advance there is nothing to prove, and the
      receipt records that rather than charging the log for a quiet minute.
    </p>

    <h2>Where they refuse, and who the refusal belongs to</h2>
    <table>
      <thead>
        <tr><th>Strongest failing limb</th><th class="n">Logs</th></tr>
      </thead>
      <tbody>
        {
          refuseRows.map(([limb, count]) => (
            <tr>
              <td>{limb}</td>
              <td class="n">{count}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <table>
      <thead>
        <tr><th>Attribution</th><th class="n">Logs</th></tr>
      </thead>
      <tbody>
        {
          attributionRows.map(([who, count]) => (
            <tr>
              <td>{who}</td>
              <td class="n">{count}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="body">
      The one MUST refusal in this batch is Sigstore Rekor, and it is attributed to the ecosystem
      rather than to the log. The only key source this monitor reads for it is the log's own
      endpoint, and a log that is the only source of its own key cannot be checked by a reader who
      did not already trust it. Sigstore does distribute that key through a separate TUF root, which
      is the independent path, and this monitor has not implemented TUF. Rekor's checkpoint also
      uses a note signature scheme this monitor cannot read, and that refusal is charged to this
      monitor.
    </p>

    <h2>Limbs</h2>
    <p class="body">{b.limb_chain_rule}</p>
    <table>
      <thead>
        <tr>
          <th>Limb</th><th>Chain</th><th>Level</th><th class="n">ok</th><th class="n">fail</th><th
            class="n">n/a</th
          ><th class="n">not reached</th>
        </tr>
      </thead>
      <tbody>
        {
          b.limb_order_frozen.map((limb) => (
            <tr>
              <td>{limb}</td>
              <td>{chainOf(limb)}</td>
              <td>{b.limb_spec_level[limb]}</td>
              <td class="n">{b.limb_outcomes[limb].ok}</td>
              <td class="n">{b.limb_outcomes[limb].fail}</td>
              <td class="n">{b.limb_outcomes[limb].not_applicable}</td>
              <td class="n">{b.limb_outcomes[limb].not_reached}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>Predictions, scored, including the one that missed</h2>
    <p class="body">
      Seven predictions were written into the expectations file and published before the batch, at
      digest {b.expectations_digest.slice(0, 16)}. {missed.length} missed. The scorer was not
      changed afterwards and the window was not widened, because rewriting either until a prediction
      passes is the failure this whole pattern exists to prevent.
    </p>
    <table>
      <thead>
        <tr><th>Prediction</th><th>Observed</th><th class="verdict">Result</th><th class="verdict"
            >Blind</th
          ></tr>
      </thead>
      <tbody>
        {
          b.predictions_scored.map((p) => (
            <tr>
              <td>{p.prediction}</td>
              <td>{p.observed}</td>
              <td class="verdict">{p.met ? 'met' : 'missed'}</td>
              <td class="verdict">{p.blind ? 'yes' : 'no'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    {
      missed.length > 0 && (
        <div class="callout">
          {missed.map((p) => (
            <Fragment>
              <p>
                <strong>Missed:</strong> {p.prediction} Observed: {p.observed}.
              </p>
              {(p.notes_written_after_a_result ?? []).map((note) => (
                <p>
                  <strong>Written after the batch of {formatDate(note.written_after_batch_generated_at)}</strong>,
                  which observed {note.observed_then}: {note.note}
                </p>
              ))}
            </Fragment>
          ))}
        </div>
      )
    }

    <h2>Per log</h2>
    <table>
      <thead>
        <tr>
          <th>Log</th><th class="n">First size</th><th class="n">Added</th><th class="n"
            >Proof nodes</th
          ><th class="verdict">Verdict</th><th>Receipt</th>
        </tr>
      </thead>
      <tbody>
        {
          b.per_log.map((r) => (
            <tr>
              <td>{r.log_key}</td>
              <td class="n">{r.first_size?.toLocaleString() ?? 'none'}</td>
              <td class="n">{r.entries_added ?? 0}</td>
              <td class="n">{r.proof_nodes ?? 'none'}</td>
              <td class="verdict">{r.must_admit ? 'admit' : 'refuse'}</td>
              <td>
                <a href={r.receipt} rel="noopener">
                  json
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>Prior art</h2>
    <p class="body">
      None of the constructions here are this node's work. The monitor implements what these
      specifications already define, and the ledger exists to record what one reader saw when it
      did.
    </p>
    <ul class="plain">
      {
        b.prior_art.map((item) => (
          <li>
            <a href={item.url} rel="noopener">
              {item.work}
            </a>
            : {item.relation}
          </li>
        ))
      }
    </ul>

    <h2>Read it yourself</h2>
    <div class="links-row">
      <a href={`${fed}/tlog/expectations.json`} rel="noopener">expectations.json</a>
      <a href={`${fed}/tlog/ledger.json`} rel="noopener">ledger.json</a>
      <a href={`${fed}/tlog/summary.json`} rel="noopener">summary.json</a>
      <a href={`${fed}/tlog/index.json`} rel="noopener">index.json</a>
      <a href={`${fed}/tlog/README.md`} rel="noopener">README.md</a>
    </div>
    <p class="body">
      One log at a time: <code class="path">{fed}/tlog/receipts/&lt;LOG_KEY&gt;.json</code>, with
      slashes in the log key written as underscores. The index carries both forms so nobody has to
      guess.
    </p>

    <h2>Re-run it</h2>
    <pre class="cmd">PYTHONPATH=engine python3 engine/tools/tlog_monitor_run.py selftest
PYTHONPATH=engine python3 engine/tools/tlog_monitor_run.py expect
PYTHONPATH=engine python3 engine/tools/tlog_monitor_run.py run
PYTHONPATH=engine python3 engine/tools/tlog_monitor_export.py</pre>
    <p class="body">
      <code class="path">selftest</code> runs the verifier checks on their own and needs no network.
      <code class="path">run</code> aborts if the expectations digest stops matching its contents.
    </p>

    <h2>What this is not</h2>
    <ul class="plain">
      {b.not_claimed.map((item) => <li>{item}</li>)}
    </ul>
    {
      (b.not_claimed_after_the_freeze ?? []).length > 0 && (
        <div class="callout">
          <p>
            Added after the expectations were frozen, and kept separate rather than folded into
            the list above, because editing a frozen list after the fact would defeat the reason
            for freezing it.
          </p>
          {(b.not_claimed_after_the_freeze ?? []).map((item) => (
            <p>
              <strong>Added {item.added}</strong>, {item.why}: {item.note}
            </p>
          ))}
        </div>
      )
    }
  </section>

  <Footer />
</Layout>
