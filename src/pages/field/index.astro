---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import fieldGraph from '../../../public/field-graph.json';
import { formatNum, entityCodeFromReportId } from '../../lib/sot';
import { slugFor } from '../../lib/reports';
const W = 1200;
const H = 760;

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const graph = fieldGraph as {
  generated_at?: string;
  counts?: { nodes: number; edges: number; public_nodes: number };
  field?: { kappa?: number | null; protocol_truth?: number | null };
  nodes: Array<{
    id: string;
    display: string;
    phi_s: number | null;
    kappa: number | null;
    display_kind: string;
    display_role: string;
    demoted: boolean;
    degree: number;
    x: number;
    y: number;
  }>;
  edges: Array<{
    source: string;
    target: string;
    conn_type: string;
    vector: string;
  }>;
};

const stamp = (graph.generated_at || '').slice(0, 19);
const kappa = graph.field?.kappa;
const pt = graph.field?.protocol_truth;
const base = import.meta.env.BASE_URL;

const latestByEntity: Record<string, { slug: string; date: string; id: string }> = {};
for (const r of await getCollection('reports')) {
  const code = entityCodeFromReportId(String(r.data.id || ''));
  if (!code) continue;
  const date = String(r.data.date_iso || '');
  const prev = latestByEntity[code];
  if (!prev || date > prev.date) {
    latestByEntity[code] = { slug: slugFor(r.id), date, id: String(r.data.id) };
  }
}
---

<Layout
  title="Field graph · Eigenstate Research"
  description="Live topology of measured entities and their connections. Node size is Φ_S from the engine dossier mirror."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .field-hero {
        padding: 48px 40px 20px;
        background: var(--bg2);
        border-bottom: 1px solid var(--border);
      }

      .field-hero-inner {
        max-width: 1200px;
        margin: 0 auto;
      }

      .field-kicker {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--signal);
        margin: 0 0 10px;
      }

      .field-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 700;
        margin: 0 0 10px;
        letter-spacing: 0.02em;
      }

      .field-lead {
        max-width: 760px;
        color: var(--text-secondary);
        font-size: var(--text-base);
        line-height: 1.55;
        margin: 0 0 16px;
      }

      .panel-links p {
        margin: 0 0 6px;
      }

      .field-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 20px 28px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .field-stats strong {
        color: var(--text-primary);
        font-weight: 600;
      }

      .field-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        max-width: 1480px;
        margin: 0 auto;
        min-height: 72vh;
      }

      .field-main {
        padding: 16px 16px 32px 24px;
      }

      .field-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 16px;
        align-items: center;
        margin-bottom: 12px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-secondary);
      }

      .field-controls input[type='search'] {
        font: inherit;
        padding: 8px 10px;
        min-width: 220px;
        border: 1px solid var(--border-strong);
        background: var(--bg2);
        color: var(--text-primary);
      }

      .field-controls label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
      }

      .field-encode {
        margin-left: auto;
        color: var(--text-muted);
        max-width: 46ch;
        line-height: 1.4;
      }

      .field-svg {
        width: 100%;
        height: min(78vh, 820px);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        cursor: grab;
        touch-action: none;
      }

      /* :global so JS-created SVG nodes inherit the same rules as SSR. */
      .field-svg :global(.g-edge) {
        fill: none;
        stroke-width: 0.9;
        opacity: 0.22;
      }

      .field-svg.is-overview :global(.g-edge) {
        opacity: 0.1;
      }

      .field-svg.is-overview :global(.g-edge.is-strong) {
        opacity: 0.42;
        stroke-width: 1.2;
      }

      .field-svg :global(.g-edge[data-vector='Information']) {
        stroke: var(--signal);
      }

      .field-svg :global(.g-edge[data-vector='Capital']) {
        stroke: var(--accent);
      }

      .field-svg :global(.g-edge[data-vector='Infrastructure']) {
        stroke: var(--text-secondary);
      }

      .field-svg :global(.g-edge.is-focus-edge) {
        opacity: 0.95;
        stroke-width: 1.6;
      }

      .field-svg :global(.g-node) {
        cursor: pointer;
      }

      .field-svg :global(.g-node circle) {
        stroke: #fff;
        stroke-width: 1;
      }

      .field-svg :global(.role-actor circle) {
        fill: var(--accent);
      }

      .field-svg :global(.role-rail circle) {
        fill: var(--signal);
      }

      .field-svg :global(.role-rule circle) {
        fill: var(--status-warning);
      }

      .field-svg :global(.role-other circle) {
        fill: var(--text-muted);
      }

      .field-svg :global(.g-label) {
        font-family: var(--font-mono);
        font-size: 12px;
        fill: var(--text-primary);
        pointer-events: none;
        display: none;
        paint-order: stroke fill;
        stroke: var(--bg);
        stroke-width: 5px;
        stroke-linejoin: round;
      }

      .field-svg.is-overview :global(.g-label.is-topk),
      .field-svg.is-overview :global(.g-node:hover .g-label),
      .field-svg.is-hop :global(.g-label.is-on),
      .field-svg :global(.g-node.is-focus .g-label) {
        display: block;
      }

      .field-svg :global(.g-col-head) {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        fill: var(--text-muted);
        pointer-events: none;
      }

      .field-svg :global(.g-node.is-focus circle) {
        stroke: var(--text-primary);
        stroke-width: 2.5;
      }

      .field-svg.is-hop :global(.g-edge.is-focus-edge) {
        opacity: 0.7;
        stroke-width: 1.4;
      }

      .field-svg :global(.g-node.is-dim) {
        opacity: 0.22;
      }

      .field-svg :global(.g-node.is-hidden),
      .field-svg :global(.g-edge.is-hidden) {
        display: none;
      }

      .field-svg:not(.is-live) :global(.g-node[data-demoted='true']),
      .field-svg:not(.is-live) :global(.g-node[data-isolated='true']) {
        display: none;
      }

      .panel-legend {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        margin: 6px 0 0;
      }

      .field-side {
        border-left: 1px solid var(--border);
        padding: 20px 18px 40px;
        background: var(--bg2);
      }

      .field-side h2 {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        margin: 0 0 4px;
      }

      .panel-kicker,
      .panel-code,
      .panel-empty {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      .panel-empty {
        margin-top: 12px;
        line-height: 1.5;
      }

      .field-side dl {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 12px;
        margin: 14px 0;
      }

      .field-side dt {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }

      .field-side dd {
        margin: 2px 0 0;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-primary);
      }

      .field-side a {
        color: var(--signal);
        font-size: var(--text-sm);
      }

      .panel-hops {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
      }

      .panel-hops li {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: var(--text-xs);
        padding: 4px 0;
        border-bottom: 1px solid var(--border);
      }

      .panel-hops button {
        background: none;
        border: 0;
        padding: 0;
        color: var(--signal);
        cursor: pointer;
        font: inherit;
        text-align: left;
      }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 16px;
        margin-top: 10px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
      }

      .legend i {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
      }

      .sw-actor {
        background: var(--accent);
      }

      .sw-rail {
        background: var(--signal);
      }

      .sw-rule {
        background: var(--status-warning);
      }

      .field-note {
        margin-top: 10px;
        font-size: var(--text-xs);
        color: var(--text-muted);
        max-width: 70ch;
      }

      @media (width <= 900px) {
        .field-shell {
          grid-template-columns: 1fr;
        }

        .field-hero,
        .field-main {
          padding-left: 16px;
          padding-right: 16px;
        }

        .field-side {
          border-left: 0;
          border-top: 1px solid var(--border);
        }
      }
    </style>
  </Fragment>

  <Nav active="field" />

  <header class="field-hero">
    <div class="field-hero-inner" id="main">
      <p class="field-kicker">Visual membrane</p>
      <h1>The field as a graph</h1>
      <p class="field-lead">
        One field. The map is the living picture: node size is Φ_S, lines are connections
        that have been measured. The default view is the strongest nodes, grouped by role.
        Click a node for one hop, the live dossier, the latest report, and the Vercel feed.
        The 400-year product that gave birth to these seats is on
        <a href={`${base}origin/`}>Origin</a>.
      </p>
      <div class="field-stats">
        <span><strong>{graph.counts?.nodes ?? graph.nodes.length}</strong> nodes</span>
        <span><strong>{graph.counts?.edges ?? graph.edges.length}</strong> edges</span>
        <span>κ <strong>{formatNum(kappa, 3)}</strong></span>
        <span>PT <strong>{formatNum(pt, 3)}</strong></span>
        <span>baked {stamp}Z</span>
      </div>
    </div>
  </header>

  <div class="field-shell">
    <div class="field-main">
      <div class="field-controls">
        <input id="fieldSearch" type="search" placeholder="Search entity" autocomplete="off" />
        <label><input id="fieldHop" type="checkbox" /> One hop</label>
        <label><input id="fieldDims" type="checkbox" /> Dimensions</label>
        <label><input id="fieldIsolated" type="checkbox" /> Isolated</label>
        <label><input type="checkbox" name="fieldVector" value="Information" checked /> Information</label>
        <label><input type="checkbox" name="fieldVector" value="Capital" checked /> Capital</label>
        <label>
          <input type="checkbox" name="fieldVector" value="Infrastructure" checked />
          Infrastructure
        </label>
        <span class="field-encode">Size is Φ_S. Color is role. Labels are the largest eight. Hover for a name. Click for one hop.</span>
      </div>
      <svg
        id="fieldSvg"
        class="field-svg"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label="Topology graph of Eigenstate entities and connections"
      >
        <g id="graphStage"></g>
      </svg>
      <div class="legend">
        <span><i class="sw-actor"></i>Actors</span>
        <span><i class="sw-rail"></i>Rails</span>
        <span><i class="sw-rule"></i>Rule frameworks</span>
        <span>Line color = vector</span>
      </div>
      <p class="field-note">
        Parkash rebakes this graph with field-state. Pages push plus a refresh loads new
        sizes and new edges. Dated reports stay the beat they were. Compounding across waves:
        <a href={`${base}origin/`}>Origin</a>. Machine JSON:
        <a href={`${base}field-graph.json`}>field-graph.json</a>.
      </p>
    </div>
    <aside class="field-side" id="fieldPanel">
      <p class="panel-empty">
        Overview: largest Φ_S, grouped by role. Hover a name. Click for one hop.
      </p>
    </aside>
  </div>

  <Footer variant="full" />
  <script id="field-latest-json" type="application/json" set:html={JSON.stringify(latestByEntity)} />
</Layout>

<script>
  import { initFieldGraph, rebuildStage } from '../../lib/fieldGraph';
  import baked from '../../../public/field-graph.json';

  const svg = document.getElementById('fieldSvg');
  const raw = document.getElementById('field-latest-json')?.textContent || '{}';
  let latest: Record<string, { slug: string; date: string; id: string }> = {};
  try {
    latest = JSON.parse(raw) as typeof latest;
  } catch {
    latest = {};
  }

  async function boot() {
    if (!(svg instanceof SVGSVGElement)) return;
    let data = baked as typeof baked;
    try {
      const res = await fetch(`${import.meta.env.BASE_URL}field-graph.json`, { cache: 'no-store' });
      if (res.ok) {
        const live = await res.json();
        if (live && Array.isArray(live.nodes) && Array.isArray(live.edges)) data = live;
      }
    } catch {
      /* keep bake */
    }
    svg.classList.add('is-live');
    rebuildStage(svg, data as never);
    initFieldGraph(svg, data as never, import.meta.env.BASE_URL, { latestByEntity: latest });
  }

  boot();
</script>
