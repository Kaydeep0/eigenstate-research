---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { loadSot, formatNum, ptSparklinePoints } from '../../lib/sot';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const sot = loadSot();
const field = sot.field;
const cov = sot.coverage;
const sb = sot.predictions_scoreboard;
const series = sot.pt_kappa_series || [];
const spark = ptSparklinePoints(series);
const base = import.meta.env.BASE_URL;

const kappa = field.kappa;
const pt = field.protocol_truth ?? field.PT;
const generatedAt = sot.generated_at;
const parkashAt = sot.sources.parkash_last_parkash_at;

const accuracyLabel =
  sb.accuracy_pct != null
    ? `${sb.accuracy_pct}%`
    : sb.n_assessable === 0
      ? 'n/a'
      : `n=${sb.n_assessable}`;

const accuracyNote =
  sb.accuracy_pct != null
    ? `${sb.n_true} of ${sb.n_assessable} assessable TRUE`
    : sb.n_assessable === 0
      ? 'No assessable scored claims yet (need n ≥ 5 for a rate)'
      : `${sb.n_true} TRUE / ${sb.n_false} FALSE · assessable n too thin for a %`;

const seriesStart = series[0]?.t_close?.slice?.(0, 10) || '';
const seriesEnd = series[series.length - 1]?.t_close?.slice?.(0, 10) || '';

function fmtUtc(iso: string | null | undefined): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').replace(/\.\d+Z$/, ' UTC');
}
---

<Layout
  title="Prediction Track Record — Eigenstate Research"
  description="Verifiable measurement track record from engine SoT: M1 coverage, Protocol Truth, κ, and honest assessable claim counts. E = ΔI/A."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 40px;
      }

      @media (width <= 640px) {
        .container {
          padding: 40px 20px;
        }
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.25em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .page-title {
        font-family: var(--font-heading);
        font-size: clamp(24px, 3vw, 36px);
        font-weight: 800;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
      }

      .page-sub {
        color: var(--text-secondary);
        font-size: var(--text-base);
        margin-bottom: 28px;
        max-width: 720px;
        line-height: 1.6;
      }

      .sot-banner {
        background: rgb(47 90 99 / 8%);
        border: 1px solid var(--border-strong);
        border-left: 3px solid var(--signal);
        border-radius: var(--radius-md);
        padding: 16px 20px;
        margin-bottom: 36px;
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.65;
      }

      .sot-banner strong {
        color: var(--text-primary);
      }

      .sot-banner a {
        color: var(--signal);
        text-decoration: none;
      }

      .sot-banner a:hover {
        text-decoration: underline;
      }

      .sot-stamp {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: 8px;
      }

      .stats-instrument {
        padding: 4px;
        margin-bottom: 48px;
      }

      .stats-hero-row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 16px;
        margin-bottom: 16px;
      }

      @media (width <= 760px) {
        .stats-hero-row {
          grid-template-columns: 1fr;
        }
      }

      .stat-hero,
      .stat-chart {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        padding: 28px 32px;
      }

      @media (width <= 480px) {
        .stat-hero,
        .stat-chart {
          padding: 20px;
        }
      }

      .stat-hero-label,
      .stat-chart-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 10px;
      }

      .stat-hero-value {
        font-family: var(--font-heading);
        font-size: var(--text-4xl);
        font-weight: 700;
        line-height: 1;
        color: var(--text-primary);
      }

      .stat-hero-value.thin {
        color: var(--status-warning);
        font-size: var(--text-3xl);
      }

      .stat-chart-value {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        font-weight: 700;
        color: var(--signal);
      }

      .stat-hero-note,
      .stat-chart-note {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        margin-top: 8px;
      }

      .pt-sparkline {
        display: block;
        width: 100%;
        height: auto;
        margin-top: 12px;
      }

      .stats-secondary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      @media (width <= 900px) {
        .stats-secondary {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (width <= 560px) {
        .stats-secondary {
          grid-template-columns: 1fr;
        }
      }

      .stat-card-sm {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 18px 20px;
      }

      .stat-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      .stat-value {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
      }

      .stat-note {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        margin-top: 6px;
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--text-secondary);
        text-transform: uppercase;
        margin-bottom: 20px;
        margin-top: 48px;
      }

      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
      }

      thead tr {
        background: var(--bg2);
      }

      th {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid var(--border-live);
        white-space: nowrap;
      }

      td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
      }

      tr:last-child td {
        border-bottom: none;
      }

      tbody tr:nth-child(even) td {
        background: rgb(0 0 0 / 3%);
      }

      .cell-mono {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-secondary);
      }

      .cell-id {
        font-weight: 500;
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }

      .status::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentcolor;
        flex-shrink: 0;
      }

      .status-false {
        color: var(--status-error);
      }

      .status-true {
        color: var(--status-success);
      }

      .status-void {
        color: var(--text-muted);
      }

      .empty-note {
        padding: 28px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        text-align: center;
      }

      .method-block {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 32px;
        margin-top: 48px;
      }

      .method-block h3 {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 20px;
        color: var(--text-secondary);
      }

      .method-beats {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .method-beat {
        display: grid;
        grid-template-columns: 32px 1fr;
        gap: 16px;
        align-items: start;
      }

      .method-beat .beat-marker {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--accent-dark);
        letter-spacing: 0.05em;
        padding-top: 2px;
      }

      .method-block p {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
      }

      .method-block code {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        color: var(--signal);
        background: rgb(47 90 99 / 8%);
        padding: 2px 6px;
        border-radius: var(--radius-sm);
      }

      .verify-strip {
        background: rgb(47 90 99 / 6%);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        padding: 20px 24px;
        margin-top: 32px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: center;
      }

      .verify-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .verify-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .verify-value {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal);
        word-break: break-all;
      }

      .verify-value a {
        color: var(--signal);
        text-decoration: none;
      }

      .verify-value a:hover {
        text-decoration: underline;
      }
    </style>
  </Fragment>

  <Nav active="track-record" />

  <div class="container" id="main">
    <div class="eyebrow">EIGENSTATE RESEARCH · VERIFIABLE TRACK RECORD</div>
    <h1 class="page-title">PREDICTION TRACK RECORD</h1>
    <p class="page-sub">
      Live field metrics and scored Host claims, rebuilt from engine SoT at bake time — not a frozen
      April 2026 HTML snapshot.
    </p>

    <aside class="sot-banner" aria-label="Source of truth">
      <strong>SoT (source of truth)</strong> for these numbers is the GeniusFlow engine measurement
      state: <code>HOST/state.json</code> (κ, Protocol Truth, parkash stamps) and the M1 coverage
      ledger (strict observations ∩ topology / 199). Pages copies a stamp into
      <code>public/field-state.json</code> on deploy.
      See <a href={`${base}METHODOLOGY.md`}>Methodology</a>.
      <div class="sot-stamp">
        Stamp {fmtUtc(generatedAt)} · last parkash {fmtUtc(parkashAt)}
      </div>
    </aside>

    <div class="stats-instrument bracket">
      <div class="stats-hero-row">
        <div class="stat-hero">
          <div class="stat-hero-label">Assessable accuracy</div>
          <div class={`stat-hero-value ${sb.accuracy_pct == null ? 'thin' : ''}`}>{accuracyLabel}</div>
          <div class="stat-hero-note">{accuracyNote}</div>
        </div>
        <div class="stat-chart">
          <div class="stat-chart-label">Protocol Truth (PT)</div>
          <div class="stat-chart-value">{formatNum(pt, 4)}</div>
          <div class="stat-chart-note">
            From HOST SoT · act threshold {formatNum(field.canonical_act_threshold, 3)}
          </div>
          {
            spark.points ? (
              <svg width="300" height="60" viewBox="0 0 300 60" class="pt-sparkline" aria-label="PT series">
                <polyline
                  points={spark.points}
                  fill="none"
                  stroke="#2f5a63"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  opacity="0.8"
                ></polyline>
                {seriesStart && (
                  <text x="2" y="58" font-size="9" fill="#71717a" font-family="JetBrains Mono">
                    {seriesStart}
                  </text>
                )}
                {seriesEnd && (
                  <text
                    x="298"
                    y="58"
                    font-size="9"
                    fill="#71717a"
                    font-family="JetBrains Mono"
                    text-anchor="end"
                  >
                    {seriesEnd}
                  </text>
                )}
              </svg>
            ) : (
              <p class="stat-chart-note">No cycle_history series in this stamp.</p>
            )
          }
        </div>
      </div>

      <div class="stats-secondary">
        <div class="stat-card-sm">
          <div class="stat-label">M1 coverage</div>
          <div class="stat-value">{cov.headline}</div>
          <div class="stat-note">{cov.m1_strict_pct}% · m1_strict ledger</div>
        </div>
        <div class="stat-card-sm">
          <div class="stat-label">Coherence (κ)</div>
          <div class="stat-value">{formatNum(kappa, 4)}</div>
          <div class="stat-note">HOST κ at last stamp</div>
        </div>
        <div class="stat-card-sm">
          <div class="stat-label">Host predictions</div>
          <div class="stat-value">{sb.n_total}</div>
          <div class="stat-note">{sb.n_open} open · {sb.n_resolved} resolved</div>
        </div>
        <div class="stat-card-sm">
          <div class="stat-label">M1 confirmed</div>
          <div class="stat-value">{cov.m1_confirmed_n} / {cov.m1_denominator}</div>
          <div class="stat-note">confirmed subset of strict coverage</div>
        </div>
      </div>
    </div>

    <div class="section-title">Resolved Host claims (SoT scoreboard)</div>
    <div class="table-wrap bracket">
      {
        sb.resolved && sb.resolved.length > 0 ? (
          <table>
            <thead>
              <tr>
                <th>Prediction</th>
                <th>Deadline</th>
                <th>Outcome</th>
                <th>Calibration weight</th>
                <th>Resolved</th>
              </tr>
            </thead>
            <tbody>
              {sb.resolved.map((row) => {
                const outcome = (row.outcome || '').toUpperCase();
                const statusClass =
                  outcome === 'TRUE'
                    ? 'status-true'
                    : outcome === 'FALSE'
                      ? 'status-false'
                      : 'status-void';
                return (
                  <tr>
                    <td class="cell-id">{row.prediction_id}</td>
                    <td class="cell-mono">{row.deadline || '—'}</td>
                    <td>
                      <span class={`status ${statusClass}`}>{outcome || row.status}</span>
                    </td>
                    <td class="cell-mono">{row.calibration_weight ?? '—'}</td>
                    <td class="cell-mono">{row.resolved_at ? String(row.resolved_at).slice(0, 10) : '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ) : (
          <p class="empty-note">No resolved Host claims in this SoT stamp.</p>
        )
      }
    </div>
    <p class="stat-note" style="margin-top: 12px;">
      {sb.note} On-chain gap predictions (separate surface):{' '}
      <a href={`${base}predictions/`} style="color: var(--signal);">Predictions</a>.
      INFRA_FLOW / cumulative volume is <em>not</em> Φ_S — prior track-record rows that placed volume
      in the Φ_S column were retired with this rebuild.
    </p>

    <div class="method-block">
      <h3>METHODOLOGY</h3>
      <div class="method-beats">
        <div class="method-beat">
          <span class="beat-marker">01</span>
          <p>
            <strong>Φ_S (settlement pressure)</strong> is the engine's primary entity signal — unrealized
            settlement energy at entity granularity. Derivation: <code>E = ΔI / A</code>. Volume /
            INFRA_FLOW totals are a different unit and must not be shown as Φ_S without an explicit
            volume label.
          </p>
        </div>
        <div class="method-beat">
          <span class="beat-marker">02</span>
          <p>
            <strong>M1 coverage</strong> counts entities with at least one <code>m1_strict</code> ledger
            observation, filtered to topology, over denominator <strong>199</strong>. Forbidden stale
            denoms (196/197/…) are never used.
          </p>
        </div>
        <div class="method-beat">
          <span class="beat-marker">03</span>
          <p>
            <strong>Accuracy</strong> uses Host prediction resolutions with TRUE/FALSE outcomes only
            (VOID excluded). A percentage is shown only when assessable n ≥ 5 — thin samples stay as
            raw n, not a fake 100%.
          </p>
        </div>
        <div class="method-beat">
          <span class="beat-marker">04</span>
          <p>
            <strong>Report “vault@publish” badges</strong> count trimmed cycle-vault rows present when
            that report was published — not lifetime M1 observations. See Signal Reports tooltips.
          </p>
        </div>
      </div>
    </div>

    <div class="verify-strip">
      <div class="verify-item">
        <div class="verify-label">Settlement Contract</div>
        <div class="verify-value">0x3A2d6599d5409c1A87609c38dB9b1619e47F6b02</div>
      </div>
      <div class="verify-item">
        <div class="verify-label">Chain</div>
        <div class="verify-value">Base Mainnet (8453)</div>
      </div>
      <div class="verify-item">
        <div class="verify-label">On-Chain Commit</div>
        <div class="verify-value"><a href={`${base}onchain/`}>On-Chain Proof Index</a></div>
      </div>
      <div class="verify-item">
        <div class="verify-label">Methodology</div>
        <div class="verify-value"><a href={`${base}METHODOLOGY.md`}>METHODOLOGY.md</a></div>
      </div>
      <div class="verify-item">
        <div class="verify-label">SoT stamp</div>
        <div class="verify-value">{fmtUtc(generatedAt)}</div>
      </div>
    </div>
  </div>

  <Footer
    variant="minimal"
    note="Numbers baked from engine SoT (public/field-state.json). Not financial advice."
  />

  <script>
    import { initReveal } from '../../scripts/reveal';
    initReveal({ selector: '.stat-hero, .stat-chart' });
    initReveal({ selector: '.stat-card-sm' });
    initReveal({ selector: '.method-beat' });
  </script>
</Layout>
