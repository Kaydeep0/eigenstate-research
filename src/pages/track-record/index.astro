---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { loadSot, formatNum, ptSparklinePoints } from '../../lib/sot';
import {
  PREDICTION_OUTCOMES,
  outcomeKind,
  outcomeLabel,
} from '../../lib/predictionOutcomes';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const sot = loadSot();
const field = sot.field;
const cov = sot.coverage;
const sb = sot.predictions_scoreboard;
const series = sot.pt_kappa_series || [];
const spark = ptSparklinePoints(series);
const base = import.meta.env.BASE_URL;

const kappa = field.kappa;
const pt = field.protocol_truth ?? field.PT;
const generatedAt = sot.generated_at;
const parkashAt = sot.sources.parkash_last_parkash_at;

const accuracyLabel =
  sb.accuracy_pct != null
    ? `${sb.accuracy_pct}%`
    : sb.n_assessable === 0
      ? 'n/a'
      : `n=${sb.n_assessable}`;

const accuracyNote =
  sb.accuracy_pct != null
    ? `${sb.n_true} of ${sb.n_assessable} assessable TRUE`
    : sb.n_assessable === 0
      ? 'No assessable scored claims yet (need n ≥ 5 for a rate)'
      : `${sb.n_true} TRUE / ${sb.n_false} FALSE · assessable n too thin for a %`;

const seriesStart = series[0]?.t_close?.slice?.(0, 10) || '';
const seriesEnd = series[series.length - 1]?.t_close?.slice?.(0, 10) || '';

function fmtUtc(iso: string | null | undefined): string {
  if (!iso) return 'n/a';
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toISOString().replace('T', ' ').replace(/\.\d+Z$/, ' UTC');
}

function resolveHref(pathOrUrl: string | undefined): string | null {
  if (!pathOrUrl) return null;
  if (pathOrUrl.startsWith('http')) return pathOrUrl;
  return `${base}${pathOrUrl.replace(/^\//, '')}`;
}

const resolvedRows = (sb.resolved || []).map((row) => {
  const id = row.prediction_id || '';
  const meta = PREDICTION_OUTCOMES[id];
  const kind = outcomeKind(row);
  return { row, id, meta, kind, label: outcomeLabel(kind) };
});
---

<Layout
  title="Host Claim Register · Eigenstate Research"
  description="Verifiable Host prediction register: scored claims with deadlines, honest assessable counts, and live engine SoT. Public falsifiability, not marketing accuracy."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 56px 40px 60px;
      }

      @media (width <= 640px) {
        .container {
          padding: 40px 20px;
        }
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .page-title {
        font-family: var(--font-heading);
        font-size: clamp(26px, 3.2vw, 40px);
        font-weight: 800;
        letter-spacing: 0.04em;
        margin-bottom: 12px;
      }

      .page-sub {
        color: var(--text-secondary);
        font-size: var(--text-base);
        margin-bottom: 28px;
        max-width: 720px;
        line-height: 1.65;
      }

      .panel {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 20px 22px;
        margin-bottom: 20px;
        background: var(--bg-card, transparent);
      }

      .panel.explain {
        border-color: rgb(47 90 99 / 30%);
        background: rgb(47 90 99 / 6%);
      }

      .panel.engine {
        border-color: var(--border);
        background: transparent;
      }

      .panel-title {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 12px;
      }

      .panel p,
      .readout p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.65;
        margin-bottom: 10px;
      }

      .panel p:last-child,
      .readout p:last-child {
        margin-bottom: 0;
      }

      .panel strong {
        color: var(--text-primary);
        font-weight: 600;
      }

      .readout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 28px;
      }

      @media (width <= 720px) {
        .readout {
          grid-template-columns: 1fr;
        }
      }

      .readout-card {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 18px 20px;
        background: var(--bg-card);
      }

      .readout-card h3 {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-primary);
        margin-bottom: 10px;
      }

      .outcome-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .outcome-list li {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.55;
      }

      .outcome-list strong {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        color: var(--text-primary);
      }

      .metrics-row {
        display: flex;
        flex-wrap: wrap;
        gap: 24px 32px;
      }

      .metric {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 100px;
      }

      .metric-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .metric-value {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
      }

      .metric-value.cyan {
        color: var(--signal);
      }

      .metric-value.thin {
        color: var(--status-warning);
      }

      .metric-note {
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      .panel-note {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.55;
        margin-top: 14px;
      }

      .hero-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 20px;
        margin-top: 14px;
      }

      .hero-links a,
      .inline-link {
        color: var(--signal);
        text-decoration: none;
        font-size: var(--text-sm);
      }

      .hero-links a:hover,
      .inline-link:hover {
        text-decoration: underline;
      }

      .pt-sparkline {
        display: block;
        width: 100%;
        max-width: 320px;
        height: auto;
        margin-top: 10px;
      }

      .sot-stamp {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: 10px;
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        text-transform: uppercase;
        margin: 40px 0 16px;
      }

      .claim-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .claim-card {
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        padding: 20px 22px;
        background: var(--bg-card);
      }

      .claim-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 14px;
        margin-bottom: 10px;
      }

      .claim-title {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 700;
        color: var(--text-primary);
        flex: 1 1 220px;
      }

      .claim-id {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }

      .status::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentcolor;
        flex-shrink: 0;
      }

      .status-false {
        color: var(--status-error);
      }

      .status-true {
        color: var(--status-success);
      }

      .status-void {
        color: var(--text-muted);
      }

      .status-partial {
        color: var(--status-warning);
      }

      .claim-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: 10px;
      }

      .claim-body {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.65;
        margin-bottom: 8px;
      }

      .claim-why {
        font-size: var(--text-sm);
        color: var(--text-primary);
        line-height: 1.65;
        margin-top: 8px;
      }

      .claim-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 18px;
        margin-top: 12px;
      }

      .empty-note {
        padding: 28px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        text-align: center;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
      }

      .open-summary {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 20px 22px;
        background: var(--bg-card);
      }

      .open-summary .big {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 6px;
      }

      .method-block {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 28px;
        margin-top: 8px;
      }

      .method-block h3 {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 16px;
        color: var(--text-secondary);
        text-transform: uppercase;
      }

      .method-beats {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .method-beat {
        display: grid;
        grid-template-columns: 32px 1fr;
        gap: 14px;
        align-items: start;
      }

      .method-beat .beat-marker {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--accent-dark);
        letter-spacing: 0.05em;
        padding-top: 2px;
      }

      .method-block p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
      }

      .method-block code {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal);
        background: rgb(47 90 99 / 8%);
        padding: 2px 6px;
        border-radius: var(--radius-sm);
      }

      .sources-panel,
      .for-agents {
        margin-top: 36px;
      }

      .section-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 14px;
      }

      .sources-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .sources-list a {
        color: var(--signal);
        text-decoration: none;
        font-size: var(--text-sm);
      }

      .sources-list a:hover {
        text-decoration: underline;
      }

      .for-agents details {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 12px 16px;
        color: var(--text-muted);
        font-size: var(--text-sm);
      }

      .for-agents summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .agent-body {
        margin-top: 14px;
        color: var(--text-secondary);
        line-height: 1.65;
      }

      .agent-body ul {
        margin: 8px 0 0 18px;
      }

      .agent-body a {
        color: var(--signal);
        word-break: break-all;
      }

      .agent-body code {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
      }
    </style>
  </Fragment>

  <Nav active="track-record" />

  <div class="container" id="main">
    <div class="eyebrow">Eigenstate Research · Host claim register</div>
    <h1 class="page-title">Prediction track record</h1>
    <p class="page-sub">
      Verifiable Host claims with deadlines, scored when the window closes. This page is a
      public falsifiability register for Protocol Truth honesty, not a finished accuracy
      brochure.
    </p>

    <div class="panel explain">
      <div class="panel-title">Why this page exists</div>
      <p>
        Predictions are <strong>Host claims with deadlines</strong> so the engine can score
        calibration and Protocol Truth honesty. Publishing them makes the board falsifiable
        in public. Most rows are still open: {sb.n_open} of {sb.n_total} Host predictions
        have not resolved yet. The board is a <strong>register</strong>, not a completed
        track record.
      </p>
      <p>
        Accuracy percent is gated at assessable n ≥ 5 so a thin sample cannot fake 100%.
        Right now: {accuracyNote}.
      </p>
    </div>

    <div class="readout">
      <div class="readout-card">
        <h3>How to read outcomes</h3>
        <ul class="outcome-list">
          <li>
            <strong>FALSE</strong>
            The claim failed its resolution criteria by the deadline. No spin.
          </li>
          <li>
            <strong>VOID</strong>
            The claim could not be scored as written (broken presupposition or unresolvable
            leg). Excluded from assessable TRUE/FALSE n.
          </li>
          <li>
            <strong>PARTIAL</strong>
            At least one leg resolved and at least one leg remains open or untestable. Not
            a single TRUE/FALSE; excluded from assessable n.
          </li>
          <li>
            <strong>OPEN</strong>
            Deadline has not produced a Host-executed close yet.
          </li>
        </ul>
      </div>
      <div class="readout-card">
        <h3>Assessable scoreboard</h3>
        <div class="metrics-row" style="margin-bottom: 12px;">
          <div class="metric">
            <div class="metric-label">Assessable</div>
            <div class={`metric-value ${sb.accuracy_pct == null ? 'thin' : ''}`}>{accuracyLabel}</div>
            <div class="metric-note">{accuracyNote}</div>
          </div>
          <div class="metric">
            <div class="metric-label">Host register</div>
            <div class="metric-value">{sb.n_total}</div>
            <div class="metric-note">{sb.n_open} open · {sb.n_resolved} resolved</div>
          </div>
        </div>
        <p>
          Assessable means resolved with a TRUE or FALSE outcome only. VOID and PARTIAL do
          not enter the percentage numerator or denominator.
        </p>
      </div>
    </div>

    <aside class="panel engine" aria-label="Engine state at stamp">
      <div class="panel-title">Engine state at stamp (not prediction outcomes)</div>
      <div class="metrics-row">
        <div class="metric">
          <div class="metric-label">Protocol Truth</div>
          <div class="metric-value cyan">{formatNum(pt, 4)}</div>
          <div class="metric-note">act threshold {formatNum(field.canonical_act_threshold, 3)}</div>
        </div>
        <div class="metric">
          <div class="metric-label">Coherence (κ)</div>
          <div class="metric-value">{formatNum(kappa, 4)}</div>
          <div class="metric-note">HOST κ at last stamp</div>
        </div>
        <div class="metric">
          <div class="metric-label">M1 coverage</div>
          <div class="metric-value cyan">{cov.headline}</div>
          <div class="metric-note">{cov.m1_strict_pct}% · m1_strict ledger</div>
        </div>
        <div class="metric">
          <div class="metric-label">M1 confirmed</div>
          <div class="metric-value">{cov.m1_confirmed_n} / {cov.m1_denominator}</div>
          <div class="metric-note">confirmed subset of strict</div>
        </div>
      </div>
      {
        spark.points ? (
          <svg width="300" height="60" viewBox="0 0 300 60" class="pt-sparkline" aria-label="PT series">
            <polyline
              points={spark.points}
              fill="none"
              stroke="#2f5a63"
              stroke-width="1.5"
              stroke-linejoin="round"
              opacity="0.8"
            ></polyline>
            {seriesStart && (
              <text x="2" y="58" font-size="9" fill="#71717a" font-family="JetBrains Mono">
                {seriesStart}
              </text>
            )}
            {seriesEnd && (
              <text
                x="298"
                y="58"
                font-size="9"
                fill="#71717a"
                font-family="JetBrains Mono"
                text-anchor="end"
              >
                {seriesEnd}
              </text>
            )}
          </svg>
        ) : null
      }
      <p class="panel-note">
        These tiles are live field metrics from the GeniusFlow engine stamp
        (<code>public/field-state.json</code>). They describe measurement state at parkash,
        not whether a Host claim hit or missed.
      </p>
      <div class="hero-links">
        <a href={`${base}methodology/#glossary`}>Numbers glossary</a>
        <a href={`${base}methodology/`}>Methodology</a>
        <a href={`${base}predictions/`}>Claim detail cards</a>
      </div>
      <div class="sot-stamp">
        Stamp {fmtUtc(generatedAt)} · last parkash {fmtUtc(parkashAt)}
      </div>
    </aside>

    <div class="section-title" id="resolved">Resolved claims</div>
    <div class="claim-list">
      {
        resolvedRows.length > 0 ? (
          resolvedRows.map(({ row, id, meta, kind, label }) => {
            const statusClass =
              kind === 'TRUE'
                ? 'status-true'
                : kind === 'FALSE'
                  ? 'status-false'
                  : kind === 'RESOLVED_PARTIAL'
                    ? 'status-partial'
                    : 'status-void';
            const detail = resolveHref(meta?.detailHref);
            return (
              <article class="claim-card" id={id}>
                <div class="claim-top">
                  <h2 class="claim-title">{meta?.title || id}</h2>
                  <span class={`status ${statusClass}`}>{label}</span>
                </div>
                <div class="claim-id">{id}</div>
                <div class="claim-meta">
                  Deadline {row.deadline || 'n/a'}
                  {' · '}
                  Resolved {row.resolved_at ? String(row.resolved_at).slice(0, 10) : 'n/a'}
                  {' · '}
                  Calibration weight {row.calibration_weight ?? 'n/a'}
                </div>
                {meta?.claim && <p class="claim-body">{meta.claim}</p>}
                {meta?.why ? (
                  <p class="claim-why">{meta.why}</p>
                ) : (
                  <p class="claim-why">
                    Outcome recorded in SoT scoreboard. See Host prediction register for the
                    resolution record.
                  </p>
                )}
                <div class="claim-links">
                  {detail && <a class="inline-link" href={detail}>Claim detail</a>}
                  {(meta?.evidence || []).map((e) => (
                    <a class="inline-link" href={e.href} target="_blank" rel="noopener noreferrer">
                      {e.label}
                    </a>
                  ))}
                </div>
              </article>
            );
          })
        ) : (
          <p class="empty-note">No resolved Host claims in this SoT stamp.</p>
        )
      }
    </div>

    <div class="section-title" id="open">Open claims</div>
    <div class="open-summary">
      <div class="big">{sb.n_open} open</div>
      <p class="claim-body">
        Of {sb.n_total} Host predictions in the register, {sb.n_open} remain open and
        {` ${sb.n_resolved} `}have a Host-executed close (including VOID and PARTIAL). Early
        gap-prediction claim cards (human prose + on-chain commit) live on the
        <a class="inline-link" href={`${base}predictions/`}> Predictions</a> page. The full
        scored register is this Track Record surface, rebuilt from engine SoT.
      </p>
    </div>

    <div class="section-title">Why we publish predictions</div>
    <div class="method-block">
      <h3>Method (scoreboard rules)</h3>
      <div class="method-beats">
        <div class="method-beat">
          <span class="beat-marker">01</span>
          <p>
            <strong>Falsifiability first.</strong> Each Host claim names an observable
            condition and a deadline. The point is calibration honesty for Protocol Truth,
            not marketing win-rate theater.
          </p>
        </div>
        <div class="method-beat">
          <span class="beat-marker">02</span>
          <p>
            <strong>Thin-n gate.</strong> Accuracy % appears only when assessable n ≥ 5
            (TRUE/FALSE only; VOID excluded). Below that threshold we show raw counts so a
            sample of one cannot read as 0% or 100% certainty.
          </p>
        </div>
        <div class="method-beat">
          <span class="beat-marker">03</span>
          <p>
            <strong>Register, not finished ledger.</strong> {sb.n_open} claims are still
            open. Resolved rows here are Host-executed closes from the prediction register
            stamped into <code>field-state.json</code>.
          </p>
        </div>
        <div class="method-beat">
          <span class="beat-marker">04</span>
          <p>
            <strong>Field metrics are separate.</strong> PT, κ, and M1 coverage describe
            engine measurement state. They are not prediction outcomes. Φ_S is settlement
            pressure (E = ΔI / A), not INFRA_FLOW volume.
          </p>
        </div>
      </div>
    </div>

    <div class="sources-panel">
      <div class="section-label">Sources &amp; human pages</div>
      <div class="sources-list">
        <a href={`${base}predictions/`}>Predictions · claim detail cards</a>
        <a href={`${base}methodology/#glossary`}>Numbers glossary</a>
        <a href={`${base}methodology/`}>Full methodology</a>
        <a href={`${base}onchain/`}>On-chain proof index</a>
        <a href={`${base}verify-walkthrough/`}>Verify walkthrough</a>
        <a href="https://www.federalreserve.gov/releases/h41/">Federal Reserve H.4.1</a>
        <a href="https://www.nseindia.com/">NSE India</a>
        <a href="https://www.sebi.gov.in/">SEBI</a>
      </div>
    </div>

    <div class="for-agents">
      <details>
        <summary>For agents (machine JSON)</summary>
