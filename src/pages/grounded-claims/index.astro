---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import corpus from '../../data/grounded_claims.json';
import { ledgerDeltaLine } from '../../lib/ledgerContext';
import { datasetJsonLd, dateOnly } from '../../lib/siteSeo';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;

interface Corpus {
  generated_at: string;
  digest: string;
  expectations_digest: string;
  expectations_generated_at: string;
  probe_version: string;
  subject: { what: string; engine_commit: string; claim_source: string };
  claims_in_corpus: number;
  ledger_rows_behind_them: number;
  must_admit: number;
  must_refuse: number;
  full_admit: number;
  full_refuse: number;
  still_grounded_at_cited_url: number;
  grounded_in_visible_text: number;
  citations_that_are_primary_filings: number;
  machine_readable_sources: number;
  ledger_rows_agree: number;
  ledger_rows_disagree: number;
  full_text_index_exists: number;
  full_text_index_answered: number;
  independently_corroborated_by_a_filing: number;
  corroborated_by_the_regulator_itself: number;
  filing_documents_fetched: number;
  refuse_limb_counts: Record<string, number>;
  refusal_attribution: Record<string, number>;
  by_regulator: Record<string, { claims: number; must_admit: number; full_admit: number }>;
  limb_order_frozen: string[];
  limb_chains: Record<string, string[]>;
  limb_chain_rule: string;
  limb_spec_level: Record<string, string>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  pre_freeze_observations: {
    observed: string;
    why_it_is_here: string;
    effect_on_predictions: string;
  }[];
  probe_defects_fixed_before_publication: { defect: string; effect: string; fix: string }[];
  predictions_scored: {
    id: number;
    prediction: string;
    blind: boolean;
    observed: string;
    met: boolean;
  }[];
  per_claim: {
    claim_key: string;
    entity: string;
    regulator: string;
    headline: string;
    expected: string;
    must_admit: boolean;
    full_admit: boolean;
    refuse_reason: string | null;
    attribution: string;
    receipt: string;
    reproduce: string;
  }[];
  prior_art: { work: string; url: string; relation: string }[];
  not_claimed: string[];
}

const c = corpus as unknown as Corpus;
const n = c.claims_in_corpus;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function chainOf(limb: string): string {
  const hit = Object.entries(c.limb_chains).find(([, members]) => members.includes(limb));
  return hit ? hit[0] : '';
}

const refuseRate = `${((100 * c.must_refuse) / n).toFixed(1)}%`;
const delta = ledgerDeltaLine('grounded-claims');
const refuseRows = Object.entries(c.refuse_limb_counts).sort((a, b) => b[1] - a[1]);
const attributionRows = Object.entries(c.refusal_attribution).sort((a, b) => b[1] - a[1]);
const regulatorRows = Object.entries(c.by_regulator);
const subjects = [...c.per_claim].sort((a, b) => {
  if (a.must_admit !== b.must_admit) return a.must_admit ? 1 : -1;
  return a.claim_key.localeCompare(b.claim_key);
});
const firstReproduce = c.per_claim[0]?.reproduce ?? '';
---

<Layout
  title="Grounded claim corpus · Eigenstate Research"
  description="Every SEC and Federal Reserve claim this node publishes, rechecked against what those URLs serve today and against the free EDGAR full text index."
  fonts={fonts}
>
  <Fragment slot="head">
    <JsonLd
      data={datasetJsonLd({
        name: 'Grounded claim corpus',
        description:
          'Every SEC and Federal Reserve claim this node publishes, rechecked against what those URLs serve today and against the free EDGAR full text index. This node corpus, not a sector rate.',
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        datePublished: dateOnly(c.generated_at),
        creator: 'geniusflow',
        about: 'SEC and Federal Reserve grounded claims on this node',
      })}
    />
  </Fragment>
  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="rank-hero" id="main">
    <div class="eyebrow">Grounded claims · read-only · expectations first</div>
    <h1>A citation is not a check</h1>
    <p class="lede">
      Every regulator-grounded claim on this node, re-read today. Named refusal limb per claim, and
      who the refusal belongs to. The whole corpus, not a sample.
    </p>
    <div class="rank-primary">
      <div class="rate">{refuseRate}</div>
      <div class="rate-label">
        MUST refuse rate · {c.must_refuse} of {n} claims · {c.still_grounded_at_cited_url} still
        grounded at the cited URL
      </div>
    </div>
    {delta && <p class="rank-delta">{delta}</p>}
  </div>

  <section class="rank-wrap">
    <div class="rank-runline">
      Corpus {n} claims / {c.ledger_rows_behind_them} ledger rows · engine{' '}
      <code>{c.subject.engine_commit?.slice(0, 12)}</code> · run {formatDate(c.generated_at)} ·
      digest <code>{c.digest.slice(0, 16)}</code>
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th>Claim</th>
            <th>Entity</th>
            <th>Verdict</th>
            <th>Refuse reason</th>
            <th>Attribution</th>
            <th>Receipt</th>
          </tr>
        </thead>
        <tbody>
          {
            subjects.map((r) => (
              <tr>
                <td class="subject">{r.claim_key}</td>
                <td>{r.entity}</td>
                <td class:list={['verdict', r.must_admit ? 'is-admit' : 'is-refuse']}>
                  {r.must_admit ? 'admit' : 'refuse'}
                </td>
                <td>{r.refuse_reason ?? 'no refuse'}</td>
                <td>{r.attribution}</td>
                <td>
                  <a href={r.receipt} rel="noopener">
                    json
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="rank-footer">
      <p class="honesty">
        Not a judgement about whether any claim is true · not a survey of regulator practice · the
        first refusal found is against this node
      </p>

      <h2>How to cite / re-check</h2>
      <div class="links-row">
        <a href={`${fed}/grounded-claims/expectations.json`} rel="noopener">expectations.json</a>
        <a href={`${fed}/grounded-claims/ledger.json`} rel="noopener">ledger.json</a>
        <a href={`${fed}/grounded-claims/summary.json`} rel="noopener">summary.json</a>
        <a href={`${fed}/grounded-claims/index.json`} rel="noopener">index.json</a>
        <a href={`${fed}/grounded-claims/README.md`} rel="noopener">README.md</a>
      </div>
      {firstReproduce && <pre class="cmd">{firstReproduce}</pre>}

      <h2>By regulator</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Regulator</th><th class="n">Claims</th><th class="n">MUST clear</th><th class="n"
                >Full clear</th
              >
            </tr>
          </thead>
          <tbody>
            {
              regulatorRows.map(([name, row]) => (
                <tr>
                  <td>{name}</td>
                  <td class="n">{row.claims}</td>
                  <td class="n">{row.must_admit}</td>
                  <td class="n">{row.full_admit}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Where they refuse</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Strongest failing limb</th><th class="n">Claims</th></tr>
          </thead>
          <tbody>
            {
              refuseRows.map(([limb, count]) => (
                <tr>
                  <td>{limb}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Who the refusal belongs to</th><th class="n">Claims</th></tr>
          </thead>
          <tbody>
            {
              attributionRows.map(([who, count]) => (
                <tr>
                  <td>{who}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Limbs</h2>
      <p>{c.limb_chain_rule}</p>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Limb</th><th>Chain</th><th>Level</th><th class="n">ok</th><th class="n">fail</th
              ><th class="n">not reached</th>
            </tr>
          </thead>
          <tbody>
            {
              c.limb_order_frozen.map((limb) => (
                <tr>
                  <td>{limb}</td>
                  <td>{chainOf(limb)}</td>
                  <td>{c.limb_spec_level[limb]}</td>
                  <td class="n">{c.limb_outcomes[limb].ok}</td>
                  <td class="n">{c.limb_outcomes[limb].fail}</td>
                  <td class="n">{c.limb_outcomes[limb].not_reached}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Predictions</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Prediction</th><th>Observed</th><th>Result</th><th>Blind</th></tr>
          </thead>
          <tbody>
            {
              c.predictions_scored.map((row) => (
                <tr>
                  <td>{row.prediction}</td>
                  <td>{row.observed}</td>
                  <td class="verdict">{row.met ? 'met' : 'missed'}</td>
                  <td class="verdict">{row.blind ? 'yes' : 'no'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Prior art</h2>
      <ul>
        {
          c.prior_art.map((item) => (
            <li>
              <a href={item.url} rel="noopener">
                {item.work}
              </a>
              : {item.relation}
            </li>
          ))
        }
      </ul>

      <h2>Re-run</h2>
      <pre class="cmd">PYTHONPATH=engine python3 engine/tools/grounded_claim_run.py expect
PYTHONPATH=engine python3 engine/tools/grounded_claim_run.py run
PYTHONPATH=engine python3 engine/tools/grounded_claim_export.py</pre>

      <h2>What this is not</h2>
      <ul>
        {c.not_claimed.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
