---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import ResearchSurfaces from '../../components/ResearchSurfaces.astro';
import { ORIGIN_SEATS, ORIGIN_LINEAGE } from '../../lib/originPattern';
import { webpageJsonLd } from '../../lib/siteSeo';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fieldAt = (id: string | null) => (id ? `${base}field/?focus=${id}` : null);
---

<Layout
  title="Origin · Circle, Tether, and the VOC product · Eigenstate Research"
  description="Circle and Tether are this wave's names for a VOC-era product: an issuer of the claim and a custodian of sovereign paper, from the 1602 charter to USDC and USDT on Treasuries."
  fonts={fonts}
>
  <Fragment slot="head">
    <JsonLd
      data={webpageJsonLd({
        name: 'Origin · Circle, Tether, and the VOC product',
        description:
          "Circle and Tether are this wave's names for a VOC-era product: an issuer of the claim and a custodian of sovereign paper, from the 1602 charter to USDC and USDT on Treasuries.",
        url: new URL(Astro.url.pathname, Astro.site).toString(),
      })}
    />
  </Fragment>
  <Fragment slot="head">
    <style>
      .origin-hero {
        padding: 48px 40px 28px;
        background: var(--bg2);
        border-bottom: 1px solid var(--border);
      }

      .origin-inner {
        max-width: 1080px;
        margin: 0 auto;
      }

      .origin-kicker {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--signal);
        margin: 0 0 10px;
      }

      .origin-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 700;
        margin: 0 0 12px;
        letter-spacing: 0.02em;
      }

      .origin-lead {
        max-width: 72ch;
        color: var(--text-secondary);
        font-size: var(--text-base);
        line-height: 1.55;
        margin: 0;
      }

      .origin-section a,
      .origin-close a,
      .origin-caption a,
      .origin-lead a {
        color: var(--signal);
      }

      .origin-body {
        max-width: 1080px;
        margin: 0 auto;
        padding: 28px 40px 64px;
      }

      .origin-section {
        margin: 0 0 48px;
      }

      .origin-section h2 {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        margin: 0 0 8px;
      }

      .origin-section p {
        color: var(--text-secondary);
        line-height: 1.55;
        max-width: 72ch;
        margin: 0 0 14px;
      }

      .origin-caption {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        margin: 8px 0 0;
        line-height: 1.45;
        max-width: 80ch;
      }

      .origin-figure {
        margin: 16px 0 8px;
      }

      .origin-figure img {
        width: 100%;
        max-width: 920px;
        height: auto;
        display: block;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: #fff;
      }

      .seat-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
      }

      .seat-table th,
      .seat-table td {
        text-align: left;
        padding: 10px 12px 10px 0;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
      }

      .seat-table th {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 500;
      }

      .seat-table a {
        color: var(--signal);
      }

      .lineage {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
      }

      .lineage a {
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 6px 10px;
        border: 1px solid var(--border);
        background: var(--bg2);
        color: var(--signal);
        text-decoration: none;
      }

      .origin-close {
        border-top: 1px solid var(--border);
        padding-top: 24px;
      }

      .origin-close p:last-child {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      @media (width <= 700px) {
        .origin-hero,
        .origin-body {
          padding-left: 16px;
          padding-right: 16px;
        }
      }
    </style>
  </Fragment>

  <Nav active="origin" />

  <header class="origin-hero">
    <div class="origin-inner" id="main">
      <p class="origin-kicker">400-year pattern</p>
      <h1>Circle and Tether are this wave's names for a VOC-era product</h1>
      <p class="origin-lead">
        Hold one object: Power(N+1) = Power(N) × (Capital × Information × Infrastructure).
        Concentration is one wave's pile. Compounding is that pile writing the next charter.
      </p>
      <ResearchSurfaces current="origin" />
      <p class="origin-lead">
        This page is historical interpretation, not a field report.
        Host essays: <a href={`${base}money-in-motion/`}>Money in Motion</a>
        · Maintained CIRCLE state: <a href={`${base}state/`}>/state/</a>
        · Dated machine reports: <a href={`${base}reports/`}>Signal reports</a>
      </p>
    </div>
  </header>

  <div class="origin-body">
    <section class="origin-section">
      <h2>Two seats, changing names</h2>
      <p>
        In other words: the product keeps an issuer of the claim and a custodian of the sovereign
        paper. In 1602 one company sat in both chairs. In 2026 two issuers sit in the claim
        chair. Circle issues USDC; BlackRock manages the reserve fund; BNY holds the bills.
        Tether issues USDT. Cantor Fitzgerald sits on that Treasury custody rail.
      </p>
      <table class="seat-table">
        <thead>
          <tr>
            <th>Year</th>
            <th>Wrapper</th>
            <th>Issuer</th>
            <th>Custodian / intermediary</th>
          </tr>
        </thead>
        <tbody>
          {
            ORIGIN_SEATS.map((row) => {
              const issuerHref = fieldAt(row.issuerId);
              const custLinks = row.custodianIds.map((id) => (
                <a href={fieldAt(id)}>{id.replace(/_/g, ' ')}</a>
              ));
              return (
                <tr>
                  <td>{row.year}</td>
                  <td>{row.wrapper}</td>
                  <td>
                    {issuerHref ? <a href={issuerHref}>{row.issuerName}</a> : row.issuerName}
                  </td>
                  <td>
                    {custLinks.length ? (
                      <>
                        {row.custodianName}
                        <br />
                        {custLinks.map((el, i) => (
                          <>
                            {i > 0 ? ' · ' : ''}
                            {el}
                          </>
                        ))}
                      </>
                    ) : (
                      row.custodianName
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </section>

    <section class="origin-section">
      <h2>How the pile writes the next charter</h2>
      <p>
        Dated beat, 1868-1913. The government subsidized the railroads. Rockefeller bought the
        rebate. Refining concentrated. The same family line sat at Jekyll Island and at National
        City Bank.
      </p>
      <figure class="origin-figure">
        <img
          src={`${base}origin/layerN_rockefeller_case.png`}
          alt="Rockefeller case: railroad rebates, refining concentration, then the same family line at Jekyll Island and National City Bank."
        />
      </figure>
      <p class="origin-caption">
        One mechanism: capture the rail, then design the next one. Open
        <a href={fieldAt('STANDARD_OIL')}>STANDARD OIL</a>
        and
        <a href={fieldAt('JEKYLL_ISLAND')}>JEKYLL ISLAND</a>
        on Field.
      </p>
    </section>

    <section class="origin-section">
      <h2>Concentration after the reset fails</h2>
      <p>
        The S&amp;P 500 Top 10 share rose and fell for a century. Antitrust and failure cut waves
        down. After 2008 that reset failed. The last leg on the figure is the steepest climb in
        the series, labeled near 40 percent.
      </p>
      <figure class="origin-figure">
        <img
          src={`${base}origin/concentration_timeline.png`}
          alt="150 years of S&P 500 Top 10 market-cap share, railroad era through the 2025 peak labeled near 40 percent."
        />
      </figure>
      <p class="origin-caption">
        Sources on the figure: Finaeon, Visual Capitalist, Goldman Sachs. Index concentration,
        1875-2025. 2008 sits inside the last rise.
      </p>
    </section>

    <section class="origin-section">
      <h2>This wave's Treasury rail</h2>
      <p>
        Primary dealers see Treasury liquidity first. In 2020 that proximity showed up as Mag 7
        returning 65.8 percent against 16.3 percent for the S&amp;P 500, as labeled. The 2026
        wrappers on that same Treasury rail are USDC (Circle, BlackRock, BNY) and USDT (Tether,
        Cantor Fitzgerald).
      </p>
      <figure class="origin-figure">
        <img
          src={`${base}origin/2020_liquidity_capture.png`}
          alt="2020 liquidity capture: Magnificent 7 65.8 percent versus S&P 500 16.3 percent versus S&P excluding Mag 7 1.8 percent."
        />
      </figure>
      <p class="origin-caption">
        Proximity to the rail in 2020. The seats on that rail today:
        <a href={fieldAt('CIRCLE')}>CIRCLE</a>
        ·
        <a href={fieldAt('BLACKROCK')}>BLACKROCK</a>
        ·
        <a href={fieldAt('BNY_MELLON')}>BNY MELLON</a>
        ·
        <a href={fieldAt('TETHER')}>TETHER</a>
        ·
        <a href={fieldAt('CANTOR_FITZGERALD')}>CANTOR FITZGERALD</a>.
      </p>
      <div class="lineage">
        {
          ORIGIN_LINEAGE.map((n) => (
            <a href={fieldAt(n.id)} title={n.note}>
              {n.id.replace(/_/g, ' ')}
            </a>
          ))
        }
      </div>
    </section>

    <section class="origin-section origin-close">
      <h2>The key point is compounding</h2>
      <p>
        Falsifier: a rail built by outsiders, with inherited books decaying, would break the
        product. VOC, Standard Oil, the TARP names, and the 2020 rail seats inherited the last
        book and designed the next one. Methodology:
        <a href={`${base}methodology/`}>how we measure now</a>.
      </p>
      <p>
        Field is this wave. Origin is why those nodes exist. Live map:
        <a href={`${base}field/`}>/field/</a>
        · Circle:
        <a href={`${base}field/?focus=CIRCLE`}>?focus=CIRCLE</a>
        · Tether:
        <a href={`${base}field/?focus=TETHER`}>?focus=TETHER</a>
        · VOC has no live dossier.
      </p>
    </section>
  </div>

  <Footer variant="full" />
</Layout>
