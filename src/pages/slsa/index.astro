---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import census from '../../data/slsa_provenance.json';
import { ledgerDeltaLine } from '../../lib/ledgerContext';
import fs from 'node:fs';
import path from 'node:path';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const fed = 'https://geniusflow-federation.vercel.app';
const requestAccess = `${base}request-access/`;
const pep740 = 'https://peps.python.org/pep-0740/';
const slsaSpec = 'https://slsa.dev/spec/v1.0/provenance';

interface Census {
  generated_at: string;
  digest: string;
  expectations_digest: string;
  expectations_generated_at: string;
  subject: {
    requirements_file: string;
    requirements_sha256: string;
    engine_commit: string;
    python: string;
    platform: string;
  };
  expectation_count: number;
  must_admit: number;
  must_refuse: number;
  full_admit: number;
  full_refuse: number;
  provenance_published_count: number;
  provenance_missing_count: number;
  slsa_build_provenance_count: number;
  bytes_downloaded: number;
  refuse_limb_counts: Record<string, number>;
  top_refuse_reasons: Record<string, number>;
  limb_outcomes: Record<
    string,
    { ok: number; fail: number; not_applicable: number; absent: number; not_reached: number }
  >;
  predicate_types: Record<string, number>;
  predictions_scored: { prediction: string; observed: string; met: boolean }[];
  signer_source_mismatches: {
    package: string;
    declared_on_pypi: string;
    signed_from: string;
  }[];
  self_refusals: {
    package: string;
    declared_line: string;
    reason: string;
    latest_published_on_pypi: string | null;
  }[];
  methodology: {
    limb_order_frozen: string[];
    limb_spec_level: Record<string, string>;
    known_limits: string[];
  };
}

type Receipt = {
  package: string;
  normalized_name: string;
  version: string;
  must_admit: boolean;
  full_admit: boolean;
  first_failing_limb: string | null;
  first_refuse_reason: string | null;
};

const c = census as unknown as Census;
const n = c.expectation_count;
const share = (x: number) => `${((100 * x) / n).toFixed(1)}%`;
const num = (x: number) => x.toLocaleString('en-US');

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

let receipts: Receipt[] = [];
try {
  const raw = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'public', 'slsa', 'ledger.json'), 'utf8')
  ) as { receipts?: Receipt[] };
  receipts = [...(raw.receipts || [])].sort((a, b) => {
    if (a.must_admit !== b.must_admit) return a.must_admit ? 1 : -1;
    return a.normalized_name.localeCompare(b.normalized_name);
  });
} catch {
  receipts = [];
}

const delta = ledgerDeltaLine('slsa', 'must_refuse_rate');
const refuseRows = Object.entries(c.refuse_limb_counts).sort((a, b) => b[1] - a[1]);
const reasonRows = Object.entries(c.top_refuse_reasons).slice(0, 8);
const limbs = c.methodology.limb_order_frozen;
const predicateRows = Object.entries(c.predicate_types);
const refuseRate = share(c.must_refuse);
---

<Layout
  title="Provenance census · Eigenstate Research"
  description="Every distribution this engine installs, checked for a PEP 740 attestation, verified against Sigstore, and then asked whether the attestation is SLSA build provenance."
  fonts={fonts}
>
  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="rank-hero" id="main">
    <div class="eyebrow">PEP 740 · SLSA · census of one install set</div>
    <h1>What the supply chain actually signs</h1>
    <p class="lede">
      Full dependency set of one working engine: attestation present, digest match, signature
      verify, then the separate question of SLSA build provenance. Expectations published first.
    </p>
    <div class="rank-primary">
      <div class="rate">{refuseRate}</div>
      <div class="rate-label">
        MUST refuse rate · {c.must_refuse} of {n} distributions · {share(c.provenance_missing_count)}{' '}
        serve no attestation
      </div>
    </div>
    {delta && <p class="rank-delta">{delta}</p>}
  </div>

  <section class="rank-wrap">
    <div class="rank-runline">
      Subject <code>{c.subject.requirements_file}</code> · engine{' '}
      <code>{c.subject.engine_commit?.slice(0, 12)}</code> · {n} distributions ·{' '}
      {num(c.bytes_downloaded)} bytes hashed · run {formatDate(c.generated_at)} · digest{' '}
      <code>{c.digest.slice(0, 16)}</code>
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th>Package</th>
            <th>Version</th>
            <th>Verdict</th>
            <th>Refuse limb</th>
            <th>Receipt</th>
          </tr>
        </thead>
        <tbody>
          {
            receipts.map((r) => (
              <tr>
                <td class="subject">{r.normalized_name || r.package}</td>
                <td>{r.version}</td>
                <td class:list={['verdict', r.must_admit ? 'is-admit' : 'is-refuse']}>
                  {r.must_admit ? 'admit' : 'refuse'}
                </td>
                <td>{r.first_failing_limb ?? 'no refuse'}</td>
                <td>
                  <a
                    href={`${fed}/slsa/receipts/${r.normalized_name || r.package}.json`}
                    rel="noopener"
                  >
                    json
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); margin: 8px 0 10px;">
      Where they fail first
    </h2>
    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr><th>First failing limb</th><th class="n">Packages</th></tr>
        </thead>
        <tbody>
          {
            refuseRows.map(([limb, count]) => (
              <tr>
                <td>{limb}</td>
                <td class="n">{count}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="rank-footer">
      <p class="honesty">
        A census of one install set, not a sample of PyPI · no badge, no score · an unattested
        package is not an unsafe package · publish attestation is not SLSA build provenance
      </p>

      <h2>How to cite / re-check</h2>
      <div class="links-row">
        <a href={`${base}slsa/expectations.json`}>expectations.json</a>
        <a href={`${base}slsa/summary.json`}>summary.json</a>
        <a href={`${base}slsa/ledger.json`}>ledger.json</a>
        <a href={`${base}slsa/README.md`}>method</a>
        <a href={`${fed}/slsa/index.json`} target="_blank" rel="noopener">per-package index</a>
        <a href={pep740} target="_blank" rel="noopener">PEP 740</a>
        <a href={slsaSpec} target="_blank" rel="noopener">SLSA provenance</a>
      </div>

      <h2>Predicate types</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Verified predicate type</th><th class="n">Packages</th></tr>
          </thead>
          <tbody>
            {
              predicateRows.map(([t, count]) => (
                <tr>
                  <td>{t}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
            <tr>
              <td>https://slsa.dev/provenance/v1</td>
              <td class="n">{c.slsa_build_provenance_count}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Predictions (scored)</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Stated before the run</th><th>Observed</th><th class="n">Verdict</th></tr>
          </thead>
          <tbody>
            {
              c.predictions_scored.map((row) => (
                <tr>
                  <td>{row.prediction}</td>
                  <td>{row.observed}</td>
                  <td class="verdict n">{row.met ? 'met' : 'missed'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Named reasons</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr><th>Limb and reason</th><th class="n">Packages</th></tr>
          </thead>
          <tbody>
            {
              reasonRows.map(([reason, count]) => (
                <tr>
                  <td>{reason}</td>
                  <td class="n">{count}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Every limb</h2>
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Limb</th>
              <th>Level</th>
              <th class="n">ok</th>
              <th class="n">fail</th>
              <th class="n">n/a</th>
              <th class="n">absent</th>
              <th class="n">not reached</th>
            </tr>
          </thead>
          <tbody>
            {
              limbs.map((limb) => (
                <tr>
                  <td>{limb}</td>
                  <td>{c.methodology.limb_spec_level[limb]}</td>
                  <td class="n">{c.limb_outcomes[limb].ok}</td>
                  <td class="n">{c.limb_outcomes[limb].fail}</td>
                  <td class="n">{c.limb_outcomes[limb].not_applicable}</td>
                  <td class="n">{c.limb_outcomes[limb].absent}</td>
                  <td class="n">{c.limb_outcomes[limb].not_reached}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      {
        c.signer_source_mismatches.length > 0 && (
          <>
            <h2>Signer / source mismatches</h2>
            <div class="rank-table-wrap">
              <table class="rank-table">
                <thead>
                  <tr>
                    <th>Package</th>
                    <th>Declared source</th>
                    <th>Signed from</th>
                  </tr>
                </thead>
                <tbody>
                  {c.signer_source_mismatches.map((m) => (
                    <tr>
                      <td>{m.package}</td>
                      <td>{m.declared_on_pypi}</td>
                      <td>{m.signed_from}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      {
        c.self_refusals.length > 0 && (
          <>
            <h2>Self refusals</h2>
            <div class="rank-table-wrap">
              <table class="rank-table">
                <thead>
                  <tr>
                    <th>Declared</th>
                    <th>Reason</th>
                    <th>Latest on PyPI</th>
                  </tr>
                </thead>
                <tbody>
                  {c.self_refusals.map((r) => (
                    <tr>
                      <td>{r.declared_line}</td>
                      <td>{r.reason}</td>
                      <td>{r.latest_published_on_pypi ?? 'not published'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      <h2>Re-run</h2>
      <pre
        class="cmd"
      >{`python3 -m venv .slsa && .slsa/bin/pip install pypi-attestations
.slsa/bin/python engine/tools/slsa_provenance_run.py expect
.slsa/bin/python engine/tools/slsa_provenance_run.py run`}</pre>

      <h2>What this cannot tell you</h2>
      <ul>
        {c.methodology.known_limits.map((l) => <li>{l}</li>)}
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
