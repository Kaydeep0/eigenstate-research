    <!-- Scripts -->
    <script>
      import { BinaryTunnel } from '../scripts/binary-tunnel.js';
      import { ScrollAnimations } from '../scripts/scroll-animations.js';
      import { initNavigation, initMobileNavToggle } from '../scripts/nav';
      import { initMiniCharts, initNetworkCanvas } from '../scripts/mini-charts';

      document.addEventListener('DOMContentLoaded', () => {
        const loadingText = document.getElementById('loadingText');
        if (loadingText) {
          const text = 'INITIALIZING...';
          loadingText.textContent = '';
          let i = 0;
          const typeInterval = setInterval(() => {
            if (i < text.length) {
              loadingText.textContent += text[i];
              i++;
            } else {
              clearInterval(typeInterval);
            }
          }, 25);
        }

        // Hero background: 3D binary corridor
        if (document.getElementById('binary-rain-canvas')) {
          (window as any).binaryTunnel = new BinaryTunnel('binary-rain-canvas');
        }

        (window as any).scrollAnimations = new ScrollAnimations();
        initMiniCharts();
        initNetworkCanvas();
        initNavigation();
        initMobileNavToggle('navToggle', 'navLinks');

        // Runtime refresh of same-origin SoT stamp (keeps tiles tied to field-state.json).
        const sotUrl = `${import.meta.env.BASE_URL}field-state.json`;
        fetch(sotUrl)
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (!d || !d.coverage) return;
            const set = (sel: string, val: string) => {
              document.querySelectorAll(sel).forEach((el) => {
                el.textContent = val;
              });
            };
            const m1 = d.coverage.headline;
            const kap = d.field?.kappa_act ?? d.field?.kappa;
            const kapGraph = d.field?.kappa_graph;
            const ptv = d.field?.protocol_truth ?? d.field?.PT;
            const sb = d.predictions_scoreboard || {};
            const acc =
              sb.accuracy_pct != null
                ? `${sb.accuracy_pct}%`
                : sb.n_assessable > 0
                  ? `n=${sb.n_assessable}`
                  : 'n/a';
            set('[data-sot="m1"]', m1);
            if (ptv != null) set('[data-sot="pt"]', Number(ptv).toFixed(3));
            if (kap != null) set('[data-sot="kappa"]', Number(kap).toFixed(3));
            if (kapGraph != null) set('[data-sot="kappa-graph"]', Number(kapGraph).toFixed(3));
            set('[data-sot="accuracy"]', acc);
            const proofM1 = document.querySelector('.proof-strip .proof-tile:nth-child(1) .engine-tile-value');
            if (proofM1) proofM1.textContent = m1;
          })
          .catch(() => {});
      });
    </script>
