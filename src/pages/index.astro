                                      <span
                                        class="entity-bar-fill"
                                        style={`width:${Math.max(8, Math.round((e.phi_s / maxPhi) * 100))}%;`}
                                      ></span>
                                    </span>
                                    <span class="entity-bar-value">Φ_S {e.phi_s.toFixed(3)}</span>
                                  </div>
                                ))}
                              </div>
                            </section>
                          ) : null}
                        </div>
                      ) : (
                        <p class="pattern-text secondary">Top-Φ_S ranking unavailable in this SoT stamp — re-run refresh-public after parkash.</p>
                      )
                    }
                    <div class="power-law-data">
