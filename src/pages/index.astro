---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { loadSot, formatNum } from '../lib/sot';
import erc8004 from '../data/erc8004_probe.json';

const fonts =
  "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap";

const sot = loadSot();
const m1Headline = sot.coverage.headline;
const m1Pct = sot.coverage.m1_strict_pct;
const kappa = sot.field.kappa;
const kappaGraph = sot.field.kappa_graph;
const pt = sot.field.protocol_truth ?? sot.field.PT;
const sb = sot.predictions_scoreboard;
const proofAccuracy =
  sb.accuracy_pct != null
    ? `${sb.accuracy_pct}%`
    : sb.n_assessable > 0
      ? `n=${sb.n_assessable}`
      : 'n/a';
const proofAccuracyNote =
  sb.accuracy_pct != null
    ? `${sb.n_true}/${sb.n_assessable} assessable`
    : 'thin assessable n · see track record';
const sotStamp = (sot.generated_at || '').slice(0, 10);
type TopPhiEntity = {
  entity: string;
  display?: string;
  phi_s: number;
  kappa?: number | null;
  display_kind?: string;
  facet_label?: string;
  display_role?: string;
  role_label?: string;
  kind_note?: string;
};
const topPhi = ((sot as { top_entities_by_phi_s?: TopPhiEntity[] }).top_entities_by_phi_s || []) as TopPhiEntity[];
const maxPhi = topPhi.length ? Math.max(...topPhi.map((e) => e.phi_s)) : 1;
/** Host layers — engine display_role SoT; do not invent kinds on Pages. */
const PHI_ROLE_ORDER = [
  { role: 'actor', title: 'Actors', hint: 'Issuers, exchanges, institutions, regulators' },
  {
    role: 'rule_framework',
    title: 'Rule frameworks',
    hint: 'Regulation / exemption frameworks (REG_*, MiCA-like) — not market actors',
  },
  { role: 'rail', title: 'Rails', hint: 'Chains and settlement / clearing rails' },
] as const;
const topPhiByRole = PHI_ROLE_ORDER.map((layer) => ({
  ...layer,
  entities: topPhi.filter((e) => (e.display_role || 'other') === layer.role),
})).filter((layer) => layer.entities.length > 0);
const topPhiOther = topPhi.filter(
  (e) => !PHI_ROLE_ORDER.some((layer) => layer.role === (e.display_role || 'other'))
);
const helixPrefix =
  (sot as { helix?: { fingerprint_prefix?: string | null } }).helix?.fingerprint_prefix || null;
const gExternal = sot.field.G_external_cumulative;
const ercMustMiss = `${(100 * erc8004.must_miss_rate).toFixed(1)}%`;
const ercMustMissCi = erc8004.must_miss_rate_ci95
  .map((x) => (100 * x).toFixed(1))
  .join(' to ');
---

<Layout
  title="Structural Intelligence — Eigenstate Research"
  description="Where patterns persist across technological waves. Intelligence research identifying power concentration mechanisms."
  fonts={fonts}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/styles.css`} />
    <style>
      /*
        Only the hero (and the pre-hero loading splash, same visual
        language) stays dark — its animated tunnel only works against a
        near-black background, and it's the site's strongest visual
        signature. Everything else on this page, including the nav,
        follows tokens.css's light defaults like every other page.
        Redeclaring these custom properties on .hero/.loading-screen scopes
        them to descendants of those elements only — the rest of the page
        (a sibling in the DOM) is untouched and keeps resolving var(--bg)
        etc. to the global light values.
      */
      .hero,
      .loading-screen {
        --bg: #030712;
        --bg2: #0a0e27;
        --bg-card: #0f172a;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --signal: #5b96a0;
        --signal-bright: #7cb3bc;
        --signal-dim: #45747c;
        --signal-text: #a8d0d6;
        --status-success: #22c55e;
        --status-warning: #f59e0b;
        --border: rgb(148 163 184 / 12%);
        --border-strong: rgb(148 163 184 / 24%);
        --border-live: rgb(69 116 124 / 30%);
      }

      /* buttons.css defaults .btn-gradient to a soft light-theme shadow
         (see that file's comment) since most pages are light now — this
         restores the original neon glow for the one button dark enough for
         it to read as "light emitting into darkness" rather than a mistake. */
      .hero .btn-gradient {
        border: 1px solid rgb(95 139 245 / 40%);
        box-shadow:
          0 0 30px rgb(62 111 239 / 40%),
          0 0 60px rgb(62 111 239 / 20%),
          0 4px 20px rgb(0 0 0 / 40%),
          inset 0 1px 0 rgb(255 255 255 / 15%);
      }

      .hero .btn-gradient:hover {
        box-shadow:
          0 0 40px rgb(62 111 239 / 60%),
          0 0 80px rgb(62 111 239 / 30%),
          0 8px 30px rgb(0 0 0 / 40%),
          inset 0 1px 0 rgb(255 255 255 / 20%);
      }
    </style>
  </Fragment>

    <!-- Loading Screen -->
    <div class="loading-screen" id="loadingScreen">
        <div class="loading-content">
            <div class="loading-logo">
                <span id="loadingText"></span>
                <span class="loading-cursor">_</span>
            </div>
            <div class="loading-bar">
                <div class="loading-progress"></div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="main-nav" id="mainNav">
        <div class="nav-container">
            <a href="#" class="nav-logo">EIGENSTATE</a>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navLinks">
                <span></span><span></span><span></span>
            </button>
            <div class="nav-links" id="navLinks">
                <a href="#pattern">The Pattern</a>
                <a href="#intelligence">Intelligence</a>
                <a href="field/">Field</a>
                <a href="origin/">Origin</a>
                <a href="reports/">Signal Reports</a>
                <a href="onchain/">On-Chain Proof</a>
                <a href="track-record/">Track Record</a>
                <a href="predictions/">Predictions</a>
            </div>
            <a href="request-access/" class="btn btn-sm">Request Pilot</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="main">
        <!-- Background Layers -->
        <div class="hero-bg-layers">
            <!-- Binary Rain Canvas -->
            <canvas id="binary-rain-canvas" class="layer-binary-rain" aria-hidden="true"></canvas>
        </div>

        <!-- Hero Content -->
        <div class="hero-content">
            <p class="company-name">EIGENSTATE RESEARCH</p>
            <h1>
                <span class="white">STRUCTURAL</span>
                <span class="orange">INTELLIGENCE</span>
            </h1>
            <p class="tagline">Randomness is just encrypted order.</p>
            <a href="request-access/" class="btn btn-lg btn-gradient">Request Pilot Access</a>
        </div>

        <div class="scroll-indicator">
            <span>Scroll</span>
            <div class="arrow"></div>
        </div>
    </section>

    <!-- Proof Strip: baked from engine SoT (public/field-state.json) -->
    <section class="proof-strip-section" aria-label="Engine SoT status">
        <div class="proof-strip bracket">
            <div class="proof-tile">
                <p class="engine-tile-label">M1 coverage</p>
                <p class="engine-tile-value cyan" data-sot="m1">{m1Headline}</p>
                <p class="engine-tile-note">{m1Pct}% · SoT stamp {sotStamp}</p>
            </div>
            <div class="proof-tile">
                <p class="engine-tile-label">Protocol Truth · κ_act</p>
                <p class="engine-tile-value orange" data-sot="pt">{formatNum(pt, 3)}</p>
                <p class="engine-tile-note">κ_act <span data-sot="kappa">{formatNum(kappa, 3)}</span> · κ_graph <span data-sot="kappa-graph">{formatNum(kappaGraph, 3)}</span></p>
            </div>
            <div class="proof-tile">
                <p class="engine-tile-label">assessable accuracy</p>
                <p class="engine-tile-value green" data-sot="accuracy">{proofAccuracy}</p>
                <p class="engine-tile-note">{proofAccuracyNote}</p>
            </div>
        </div>
        <p class="proof-strip-link" style="margin-bottom:8px;font-size:12px;color:var(--text-muted);max-width:640px;margin-left:auto;margin-right:auto;text-align:center;line-height:1.5;">
            SoT = engine source of truth (HOST + M1 coverage ledger), baked into <code>field-state.json</code> at deploy — not marketing HTML.
            <a href="methodology/" style="color:var(--signal);">Methodology</a>
        </p>
        <a href="track-record/" class="proof-strip-link">See the full track record →</a>
    </section>

    <!-- The Pattern Section -->
    <section id="pattern" class="pattern-section">
        <div class="pattern-container">

            <!-- MAIN TITLE (First on mobile) -->
            <div class="pattern-title-block">
                <span class="section-label">STRUCTURAL CONVERGENCE</span>
                <h2 class="pattern-title">
                    <span class="title-white">THE</span><br>
                    <span class="title-orange">PATTERN</span>
                </h2>
            </div>

            <!-- VIZ LABEL (Above animation on mobile) -->
            <div class="pattern-viz-header">
                <span class="section-label">STRUCTURAL CONVERGENCE</span>
            </div>

            <!-- LEFT COLUMN: Text Content -->
            <div class="pattern-content">

                <!-- THE PATTERN Section Content: three scannable beats instead of
                     four continuous paragraphs -->
                <div class="pattern-block pattern-beats">
                    <div class="pattern-beat">
                        <span class="beat-marker">01</span>
                        <p class="pattern-text primary">Every major technological wave has produced visible winners: railroads, oil, telecom, internet. Yet the mechanisms that empowered their dominance remained encrypted.</p>
                    </div>

                    <div class="pattern-beat">
                        <span class="beat-marker">02</span>
                        <p class="pattern-text primary-light">After simulating 160 years of systems evolution, we found the interface between capital flows and physical infrastructure follows a non-obvious but predictable structure. <strong>We've mapped it.</strong></p>
                    </div>

                    <div class="pattern-beat">
                        <span class="beat-marker">03</span>
                        <p class="pattern-text secondary">The mechanisms underlying each wave remain consistent, but the layers of complexity concealing them deepen with every cycle — and legacy frameworks, built on legacy variables, have lost the ability to decrypt them.</p>
                    </div>
                </div>

                <div class="pattern-block featured">
                    <p class="pattern-text">HFT optimized for speed. One variable.</p>
                    <p class="pattern-text punchline">This wave requires four.</p>
                </div>

                <div class="pattern-block">
                    <p class="pattern-text insight">Here's what they're missing: each wave creates new consolidation, which allows more predictability, not less. But separating signal from noise demands adaptive tools and new dimensions.</p>
                </div>

                <!-- Power Law Visual — historical illustration only; live numbers from SoT tiles -->
                <div class="pattern-block power-law-block">
                    <div class="stats-inline">
                        <div class="inline-stat">
                            <span class="stat-big" data-sot="m1">{m1Headline}</span>
                            <span class="stat-context">M1 coverage (SoT)</span>
                        </div>
                        <div class="inline-stat">
                            <span class="stat-big cyan" data-sot="accuracy">{proofAccuracy}</span>
                            <span class="stat-context">Assessable accuracy</span>
                        </div>
                    </div>
                    <p class="power-law-title">HISTORICAL CONCENTRATION (ILLUSTRATIVE)</p>

                    <!-- Bar chart: past-wave illustration — no projected Wave 6 capture % -->
                    <svg
                        class="power-law-chart"
                        viewBox="0 0 320 150"
                        role="img"
                        aria-label="Illustrative top-10% capture share in past waves: Wave 1 62%, Wave 3 74%, Wave 5 86%. Current wave is measured via M1 SoT — no projected capture percentage."
                    >
                        <line x1="20" y1="115" x2="300" y2="115" class="chart-baseline" />

                        <text x="45" y="53" class="chart-value">62%</text>
                        <rect x="30" y="58" width="50" height="57" rx="3" class="chart-bar" />
                        <text x="45" y="132" class="chart-label">Wave 1</text>

                        <text x="115" y="41" class="chart-value">74%</text>
                        <rect x="100" y="46" width="50" height="69" rx="3" class="chart-bar" />
                        <text x="115" y="132" class="chart-label">Wave 3</text>

                        <text x="185" y="29" class="chart-value">86%</text>
                        <rect x="170" y="34" width="50" height="81" rx="3" class="chart-bar" />
                        <text x="185" y="132" class="chart-label">Wave 5</text>

                        <text x="255" y="48" class="chart-value chart-value-projected">—</text>
                        <rect x="240" y="58" width="50" height="57" rx="3" class="chart-bar chart-bar-projected" opacity="0.35" />
                        <text x="255" y="132" class="chart-label">Now</text>
                        <text x="255" y="144" class="chart-label chart-label-muted">M1 SoT</text>
                    </svg>

                    <!-- Network Comparison -->
                    <div class="network-comparison">

                        <div class="network-state">
                            <p class="network-label">Initial State</p>
                            <div class="nodes-container distributed">
                                <svg viewBox="0 0 120 80" class="nodes-svg">
                                    <!-- Distributed nodes - many equal sizes -->
                                    <circle cx="20" cy="20" r="6" class="node"/>
                                    <circle cx="45" cy="15" r="6" class="node"/>
                                    <circle cx="70" cy="22" r="6" class="node"/>
                                    <circle cx="95" cy="18" r="6" class="node"/>
                                    <circle cx="30" cy="40" r="6" class="node"/>
                                    <circle cx="55" cy="38" r="6" class="node"/>
                                    <circle cx="80" cy="42" r="6" class="node"/>
                                    <circle cx="15" cy="60" r="6" class="node"/>
                                    <circle cx="40" cy="62" r="6" class="node"/>
                                    <circle cx="65" cy="58" r="6" class="node"/>
                                    <circle cx="90" cy="65" r="6" class="node"/>
                                    <circle cx="105" cy="45" r="6" class="node"/>
                                    <!-- Connection lines -->
                                    <line x1="20" y1="20" x2="45" y2="15" class="connection"/>
                                    <line x1="45" y1="15" x2="70" y2="22" class="connection"/>
                                    <line x1="70" y1="22" x2="95" y2="18" class="connection"/>
                                    <line x1="30" y1="40" x2="55" y2="38" class="connection"/>
                                    <line x1="55" y1="38" x2="80" y2="42" class="connection"/>
                                    <line x1="20" y1="20" x2="30" y2="40" class="connection"/>
                                    <line x1="45" y1="15" x2="55" y2="38" class="connection"/>
                                    <line x1="70" y1="22" x2="80" y2="42" class="connection"/>
                                    <line x1="30" y1="40" x2="40" y2="62" class="connection"/>
                                    <line x1="55" y1="38" x2="65" y2="58" class="connection"/>
                                    <line x1="80" y1="42" x2="90" y2="65" class="connection"/>
                                    <line x1="95" y1="18" x2="105" y2="45" class="connection"/>
                                </svg>
                            </div>
                            <p class="network-caption">Distributed</p>
                        </div>

                        <div class="network-arrow">
                            <svg viewBox="0 0 24 24" class="arrow-svg">
                                <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>

                        <div class="network-state">
                            <p class="network-label">After Compounding</p>
                            <div class="nodes-container concentrated">
                                <svg viewBox="0 0 120 80" class="nodes-svg">
                                    <!-- Concentrated nodes - one huge, few medium, many tiny -->
                                    <!-- Dominant node -->
                                    <circle cx="60" cy="35" r="22" class="node dominant"/>
                                    <!-- Medium nodes -->
                                    <circle cx="25" cy="50" r="8" class="node medium"/>
                                    <circle cx="95" cy="45" r="6" class="node medium"/>
                                    <!-- Small nodes -->
                                    <circle cx="15" cy="70" r="3" class="node small"/>
                                    <circle cx="35" cy="72" r="2.5" class="node small"/>
                                    <circle cx="55" cy="75" r="2" class="node small"/>
                                    <circle cx="75" cy="73" r="2" class="node small"/>
                                    <circle cx="95" cy="70" r="2.5" class="node small"/>
                                    <circle cx="105" cy="68" r="2" class="node small"/>
                                    <circle cx="10" cy="25" r="2" class="node small"/>
                                    <circle cx="110" cy="22" r="2" class="node small"/>
                                    <!-- Connection lines to dominant -->
                                    <line x1="25" y1="50" x2="42" y2="40" class="connection strong"/>
                                    <line x1="95" y1="45" x2="80" y2="38" class="connection"/>
                                    <line x1="15" y1="70" x2="45" y2="50" class="connection weak"/>
                                    <line x1="55" y1="75" x2="58" y2="57" class="connection weak"/>
                                    <line x1="95" y1="70" x2="75" y2="52" class="connection weak"/>
                                </svg>
                            </div>
                            <p class="network-caption">Concentrated</p>
                        </div>

                    </div>

                    <p class="pattern-text insight" style="margin-top:14px;">
                        The still diagrams show concentration. The 400-year product, VOC to Circle and Tether, lives on
                        <a href="origin/" style="color:var(--signal);text-decoration:none;">Origin</a>.
                    </p>

                </div>

                <!-- Alpha Migration Line -->
                <div class="pattern-block">
                    <p class="pattern-text punchline">When everyone sees the curve, the curve stops paying. Alpha migrates to higher dimensions.</p>
                </div>

                <div class="pattern-block">
                    <p class="pattern-text primary-light">We built a proprietary four-dimensional framework, tracking the vectors that precede price.</p>
                </div>

                <div class="pattern-block">
                    <p class="pattern-text punchline-highlight">Structural measurement of tokenized settlement — not a Wave-6 capture forecast. Live tiles bake from engine SoT; assessable accuracy stays thin until n ≥ 5.</p>
                </div>

                <div class="pattern-block urgency-line">
                    <p class="urgency-text">Research / pre-revenue. Public artifacts are real — coverage and on-chain paths stay partial by design.</p>
                </div>

                <div class="pattern-block cta-block">
                    <p class="cta-hook">Design-partner door — free intake.</p>
                    <p class="cta-scarcity">$0 · no Stripe · not a bank settlement signup</p>
                    <a href="request-access/" class="btn btn-md">Request Pilot Access</a>
                    <p class="cta-qualifier">Researchers · desks · institutions · builders</p>
                </div>

                <div class="pattern-credentials-block">
                    <p class="pattern-credentials">Quantitative research • Applied Mathematics PhD</p>
                    <p class="pattern-qualifier">No claimed customer book or production settlement product on this face.</p>
                </div>

            </div>

            <!-- RIGHT COLUMN: Sticky Visualization -->
            <div class="pattern-visualization-wrapper">
                <div class="pattern-visualization">
                    <canvas id="network-canvas" aria-hidden="true"></canvas>
                </div>
                <p class="pattern-text secondary" style="margin-top:8px;font-size:12px;">
                    Metaphor. Named seats:
                    <a href="origin/" style="color:var(--signal);text-decoration:none;">Origin</a>.
                </p>
            </div>

        </div>
    </section>
    <!-- Intelligence Section -->
    <section id="intelligence" class="pattern-section">
        <div class="pattern-container">

            <div class="pattern-title-block">
                <span class="section-label">EIGENSTATE INTELLIGENCE ENGINE</span>
                <h2 class="pattern-title">
                    <span class="title-white">THE</span><br>
                    <span class="title-orange">ENGINE</span>
                </h2>
            </div>

            <div class="pattern-viz-header">
                <span class="section-label">FIELD STATE - LIVE</span>
            </div>

            <div class="pattern-content">

                <div class="pattern-block">
                    <p class="pattern-text primary">The engine tracks {sot.coverage.m1_denominator} M1 entities in the tokenized settlement layer; live SoT coverage is {m1Headline}. It computes extraction pressure, loop velocity, and field efficiency each cycle — producing a verifiable fingerprint of the information field.</p>
                </div>

                <div class="pattern-block featured">
                    <p class="pattern-text" style="font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--signal);letter-spacing:0.05em;">G = ∮E·dl &nbsp;·&nbsp; E = ΔI/A &nbsp;·&nbsp; PT → 1/φ = 0.618</p>
                </div>

                <!-- Engine Pipeline -->
                <div class="pattern-block power-law-block">
                    <p class="power-law-title">ENGINE PIPELINE</p>
                    <div class="power-law-data">
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">SENSE</span>
                            <span class="wave-stat">liquidtics reads HN ledger · Swadesh gate · G = ∮E·dl</span>
                            <span class="wave-value" style="color:var(--signal);">∞</span>
                        </div>
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">DETECT</span>
                            <span class="wave-stat">curl_detector · ∇×G · FORMING / STABLE / PASSING / NEW</span>
                            <span class="wave-value" style="color:var(--accent);">∇×G</span>
                        </div>
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">RANK</span>
                            <span class="wave-stat">{sot.coverage.m1_denominator} M1 entities · SoT coverage {m1Headline}</span>
                            <span class="wave-value" style="color:var(--accent);">{sot.coverage.m1_strict_n}</span>
                        </div>
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">RECORD</span>
                            <span class="wave-stat">memory_chain · helix fingerprint · Fibonacci-weighted · irreversible</span>
                            <span class="wave-value" style="color:var(--signal);">∮</span>
                        </div>
                        <div class="power-law-row highlight">
                            <span class="wave-label">OUTPUT</span>
                            <span class="wave-stat">signal reports · RWA disclosure survey · ERC-8004 refusal ledger</span>
                            <span class="wave-value">→</span>
                        </div>
                    </div>
                </div>

                <!-- Field State — baked from engine SoT (field-state.json) -->
                <div class="pattern-block power-law-block">
                    <p class="power-law-title">FIELD STATE (ENGINE SOT)</p>
                    <div class="power-law-data">
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">M1 coverage</span>
                            <span class="wave-stat">m1_strict ∩ topology / {sot.coverage.m1_denominator}</span>
                            <span class="wave-value" style="color:var(--accent);">{m1Headline}</span>
                        </div>
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">Protocol Truth</span>
                            <span class="wave-stat">HOST SoT · act threshold 0.618</span>
                            <span class="wave-value" style="color:var(--accent);">{formatNum(pt, 3)}</span>
                        </div>
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">κ coherence</span>
                            <span class="wave-stat">HOST state at last parkash stamp</span>
                            <span class="wave-value" style="color:var(--accent);">{formatNum(kappa, 3)}</span>
                        </div>
                        <div class="power-law-row">
                            <span class="wave-label" style="color:var(--signal);">G_external</span>
                            <span class="wave-stat">cumulative external G (HOST)</span>
                            <span class="wave-value" style="color:var(--accent);">{gExternal != null ? formatNum(Number(gExternal), 1) : '—'}</span>
                        </div>
                        <div class="power-law-row highlight">
                            <span class="wave-label">Helix tip</span>
                            <span class="wave-stat">local chain prefix · on-chain commits gated</span>
                            <span class="wave-value" style="font-family:'JetBrains Mono',monospace;font-size:11px;">{helixPrefix || 'see proof index'}</span>
                        </div>
                    </div>
                </div>

                <div class="pattern-block">
                    <p class="pattern-text punchline">Live tiles bake from engine SoT after parkash — not frozen marketing HTML. Structural measurement, not a price forecast. Assessable accuracy stays thin until n ≥ 5.</p>
                </div>

                <div class="pattern-block power-law-block">
                    <p class="power-law-title">TOP ENTITIES BY SETTLEMENT PRESSURE (Φ_S)</p>
                    <p class="power-law-layer-note">Separated by role — actors, rule frameworks, and rails. Same SoT Φ_S; display grouping only.</p>
                    {
