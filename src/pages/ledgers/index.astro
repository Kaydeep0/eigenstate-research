---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import history from '../../data/ledger_refresh.json';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const requestAccess = `${base}request-access/`;

interface Run {
  run_index: number;
  generated_at: string;
  digest: string;
  probe_version: string;
  counts: Record<string, number>;
  rates?: Record<string, { rate: number; ci95?: [number, number] }>;
  top_refuse_reason?: string;
}

interface RateMove {
  rate: string;
  before: number;
  after: number;
  before_ci95?: [number, number];
  after_ci95?: [number, number];
  reading?: string;
}

interface LedgerEntry {
  ledger: string;
  title: string;
  unit: string;
  runs_on_record: number;
  first_run_at: string;
  latest_run_at: string;
  latest_digest: string;
  latest_probe_version: string;
  human_page: string;
  machine_summary: string;
  rerun_command: string;
  comparability: string;
  runs: Run[];
  trend?: string;
  latest_delta?: {
    from_digest: string;
    to_digest: string;
    changes: { counter: string; before: number; after: number; change: number }[];
    rate_comparison: RateMove[];
  };
}

interface History {
  generated_at: string;
  digest: string;
  tool: string;
  ledgers_indexed: number;
  runs_on_record: number;
  ledgers_with_one_run_only: number;
  ledgers_whose_counters_held_between_the_last_two_runs: number;
  headline_counters_that_moved_on_the_latest_refresh: number;
  rate_comparisons_whose_intervals_still_overlap: number;
  what_an_overlapping_interval_means: string;
  what_this_is: string;
  what_this_is_not: string;
  append_only_rule: string;
  reading_a_delta: string;
  urls: Record<string, string>;
  ledgers: LedgerEntry[];
}

const h = history as unknown as History;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function localPath(entry: LedgerEntry): string {
  return `${base}${entry.ledger}/`;
}

function pctRate(n: number): string {
  if (n <= 1 && n >= 0) return `${(100 * n).toFixed(1)}%`;
  return String(n);
}

function primaryRate(entry: LedgerEntry): { label: string; value: string } {
  const latest = entry.runs[entry.runs.length - 1];
  const rates = latest?.rates || {};
  const prefer = ['must_miss_rate', 'must_refuse_rate', 'full_refuse_rate', 'full_miss_rate'];
  for (const key of prefer) {
    if (rates[key]) return { label: key.replace(/_/g, ' '), value: pctRate(rates[key].rate) };
  }
  const first = Object.entries(rates)[0];
  if (first) return { label: first[0].replace(/_/g, ' '), value: pctRate(first[1].rate) };
  const counts = latest?.counts || {};
  const refuse = counts.must_refuse ?? counts.must_miss;
  const pop =
    counts.sampled ??
    counts.expectation_count ??
    counts.issuers_in_population ??
    counts.claims_in_corpus ??
    counts.logs_in_population;
  if (refuse != null && pop) {
    return { label: 'must refuse share', value: `${((100 * refuse) / pop).toFixed(1)}%` };
  }
  return { label: 'runs on record', value: String(entry.runs_on_record) };
}

function deltaShort(entry: LedgerEntry): string {
  const move = entry.latest_delta?.rate_comparison?.[0];
  if (move) {
    return `${pctRate(move.before)} → ${pctRate(move.after)}`;
  }
  if (entry.runs_on_record < 2) return 'snapshot';
  return 'held';
}

const rows = [...h.ledgers].sort((a, b) => b.latest_run_at.localeCompare(a.latest_run_at));
---

<Layout
  title="Measured ledgers · Eigenstate Research"
  description="Every measured ledger this node publishes, with one append-only row per publication, so a reader can check whether a number held the second time."
  fonts={fonts}
>
  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="rank-hero" id="main">
    <div class="eyebrow">Measured ledgers · append-only run history</div>
    <h1>Every ledger, every publication</h1>
    <p class="lede">
      Same probe, same population, second answer. This index measures nothing itself; it only shows
      whether a published rate held.
    </p>
    <div class="rank-primary">
      <div class="rate">{h.runs_on_record}</div>
      <div class="rate-label">
        publications on record · {h.ledgers_indexed} ledgers · {
          h.headline_counters_that_moved_on_the_latest_refresh
        } headline counters moved on the latest refresh
      </div>
    </div>
    <p class="rank-delta">
      {h.ledgers_indexed - h.ledgers_with_one_run_only} of {h.ledgers_indexed} re-derived at least
      once · {h.rate_comparisons_whose_intervals_still_overlap} rate comparisons still overlap
    </p>
  </div>

  <section class="rank-wrap">
    <div class="rank-runline">
      Index digest <code>{h.digest.slice(0, 16)}</code> · {formatDate(h.generated_at)} · {h.tool}
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th>Ledger</th>
            <th>Primary rate</th>
            <th class="n">Δ</th>
            <th class="n">Runs</th>
            <th>Latest</th>
            <th>Page</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((entry) => {
              const primary = primaryRate(entry);
              return (
                <tr>
                  <td class="subject">{entry.title}</td>
                  <td>
                    {primary.value}{' '}
                    <span style="color: var(--text-muted);">{primary.label}</span>
                  </td>
                  <td class="n">{deltaShort(entry)}</td>
                  <td class="n">{entry.runs_on_record}</td>
                  <td>{formatDate(entry.latest_run_at)}</td>
                  <td>
                    <a href={localPath(entry)}>open</a>
                    {' · '}
                    <a href={entry.machine_summary}>json</a>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div class="rank-footer">
      <p class="honesty">
        This index measures nothing itself · it cannot make a refusal disappear · a ledger that is
        wrong is wrong here too, twice, with both digests shown
      </p>

      <h2>Reading a delta</h2>
      <p>{h.reading_a_delta}</p>
      <p>{h.what_an_overlapping_interval_means}</p>
      <p>{h.append_only_rule}</p>
      <p>{h.what_this_is_not}</p>

      {
        rows.map((entry) => (
          <Fragment>
            <h2>{entry.title}</h2>
            <p>
              /{entry.ledger}/ · {entry.runs_on_record} publication
              {entry.runs_on_record === 1 ? '' : 's'} · {entry.comparability}
            </p>
            {entry.trend && <p>{entry.trend}</p>}
            <div class="rank-table-wrap">
              <table class="rank-table">
                <thead>
                  <tr>
                    <th>Run</th>
                    <th>Published</th>
                    <th>Probe</th>
                    <th>Digest</th>
                    <th>Headline counters</th>
                  </tr>
                </thead>
                <tbody>
                  {entry.runs.map((run) => (
                    <tr>
                      <td class="n">{run.run_index}</td>
                      <td>{formatDate(run.generated_at)}</td>
                      <td>v{run.probe_version}</td>
                      <td>
                        <code>{run.digest.slice(0, 12)}</code>
                      </td>
                      <td>
                        {Object.entries(run.counts ?? {})
                          .map(([key, value]) => `${key.replace(/_/g, ' ')} ${value}`)
                          .join(', ') || 'not carried in summary'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <pre class="cmd">{entry.rerun_command}</pre>
          </Fragment>
        ))
      }

      <h2>Machine readable</h2>
      <div class="links-row">
        <a href={h.urls.index}>index.json</a>
        <a href={h.urls.runs_jsonl}>runs.jsonl</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
