---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import history from '../../data/ledger_refresh.json';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const requestAccess = `${base}request-access/`;

interface Run {
  run_index: number;
  generated_at: string;
  digest: string;
  probe_version: string;
  counts: Record<string, number>;
  rates?: Record<string, { rate: number; ci95?: [number, number] }>;
  top_refuse_reason?: string;
}

interface RateMove {
  rate: string;
  before: number;
  after: number;
  before_ci95?: [number, number];
  after_ci95?: [number, number];
  intervals_overlap?: boolean;
  reading?: string;
}

interface LedgerEntry {
  ledger: string;
  title: string;
  unit: string;
  runs_on_record: number;
  first_run_at: string;
  latest_run_at: string;
  latest_digest: string;
  latest_probe_version: string;
  human_page: string;
  machine_summary: string;
  rerun_command: string;
  comparability: string;
  runs: Run[];
  trend?: string;
  latest_delta?: {
    from_digest: string;
    to_digest: string;
    changes: { counter: string; before: number; after: number; change: number }[];
    rate_comparison: RateMove[];
  };
}

interface History {
  generated_at: string;
  digest: string;
  tool: string;
  ledgers_indexed: number;
  runs_on_record: number;
  ledgers_with_one_run_only: number;
  ledgers_whose_counters_held_between_the_last_two_runs: number;
  headline_counters_that_moved_on_the_latest_refresh: number;
  rate_comparisons_whose_intervals_still_overlap: number;
  what_an_overlapping_interval_means: string;
  what_this_is: string;
  what_this_is_not: string;
  append_only_rule: string;
  reading_a_delta: string;
  urls: Record<string, string>;
  ledgers: LedgerEntry[];
}

const h = history as unknown as History;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime()) ? iso : d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function localPath(entry: LedgerEntry): string {
  return `${base}${entry.ledger}/`;
}

const headlines = [
  {
    value: `${h.runs_on_record}`,
    sub: `across ${h.ledgers_indexed} ledgers`,
    label: 'publications on record',
    note: 'Every row is copied from a summary.json that was actually served, and named by the digest that served it.',
  },
  {
    value: `${h.ledgers_indexed - h.ledgers_with_one_run_only}`,
    sub: `of ${h.ledgers_indexed} ledgers`,
    label: 'have been re-derived at least once',
    note: 'A ledger with one run is a snapshot. It is labelled as one below rather than left to read as a standing claim.',
  },
  {
    value: `${h.headline_counters_that_moved_on_the_latest_refresh}`,
    sub: 'this refresh',
    label: 'headline counters moved between runs',
    note: `Every one of them on the sampled ledger, and ${h.rate_comparisons_whose_intervals_still_overlap} of the rate comparisons behind them still have overlapping intervals. A move is not automatically a finding.`,
  },
  {
    value: `${h.ledgers_whose_counters_held_between_the_last_two_runs}`,
    sub: `of ${h.ledgers_indexed} ledgers`,
    label: 'held every headline counter',
    note: 'The digests still differ, because timestamps and per row detail differ. Identical counters are not an identical file.',
  },
];
---

<Layout
  title="Measured ledgers and their run history · Eigenstate Research"
  description="Every measured ledger this node publishes, with one append only row per publication, so a reader can check whether a number held the second time the same probe asked the same question."
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .page-hero {
        max-width: 820px;
        margin: 0 auto;
        padding: 72px 24px 20px;
        text-align: center;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.15em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .page-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        line-height: 1.15;
        margin: 0 0 16px;
      }

      .page-hero .grad {
        background: linear-gradient(135deg, var(--signal) 0%, var(--accent) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .explainer {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 auto 12px;
        max-width: 640px;
      }

      .honesty {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0 auto;
        max-width: 640px;
      }

      .wrap {
        max-width: 880px;
        margin: 0 auto;
        padding: 8px 24px 80px;
      }

      .runline {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.8;
        padding: 14px 16px;
        background: var(--bg2);
        border-left: 3px solid var(--border-live);
        margin: 20px 0 32px;
        overflow-wrap: anywhere;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 36px;
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 20px 18px;
      }

      .card .big {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 4px;
      }

      .card .ci {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: 10px;
      }

      .card .lab {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: 8px;
      }

      .card .note {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.6;
      }

      h2 {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-primary);
        margin: 36px 0 10px;
        letter-spacing: -0.01em;
      }

      h3 {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        font-weight: 600;
        color: var(--text-primary);
        margin: 28px 0 4px;
      }

      p.body {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 14px;
      }

      p.body a,
      .links-row a,
      td a {
        color: var(--signal-dim);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        margin: 8px 0 12px;
      }

      th,
      td {
        text-align: left;
        padding: 9px 10px;
        border-bottom: 1px solid var(--border);
        color: var(--text-secondary);
        vertical-align: top;
      }

      th {
        color: var(--text-muted);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 500;
      }

      td.n {
        text-align: right;
        color: var(--text-primary);
      }

      .subline {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin: 0 0 8px;
      }

      .trend {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 10px;
      }

      .delta {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-primary);
        margin: 0 0 10px;
      }

      .links-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 20px;
        margin: 6px 0 10px;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }

      .links-row a {
        text-decoration: none;
      }

      .links-row a:hover {
        text-decoration: underline;
      }

      pre.cmd {
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.55;
        background: #1a1a1a;
        color: #e8e6e1;
        padding: 14px 16px;
        border-radius: var(--radius-sm);
        overflow-x: auto;
        margin: 0 0 12px;
        white-space: pre;
      }

      .callout {
        background: var(--bg2);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 18px 20px;
        margin: 8px 0 20px;
      }

      .callout p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 10px;
      }

      .callout p:last-child {
        margin-bottom: 0;
      }

      @media (width <= 640px) {
        .page-hero {
          padding-top: 48px;
        }

        pre.cmd {
          font-size: 11px;
          padding: 12px;
        }
      }
    </style>
  </Fragment>

  <Nav cta={{ label: 'Request Pilot', href: requestAccess }} />

  <div class="page-hero" id="main">
    <div class="eyebrow">Measured ledgers · append only run history</div>
    <h1>Every ledger, and <span class="grad">every time</span> it was published</h1>
    <p class="explainer">
      A measurement published once is a snapshot wearing the clothes of a standing claim. The only
      way to tell the difference is to point the same probe at the same population again and show
      both answers. This page is that record: one row per publication, never edited, with the
      digest that served each one.
    </p>
    <p class="honesty">
      This index measures nothing itself · it cannot make a refusal disappear · a ledger that is
      wrong is wrong here too, twice, with both digests shown
    </p>
  </div>

  <section class="wrap">
    <div class="runline">
      {h.ledgers_indexed} ledgers · {h.runs_on_record} publications on record<br />
      Index digest <code>{h.digest}</code> generated {formatDate(h.generated_at)}<br />
      Built by {h.tool} · raw rows at <code>runs.jsonl</code> on both origins
    </div>

    <div class="cards">
      {
        headlines.map((card) => (
          <div class="card">
            <div class="big">{card.value}</div>
            <div class="ci">{card.sub}</div>
            <div class="lab">{card.label}</div>
            <div class="note">{card.note}</div>
          </div>
        ))
      }
    </div>

    <h2>What this index is not</h2>
    <div class="callout">
      <p>{h.what_this_is_not}</p>
      <p>{h.append_only_rule}</p>
      <p>{h.reading_a_delta}</p>
      <p>{h.what_an_overlapping_interval_means}</p>
    </div>

    <h2>Ledgers</h2>

    {
      h.ledgers.map((entry) => (
        <Fragment>
          <h3>{entry.title}</h3>
          <p class="subline">
            /{entry.ledger}/ · one row is one {entry.unit} · {entry.runs_on_record} publication
            {entry.runs_on_record === 1 ? '' : 's'} on record
          </p>
          <table>
            <thead>
              <tr>
                <th>Run</th>
                <th>Published</th>
                <th>Probe</th>
                <th>Digest</th>
                <th>Headline counters</th>
              </tr>
            </thead>
            <tbody>
              {entry.runs.map((run) => (
                <tr>
                  <td class="n">{run.run_index}</td>
                  <td>{formatDate(run.generated_at)}</td>
                  <td>v{run.probe_version}</td>
                  <td>
                    <code>{run.digest.slice(0, 12)}</code>
                  </td>
                  <td>
                    {Object.entries(run.counts ?? {})
                      .map(([key, value]) => `${key.replace(/_/g, ' ')} ${value}`)
                      .join(', ') || 'not carried in summary'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="trend">
            <strong>Comparing two runs of this ledger:</strong> {entry.comparability}
          </p>
          {entry.trend && <p class="trend">{entry.trend}</p>}
          {entry.latest_delta && entry.latest_delta.changes.length > 0 && (
            <p class="delta">
              Moved on the latest refresh:{' '}
              {entry.latest_delta.changes
                .map(
                  (change) =>
                    `${change.counter.replace(/_/g, ' ')} ${change.before} to ${change.after} (${
                      change.change > 0 ? '+' : ''
                    }${change.change})`
                )
                .join(' · ')}
            </p>
          )}
          {(entry.latest_delta?.rate_comparison ?? []).length > 0 && (
            <div class="callout">
              {(entry.latest_delta?.rate_comparison ?? []).map((move) => (
                <p>
                  <strong>{move.rate.replace(/_/g, ' ')}</strong> {move.before}
                  {move.before_ci95 && ` [${move.before_ci95[0]}, ${move.before_ci95[1]}]`} then{' '}
                  {move.after}
                  {move.after_ci95 && ` [${move.after_ci95[0]}, ${move.after_ci95[1]}]`}
                  {move.reading ? `, and ${move.reading}` : ', published without an interval'}
                </p>
              ))}
            </div>
          )}
          <div class="links-row">
            <a href={localPath(entry)}>Human page</a>
            <a href={entry.machine_summary}>Machine summary</a>
          </div>
          <pre class="cmd">{entry.rerun_command}</pre>
        </Fragment>
      ))
    }

    <h2>Machine readable</h2>
    <div class="links-row">
      <a href={h.urls.index}>index.json</a>
      <a href={h.urls.runs_jsonl}>runs.jsonl</a>
    </div>
  </section>

  <Footer />
</Layout>
