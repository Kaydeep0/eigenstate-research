---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { formatNum } from '../../lib/sot';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'public', 'federation', 'dossier');
  if (!fs.existsSync(dir)) return [];
  return fs
    .readdirSync(dir)
    .filter((f) => f.endsWith('.json') && !f.startsWith('index'))
    .map((f) => ({ params: { entity: f.replace(/\.json$/, '') } }));
}

const { entity } = Astro.params;
const code = (entity || '').toUpperCase();
const file = path.join(process.cwd(), 'public', 'federation', 'dossier', `${code}.json`);
let card: Record<string, unknown> | null = null;
try {
  if (fs.existsSync(file)) {
    card = JSON.parse(fs.readFileSync(file, 'utf8')) as Record<string, unknown>;
  }
} catch {
  card = null;
}

const own = (card?.own_numbers || {}) as Record<string, number | null>;
const compiled = typeof card?.compiled_at === 'string' ? card.compiled_at : null;
const digest = typeof card?.digest === 'string' ? String(card.digest).slice(0, 16) : null;
const claims = Array.isArray(card?.claims) ? (card.claims as unknown[]) : [];
const rel = (card?.relationships || {}) as {
  in_degree?: number;
  out_degree?: number;
  top_inbound?: Array<{ source?: string; conn_type?: string; vector?: string }>;
  top_outbound?: Array<{ target?: string; conn_type?: string; vector?: string }>;
  inbound?: Array<{ source?: string; entity?: string; conn_type?: string; vector?: string }>;
  outbound?: Array<{ target?: string; entity?: string; conn_type?: string; vector?: string }>;
};
const inbound = (rel.top_inbound || rel.inbound || []).filter(Boolean);
const outbound = (rel.top_outbound || rel.outbound || []).filter(Boolean);
const base = import.meta.env.BASE_URL;
const fieldHref = `${base}field/?focus=${encodeURIComponent(code)}`;
const machineJson = `${base}federation/dossier/${code}.json`;
const reportIndex = `${base}reports/`;
const methodology = `${base}methodology/`;
const glossary = `${base}methodology/#glossary`;
const verify = `${base}verify-walkthrough/`;
const display = code.replace(/_/g, ' ');

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';
---

<Layout
  title={`${display} dossier · Eigenstate Research`}
  description={`Human-readable field dossier for ${display}. Live Φ_S / κ from the engine SoT mirror.`}
  fonts={fonts}
>
  <Fragment slot="head">
    <style>
      .wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 56px 24px 80px;
      }

      .back {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--signal-dim);
        text-decoration: none;
      }

      h1 {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 800;
        margin: 20px 0 8px;
        letter-spacing: 0.02em;
      }

      .meta {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: 28px;
      }

      .metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 28px;
        margin-bottom: 28px;
      }

      .metric-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .metric-value {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--accent);
      }

      .metric-value.cyan {
        color: var(--signal);
      }

      .note {
        border-left: 3px solid var(--signal);
        padding: 12px 14px;
        background: rgb(47 90 99 / 6%);
        color: var(--text-secondary);
        font-size: var(--text-sm);
        line-height: 1.6;
        margin-bottom: 28px;
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        margin: 24px 0;
      }

      .links a {
        color: var(--signal);
        font-size: var(--text-sm);
      }

      .rel-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 8px 0 28px;
      }

      .rel-grid h2 {
        font-family: var(--font-heading);
        font-size: var(--text-base);
        margin: 0 0 8px;
      }

      .rel-grid ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .rel-grid li {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        padding: 6px 0;
        border-bottom: 1px solid var(--border);
      }

      .rel-grid a {
        color: var(--signal);
        text-decoration: none;
      }

      .rel-meta {
        color: var(--text-muted);
        font-size: var(--text-xs);
      }

      @media (width <= 640px) {
        .rel-grid {
          grid-template-columns: 1fr;
        }
      }

      .machine {
        margin-top: 32px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      .machine a {
        color: var(--text-muted);
      }

      .claims {
        margin-top: 8px;
        color: var(--text-secondary);
        font-size: var(--text-sm);
      }
    </style>
  </Fragment>

  <Nav active="reports" />

  <div class="wrap" id="main">
    <a class="back" href={reportIndex}>← Signal reports</a>
    <h1>{display}</h1>
    <p class="meta">
      Live SoT dossier mirror
      {compiled ? ` · compiled ${compiled.slice(0, 19)}Z` : ''}
      {digest ? ` · digest ${digest}…` : ''}
    </p>

    {
      card ? (
        <>
          <div class="metrics">
            <div>
              <div class="metric-label">Settlement pressure</div>
              <div class="metric-value">Φ_S {formatNum(own.phi_s, 4)}</div>
            </div>
            <div>
              <div class="metric-label">Field coherence</div>
              <div class="metric-value cyan">κ {formatNum(own.kappa, 4)}</div>
            </div>
            <div>
              <div class="metric-label">Claims on card</div>
              <div class="metric-value cyan">{claims.length}</div>
            </div>
          </div>
          <p class="note">
            These numbers are the live engine dossier mirror baked into Pages at deploy.
            They are not a vault dump and not a guarantee that every observation is on-chain.
            See the numbers glossary for Φ_S vs κ vs vault@publish vs M1 ledger.
          </p>
          <div class="links">
            <a href={fieldHref}>Open on field graph</a>
            <a href={glossary}>Numbers glossary</a>
            <a href={methodology}>Methodology</a>
            <a href={verify}>Verify walkthrough</a>
            <a href={reportIndex}>Related reports</a>
          </div>
          {
            inbound.length > 0 || outbound.length > 0 ? (
              <div class="rel-grid">
                <section>
                  <h2>Inbound ({rel.in_degree ?? inbound.length})</h2>
                  <ul>
                    {inbound.map((row) => {
                      const rec = row as { source?: string; entity?: string; vector?: string; conn_type?: string };
                      const src = String(rec.source || rec.entity || '');
                      return (
                        <li>
                          <a href={`${base}dossier/${src}/`}>{src.replace(/_/g, ' ')}</a>
                          <div class="rel-meta">
                            {rec.vector || ''} · {rec.conn_type || ''}
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </section>
                <section>
                  <h2>Outbound ({rel.out_degree ?? outbound.length})</h2>
                  <ul>
                    {outbound.map((row) => {
                      const rec = row as { target?: string; entity?: string; vector?: string; conn_type?: string };
                      const tgt = String(rec.target || rec.entity || '');
                      return (
                        <li>
                          <a href={`${base}dossier/${tgt}/`}>{tgt.replace(/_/g, ' ')}</a>
                          <div class="rel-meta">
                            {rec.vector || ''} · {rec.conn_type || ''}
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              </div>
            ) : null
          }
          {claims.length > 0 && (
            <p class="claims">{claims.length} claim record(s) attached on this card. Open machine JSON for the full structure.</p>
          )}
        </>
      ) : (
        <p class="note">No dossier mirror found for {code} in this deploy.</p>
      )
    }

    <p class="machine">
      Machine JSON (demoted): <a href={machineJson}>{code}.json</a>
    </p>
  </div>

  <Footer variant="full" />
</Layout>
