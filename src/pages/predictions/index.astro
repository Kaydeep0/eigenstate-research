---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PredictionCard from '../../components/PredictionCard.astro';
import JsonLd from '../../components/JsonLd.astro';
import { loadSot } from '../../lib/sot';
import { itemListJsonLd } from '../../lib/siteSeo';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const base = import.meta.env.BASE_URL;
const sot = loadSot();
const sb = sot.predictions_scoreboard;

const predictions = (await getCollection('predictions')).sort((a, b) =>
  b.data.logged_at.localeCompare(a.data.logged_at)
);

const stats = {
  cards: predictions.length,
  pending: predictions.filter((p) => p.data.status === 'pending').length,
  refuted: predictions.filter((p) => p.data.status === 'refuted').length,
  voided: predictions.filter((p) => p.data.status === 'void').length,
  confirmed: predictions.filter((p) => p.data.status === 'confirmed').length,
};
---

<Layout
  title="Predictions · Eigenstate Research"
  description="Human claim-detail cards for early structural gap predictions. Scored Host register and outcomes live on Track Record."
  fonts={fonts}
>
  <Fragment slot="head">
    <JsonLd
      data={itemListJsonLd({
        name: 'Host claim-detail cards',
        description:
          'Human claim-detail cards for early structural gap predictions. Scored Host register and outcomes live on Track Record.',
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        itemNames: predictions.map((p) => p.data.title),
      })}
    />
  </Fragment>
  <Fragment slot="head">
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        font-weight: 300;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.7;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 56px 40px 60px;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--signal);
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .page-title {
        font-family: var(--font-heading);
        font-size: clamp(24px, 3vw, 36px);
        font-weight: 800;
        letter-spacing: 0.04em;
        margin-bottom: 12px;
      }

      .page-sub {
        color: var(--text-secondary);
        font-size: var(--text-base);
        max-width: 720px;
        line-height: 1.65;
        margin-bottom: 24px;
      }

      .panel {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 18px 20px;
        margin-bottom: 28px;
        background: rgb(47 90 99 / 6%);
        border-color: rgb(47 90 99 / 30%);
      }

      .panel p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.65;
        margin-bottom: 10px;
      }

      .panel p:last-child {
        margin-bottom: 0;
      }

      .panel a {
        color: var(--signal);
        text-decoration: none;
      }

      .panel a:hover {
        text-decoration: underline;
      }

      .stats-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 36px;
      }

      .stat-pill {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 14px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 120px;
      }

      .stat-pill .label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .stat-pill .value {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--signal);
      }

      .stat-pill .value-amber {
        color: var(--status-warning);
      }

      .stat-pill .value-muted {
        color: var(--text-muted);
      }

      .stat-pill .value-error {
        color: var(--status-error);
      }

      .stat-pill .note {
        font-size: var(--text-xs);
        color: var(--text-muted);
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 20px;
        margin-top: 8px;
        border-top: 1px solid var(--border);
        padding-top: 28px;
      }

      .predictions-carousel {
        position: relative;
      }

      .carousel-track {
        display: flex;
        gap: 24px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding-bottom: 4px;
        scrollbar-width: none;
      }

      .carousel-track::-webkit-scrollbar {
        display: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .carousel-track {
          scroll-behavior: auto;
        }
      }

      .carousel-slide {
        flex: 0 0 100%;
        min-width: 0;
        scroll-snap-align: start;
      }

      .carousel-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        margin-top: 24px;
      }

      .carousel-arrow {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid var(--border-strong);
        background: var(--bg-card);
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
      }

      .carousel-arrow:hover:not(:disabled) {
        border-color: var(--accent);
        color: var(--accent);
      }

      .carousel-arrow:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .carousel-dots {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .carousel-dot {
        width: 8px;
        height: 8px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: var(--border-strong);
        cursor: pointer;
      }

      .carousel-dot.active {
        background: var(--accent);
        transform: scale(1.35);
      }

      .method-block {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 28px;
        margin-top: 40px;
      }

      .method-block h3 {
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 14px;
        color: var(--text-secondary);
        text-transform: uppercase;
      }

      .method-block p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 12px;
      }

      .method-block p:last-child {
        margin-bottom: 0;
      }

      .method-block a {
        color: var(--signal);
      }

      .sources-panel,
      .for-agents {
        margin-top: 36px;
      }

      .section-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 14px;
      }

      .sources-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .sources-list a {
        color: var(--signal);
        text-decoration: none;
        font-size: var(--text-sm);
      }

      .sources-list a:hover {
        text-decoration: underline;
      }

      .for-agents details {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 12px 16px;
        color: var(--text-muted);
        font-size: var(--text-sm);
      }

      .for-agents summary {
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .agent-body {
        margin-top: 14px;
        color: var(--text-secondary);
        line-height: 1.65;
      }

      .agent-body ul {
        margin: 8px 0 0 18px;
      }

      .agent-body a {
        color: var(--signal);
        word-break: break-all;
      }

      @media (width <= 640px) {
        .container {
          padding: 40px 20px;
        }
      }
    </style>
  </Fragment>

  <Nav active="predictions" />

  <div class="container" id="main">
    <div class="eyebrow">Eigenstate Research · Claim detail cards</div>
    <h1 class="page-title">Structural predictions</h1>
    <p class="page-sub">
      Human-readable cards for early gap predictions: claim text, falsifiable condition, and
      Base mainnet commit. Scored outcomes for the full Host register live on Track Record.
    </p>

    <div class="panel">
      <p>
        <strong>Where outcomes are scored:</strong>
        <a href={`${base}track-record/`}>Track Record</a>
        holds the Host prediction register ({sb.n_total} claims · {sb.n_open} open ·
        {` ${sb.n_resolved} `}resolved) and explains FALSE / VOID / PARTIAL. This page is
        the claim-detail surface for the early cards below, not a second scoreboard.
      </p>
      <p>
        Why publish at all: deadlines make Host claims falsifiable so the engine can score
        calibration honesty. Accuracy % waits until assessable n ≥ 5.
      </p>
    </div>

    <div class="stats-row">
      <div class="stat-pill">
        <div class="label">Detail cards</div>
        <div class="value">{stats.cards}</div>
        <div class="note">on this page</div>
      </div>
      <div class="stat-pill">
        <div class="label">Pending</div>
        <div class="value value-amber">{stats.pending}</div>
        <div class="note">awaiting close</div>
      </div>
      <div class="stat-pill">
        <div class="label">Refuted</div>
        <div class="value value-error">{stats.refuted}</div>
        <div class="note">FALSE on Track Record</div>
      </div>
      <div class="stat-pill">
        <div class="label">Void</div>
        <div class="value value-muted">{stats.voided}</div>
        <div class="note">unresolvable as written</div>
      </div>
      <div class="stat-pill">
        <div class="label">Host register</div>
        <div class="value">{sb.n_total}</div>
        <div class="note">
          <a href={`${base}track-record/`}>See Track Record</a>
        </div>
      </div>
    </div>

    <div class="section-title">Claim cards</div>

    <div class="predictions-carousel">
      <div class="carousel-track" id="predictionsTrack">
        {
          predictions.map((p) => (
            <div class="carousel-slide">
              <PredictionCard {...p.data} />
            </div>
          ))
        }
      </div>
      <div class="carousel-controls">
        <button class="carousel-arrow" id="predPrev" aria-label="Previous prediction" type="button"
          >←</button
        >
        <div class="carousel-dots" id="predDots">
          {
            predictions.map((_, i) => (
              <button class="carousel-dot" aria-label={`Go to prediction ${i + 1}`} type="button" />
            ))
          }
        </div>
        <button class="carousel-arrow" id="predNext" aria-label="Next prediction" type="button"
          >→</button
        >
      </div>
    </div>

    <div class="method-block">
      <h3>How this relates to Track Record</h3>
      <p>
        These cards are gap-level claim prose with on-chain commit timestamps. The
        <a href={`${base}track-record/`}>Track Record</a> page is the scored Host register:
        deadlines, TRUE/FALSE/VOID/PARTIAL outcomes, thin-n accuracy rules, and live engine
        SoT (PT, κ, M1) labeled separately from prediction outcomes.
      </p>
      <p>
        FALSE means the claim failed its resolution criteria by deadline. VOID means the
        claim could not be scored as written. See Track Record for the three resolved Host
        closes and the full open count.
      </p>
    </div>

    <div class="sources-panel">
      <div class="section-label">Sources &amp; human pages</div>
      <div class="sources-list">
        <a href={`${base}track-record/`}>Track Record · scored Host register</a>
        <a href={`${base}track-record/#INDIA_BANKNIFTY_001`}>BankNifty outcome (FALSE)</a>
        <a href={`${base}track-record/#FED_EXTRACTION_001`}>Fed extraction outcome (VOID)</a>
        <a href={`${base}track-record/#PHYSICS_T_A_DOLLAR_001`}>Physics T_A→$ outcome (PARTIAL)</a>
        <a href={`${base}methodology/`}>Methodology</a>
        <a href={`${base}onchain/`}>On-chain proof index</a>
      </div>
    </div>

    <div class="for-agents">
      <details>
        <summary>For agents (machine JSON)</summary>
        <div class="agent-body">
          <p>Prefer human pages above. Machine endpoints are secondary.</p>
          <ul>
            <li>
              Cards API: <a href={`${base}api/predictions.json`}>api/predictions.json</a>
            </li>
            <li>
              Scoreboard SoT:{' '}
              <a href={`${base}field-state.json`}>field-state.json</a> → predictions_scoreboard
            </li>
          </ul>
        </div>
      </details>
    </div>
  </div>

  <Footer
    variant="minimal"
    note="Claim cards are logged before outcomes are known. Scored register: Track Record. Not financial advice."
  />

  <script>
    import { initCarousel } from '../../scripts/carousel';

    initCarousel({
      trackSelector: '#predictionsTrack',
      prevSelector: '#predPrev',
      nextSelector: '#predNext',
      dotsSelector: '#predDots',
    });

    // Deep-link: /predictions/#INDIA_BANKNIFTY_001 scrolls that card into the carousel.
    const hash = window.location.hash.replace(/^#/, '');
    if (hash) {
      const el = document.getElementById(hash);
      if (el) {
        const slide = el.closest('.carousel-slide');
        const track = document.querySelector('#predictionsTrack');
        if (slide instanceof HTMLElement && track instanceof HTMLElement) {
          track.scrollLeft = slide.offsetLeft;
        }
        el.scrollIntoView({ block: 'nearest' });
      }
    }
  </script>
</Layout>
